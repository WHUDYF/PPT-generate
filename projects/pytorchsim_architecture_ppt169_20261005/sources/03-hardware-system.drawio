        <mxCell id="tc33" value="simple · 延迟 10 拍 · 940 MHz · 16 端口/core" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA5B1;fontSize=11;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="840" y="696" width="340" height="24" as="geometry"/></mxCell>
        <mxCell id="tc34" value="l2d_type" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA5B1;fontSize=11;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="620" y="720" width="220" height="24" as="geometry"/></mxCell>
        <mxCell id="tc35" value="未设置 → nocache" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA5B1;fontSize=11;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="840" y="720" width="340" height="24" as="geometry"/></mxCell>
        <mxCell id="path" value="一个读请求怎样走完&lt;br&gt;&lt;font style='font-size:10px;font-weight:normal;color:#555555'&gt;① DMA 把 MOVIN 拆成对齐的 mem_fetch，放进 core 请求队列&lt;br&gt;② icnt 拍：从该 core 的注入端口进入互连，端口满就等&lt;br&gt;③ 目的端口 = cores × ports + channel id&lt;br&gt;④ 进入该通道的 L2 切片：nocache 直通；datacache 只缓存可缓存区间，命中不访问 DRAM&lt;br&gt;⑤ 否则进入 DRAM 通道，由 Ramulator2 给出时序&lt;br&gt;⑥ 响应回到发起 core 的端口（channel id mod ports）&lt;br&gt;⑦ 指令的 waiting_request 减到 0 → 指令完成或置 tag&lt;br&gt;&lt;br&gt;NUMA：通道所属 partition 与 core 的 partition 比较，计 local / remote&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1220" y="500" width="660" height="250" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
