        <mxCell id="title" value="指令怎样落到硬件：TOG 节点 → Tile / tile 指令 → mem_fetch" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontColor=#1F2933;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="1860" height="28" as="geometry"/></mxCell>
        <mxCell id="in1" value="tile_graph.onnx（静态，可缓存）&lt;br&gt;&lt;font style='font-size:10px;font-weight:normal;color:#555555'&gt;loop：索引、边界、嵌套&lt;br&gt;load / store：shape、stride、elem size、argN&lt;br&gt;compute：类型、torchsim_cycle、overlapping&lt;br&gt;wait：等待的 tag&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="310" height="160" as="geometry"/></mxCell>
        <mxCell id="in2" value="属性文件（每次调用都写）&lt;br&gt;&lt;font style='font-size:10px;font-weight:normal;color:#555555'&gt;address_info：argN → 本次 data_ptr&lt;br&gt;sram_alloc 区间 → L2 cache_plan&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="20" y="260" width="310" height="100" as="geometry"/></mxCell>
