        <mxCell id="tc51" value="一条搬运拆成多个请求" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA5B1;fontSize=11;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="1720" y="306" width="160" height="34" as="geometry"/></mxCell>
        <mxCell id="tx52" value="RISC-V / 加速器机器指令只出现在 Spike 和 Gem5 里；TOGSim 不逐条执行它们，只用 Gem5 采到的周期。" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="1440" y="360" width="440" height="70" as="geometry"/></mxCell>
        <mxCell id="ex" value="例：relu(addmm(bias, x, w))，M=N=K=256，tile 128×128×128 → 2×2 个输出块，每块累加 2 段 K（示意，实际以生成的 TOG 为准）" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9AA5B1;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontSize=14;fontStyle=1;fontColor=#1F2933;dashed=1;" vertex="1" parent="1"><mxGeometry x="20" y="700" width="1860" height="180" as="geometry"/></mxCell>
        <mxCell id="e1" value="MOVIN X[m,k]" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="50" y="770" width="200" height="60" as="geometry"/></mxCell>
        <mxCell id="e2" value="MOVIN W[k,n]" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="310" y="770" width="200" height="60" as="geometry"/></mxCell>
        <mxCell id="e3" value="BAR 等 tag" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="570" y="770" width="200" height="60" as="geometry"/></mxCell>
        <mxCell id="e4" value="COMP · MATMUL" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="830" y="770" width="200" height="60" as="geometry"/></mxCell>
        <mxCell id="e5" value="下一段 K …" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA5B1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="1090" y="770" width="200" height="60" as="geometry"/></mxCell>
        <mxCell id="e6" value="COMP · VU&lt;br&gt;bias + ReLU" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="1350" y="770" width="200" height="60" as="geometry"/></mxCell>
