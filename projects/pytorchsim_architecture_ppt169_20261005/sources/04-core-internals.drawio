        <mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#4B5563;strokeWidth=1.5;fontSize=10;fontColor=#1F2933;jumpStyle=arc;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.7593;entryDx=0;entryDy=0;" edge="1" parent="1" source="stq" target="dma"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="resp" value="响应计数&lt;br&gt;&lt;font style='font-size:10px;font-weight:normal;color:#555555'&gt;waiting_request − 1&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="1240" y="190" width="180" height="60" as="geometry"/></mxCell>
        <mxCell id="req" value="请求队列&lt;br&gt;&lt;font style='font-size:10px;font-weight:normal;color:#555555'&gt;_request_queue&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="1240" y="280" width="180" height="60" as="geometry"/></mxCell>
        <mxCell id="icnt" value="互连 → L2 / DRAM&lt;br&gt;&lt;font style='font-size:10px;font-weight:normal;color:#555555'&gt;（核外，见 03）&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;fontStyle=1;align=center;dashed=1;" vertex="1" parent="1"><mxGeometry x="1500" y="190" width="200" height="150" as="geometry"/></mxCell>
        <mxCell id="e11" value="mem_fetch" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#4B5563;strokeWidth=1.5;fontSize=10;fontColor=#1F2933;jumpStyle=arc;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.8889;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="dma" target="req"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#4B5563;strokeWidth=1.5;fontSize=10;fontColor=#1F2933;jumpStyle=arc;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="req" target="icnt"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e13" value="响应" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#4B5563;strokeWidth=1.5;fontSize=10;fontColor=#1F2933;jumpStyle=arc;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0;exitY=0.2;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="icnt" target="resp"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e14" value="归零：同步读完成；异步读置 tag = 1 并唤醒等它的 BAR / MOVIN" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#4B5563;strokeWidth=1.5;fontSize=10;fontColor=#1F2933;jumpStyle=arc;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="resp" target="tag"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1330" y="74"/><mxPoint x="760" y="74"/></Array></mxGeometry></mxCell>
        <mxCell id="fin" value="finish_instruction&lt;br&gt;&lt;font style='font-size:10px;font-weight:normal;color:#555555'&gt;子指令依赖减一 → 进 ready&lt;br&gt;tile 内全部完成 → FINISH&lt;br&gt;BAR：tag 就绪时完成&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="920" y="600" width="260" height="100" as="geometry"/></mxCell>
        <mxCell id="e15" value="到 finish_cycle" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#4B5563;strokeWidth=1.5;fontSize=10;fontColor=#1F2933;jumpStyle=arc;labelBackgroundColor=#FFFFFF;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="vu" target="fin"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="900" y="370"/><mxPoint x="900" y="630"/></Array></mxGeometry></mxCell>
        <mxCell id="e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#4B5563;strokeWidth=1.5;fontSize=10;fontColor=#1F2933;jumpStyle=arc;labelBackgroundColor=#FFFFFF;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="1" source="sa" target="fin"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="885" y="475"/><mxPoint x="885" y="660"/></Array></mxGeometry></mxCell>
        <mxCell id="e17" value="写请求全部发出 / 异步读请求发完" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#4B5563;strokeWidth=1.5;fontSize=10;fontColor=#1F2933;jumpStyle=arc;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="dma" target="fin"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#4B5563;strokeWidth=1.5;fontSize=10;fontColor=#1F2933;jumpStyle=arc;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0;exitY=0.85;exitDx=0;exitDy=0;entryX=1;entryY=0.912;entryDx=0;entryDy=0;" edge="1" parent="1" source="fin" target="tiles"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="350" y="685"/><mxPoint x="350" y="400"/></Array></mxGeometry></mxCell>
        <mxCell id="timing" value="COMP 的完成时间&lt;br&gt;&lt;font style='font-size:10px;font-weight:normal;color:#555555'&gt;目标流水线为空：finish = now + compute_cycle&lt;br&gt;不为空：overlap = min(前一条 finish − now, overlapping_cycle)&lt;br&gt;　　　　finish = 前一条 finish + compute_cycle − overlap&lt;br&gt;&lt;br&gt;compute_cycle 即 TOG 里的 torchsim_cycle，来自 Gem5 采样&lt;br&gt;compute_cycle = 0 的 COMP 直接跳过&lt;br&gt;MATMUL / PRELOAD 在 N 个 SA 之间轮询分配&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1270" y="380" width="590" height="160" as="geometry"/></mxCell>
        <mxCell id="note" value="没有逐拍建模的部分&lt;br&gt;&lt;font style='font-size:10px;font-weight:normal;color:#555555'&gt;SPAD 容量和 bank 冲突：只在编译期选 tile 时约束&lt;br&gt;数值计算：Core 只推进时间和依赖，数值来自 Spike&lt;br&gt;BAR 遇到稀疏 tag（−1）时，把子 MATMUL 的周期置 0&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#9AA5B1;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1270" y="570" width="590" height="100" as="geometry"/></mxCell>
