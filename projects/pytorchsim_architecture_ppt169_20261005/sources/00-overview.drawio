        <mxCell id="title" value="PyTorchSim 总览：PyTorch 程序 → 编译产物 → 功能执行 + 系统级时序模拟" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontColor=#1F2933;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="1860" height="28" as="geometry"/></mxCell>
