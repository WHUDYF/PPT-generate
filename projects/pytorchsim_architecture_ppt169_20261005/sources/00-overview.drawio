        <mxCell id="dyn" value="Dynamo + AOTAutograd&lt;br&gt;&lt;font style='font-size:10px;font-weight:normal;color:#555555'&gt;捕获 FX 图，规范为 ATen 算子&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="370" y="100" width="320" height="70" as="geometry"/></mxCell>
        <mxCell id="ind" value="Inductor + MLIRScheduling&lt;br&gt;&lt;font style='font-size:10px;font-weight:normal;color:#555555'&gt;① 分解：改写成可处理的形式&lt;br&gt;② lowering：GEMM / Conv 模板或通用 kernel&lt;br&gt;③ 融合：决定 kernel 边界&lt;br&gt;④ 映射：按硬件参数选 tile&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="370" y="210" width="320" height="150" as="geometry"/></mxCell>
