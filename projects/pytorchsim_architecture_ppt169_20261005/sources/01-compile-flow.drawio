<mxfile host="app.diagrams.net" agent="pytorchsim-architecture" version="24.7.17" type="device">
  <diagram id="cf" name="Compile flow">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="880" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="编译链：ATen 图 → kernel MLIR → 功能二进制 / 采样二进制 + TOG" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontColor=#1F2933;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="1860" height="28" as="geometry"/></mxCell>
        <mxCell id="tx1" value='上排是 Inductor 内的决策（决定"实现成什么样"），下排是两条降级链（决定"交给谁执行"）。灰字为源码位置。' style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="36" width="1200" height="20" as="geometry"/></mxCell>
        <mxCell id="s1" value="图捕获&lt;br&gt;&lt;font style='font-size:10px;font-weight:normal;color:#555555'&gt;Dynamo 抓 FX 图&lt;br&gt;AOTAutograd 规范为 ATen 算子&lt;br&gt;（PyTorch 自带，本仓库不重写）&lt;br&gt;&lt;br&gt;&lt;font style='color:#8A8F98'&gt;torch._dynamo · AOTAutograd&lt;/font&gt;&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="20" y="64" width="280" height="190" as="geometry"/></mxCell>
        <mxCell id="bd2" value="①" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1F2933;strokeColor=#1F2933;fontColor=#FFFFFF;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="270" y="72" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="s2" value="分解&lt;br&gt;&lt;font style='font-size:10px;font-weight:normal;color:#555555'&gt;1×1 卷积 → linear&lt;br&gt;逐通道分组卷积 → gather + mul + add&lt;br&gt;（后者只为正确性，不是高性能模板）&lt;br&gt;&lt;br&gt;&lt;font style='color:#8A8F98'&gt;mlir/mlir_decomposition.py&lt;/font&gt;&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="330" y="64" width="280" height="190" as="geometry"/></mxCell>
        <mxCell id="bd3" value="②" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1F2933;strokeColor=#1F2933;fontColor=#FFFFFF;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="580" y="72" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="s3" value="Lowering：选生成路径&lt;br&gt;&lt;font style='font-size:10px;font-weight:normal;color:#555555'&gt;mm / addmm → MLIRGemmTemplate&lt;br&gt;bmm → BMM 模板 · conv → Conv 模板&lt;br&gt;逐元素 / reduction → MLIRKernel&lt;br&gt;&lt;br&gt;&lt;font style='color:#8A8F98'&gt;mlir/mlir_lowering.py&lt;/font&gt;&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="640" y="64" width="280" height="190" as="geometry"/></mxCell>
        <mxCell id="bd4" value="③" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1F2933;strokeColor=#1F2933;fontColor=#FFFFFF;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="890" y="72" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="s4" value="融合：定 kernel 边界&lt;br&gt;&lt;font style='font-size:10px;font-weight:normal;color:#555555'&gt;can_fuse_horizontal / vertical&lt;br&gt;GEMM 的 prologue / epilogue&lt;br&gt;（bias、激活、部分 reduction）&lt;br&gt;&lt;br&gt;&lt;font style='color:#8A8F98'&gt;mlir/mlir_scheduling.py&lt;/font&gt;&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="950" y="64" width="280" height="190" as="geometry"/></mxCell>
        <mxCell id="bd5" value="④" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1F2933;strokeColor=#1F2933;fontColor=#FFFFFF;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1200" y="72" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="s5" value="映射：选 tile&lt;br&gt;&lt;font style='font-size:10px;font-weight:normal;color:#555555'&gt;候选 (TM,TN,TK[,subTM,subTN,subTK])&lt;br&gt;lane 对齐 · 每 lane SPAD ÷ 2（双缓冲）&lt;br&gt;heuristic / autotune / external&lt;br&gt;&lt;br&gt;&lt;font style='color:#8A8F98'&gt;mlir_gemm_template.py · mlir_template.py&lt;/font&gt;&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1260" y="64" width="280" height="190" as="geometry"/></mxCell>
