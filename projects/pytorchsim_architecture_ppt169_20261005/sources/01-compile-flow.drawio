        <mxCell id="f1" value="mlir-opt 降级&lt;br&gt;&lt;font style='font-size:10px;font-weight:normal;color:#555555'&gt;-test-loop-padding&lt;br&gt;-dma-fine-grained&lt;br&gt;-global-idx (vlen=256)&lt;br&gt;-test-pytorchsim-to-vcix&lt;br&gt;-test-memref-to-gemmini&lt;br&gt;+ 标准 linalg/affine/vector → LLVM&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="200" y="410" width="300" height="160" as="geometry"/></mxCell>
        <mxCell id="f2" value="mlir-translate → llc&lt;br&gt;&lt;font style='font-size:10px;font-weight:normal;color:#555555'&gt;LLVM IR → RISC-V64 目标文件&lt;br&gt;+m,f,d,a,c,v,zvfh,xsfvcp&lt;br&gt;zvl256b（向量长度 256 位）&lt;br&gt;同时输出 .s 便于阅读&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="540" y="410" width="260" height="160" as="geometry"/></mxCell>
