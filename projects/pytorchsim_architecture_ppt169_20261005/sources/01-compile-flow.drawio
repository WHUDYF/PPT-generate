        <mxCell id="t4" value="AsmParser&lt;br&gt;&lt;font style='font-size:10px;font-weight:normal;color:#555555'&gt;tog_generator.py&lt;br&gt;读 *_tog.py，恢复层次与依赖&lt;br&gt;把 cycle_list 填进计算节点&lt;br&gt;（不够时报错并用 10 cycles 兜底）&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1140" y="620" width="280" height="160" as="geometry"/></mxCell>
