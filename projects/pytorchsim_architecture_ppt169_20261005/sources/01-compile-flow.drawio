        <mxCell id="f4" value="Spike（定制）&lt;br&gt;&lt;font style='font-size:10px;font-weight:normal;color:#555555'&gt;FunctionalSimulator.run_spike&lt;br&gt;执行功能二进制 → 输出张量&lt;br&gt;间接访问时产出访问轨迹&lt;br&gt;vlen 固定为 256&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1140" y="410" width="280" height="160" as="geometry"/></mxCell>
