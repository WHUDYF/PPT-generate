        <mxCell id="s6" value="代码生成&lt;br&gt;&lt;font style='font-size:10px;font-weight:normal;color:#555555'&gt;kernel .mlir：affine / vector + DMA&lt;br&gt;Python wrapper：调用顺序、中间张量&lt;br&gt;MLIRCodeCache.load 驱动下排&lt;br&gt;&lt;br&gt;&lt;font style='color:#8A8F98'&gt;mlir_codegen_backend.py&lt;/font&gt;&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1570" y="64" width="280" height="190" as="geometry"/></mxCell>
