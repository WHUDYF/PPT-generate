<mxfile host="app.diagrams.net" agent="currygpu-subcore" version="24.7.17" type="device">
  <diagram id="hint01" name="HINT 工作流">
    <mxGraphModel dx="1600" dy="810" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="810" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
    <mxCell id="t1" value="HINT ① 工作流：Stage 0–3，每道关卡之后才进下一步" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontColor=#1F2933;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="1560" height="28" as="geometry"/></mxCell>
    <mxCell id="t2" value="来源：HINT, arXiv 2608.07625v2（正文文字）。论文的图 1–3 是图片、HINT 规范未公开，框内名称用论文术语，不是 HINT 语法。" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="38" width="1560" height="20" as="geometry"/></mxCell>
    <mxCell id="in_spec" value="&lt;b&gt;设计规格&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px;font-weight:normal;color:#555555&#x27;&gt;自然语言 / 文档&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;fontSize=13;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="20" y="130" width="200" height="70" as="geometry"/></mxCell>
    <mxCell id="in_oracle" value="&lt;b&gt;可执行参考&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px;font-weight:normal;color:#555555&#x27;&gt;C/C++ 参考模型或原生测试&lt;/font&gt;&lt;div style=&#x27;text-align:left;font-size:11px;font-weight:normal;margin-top:6px;line-height:1.4&#x27;&gt;作 oracle 用，&lt;b&gt;不是&lt;/b&gt; HINT 的输入&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;fontSize=13;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="20" y="220" width="200" height="90" as="geometry"/></mxCell>
    <mxCell id="f0" value="Stage 0 · 任务与验证准备" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#6C8EBF;dashed=1;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontSize=13;fontStyle=1;fontColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="250" y="110" width="300" height="420" as="geometry"/></mxCell>
    <mxCell id="s0_env" value="&lt;b&gt;Environment agent&lt;/b&gt;&lt;div style=&#x27;text-align:left;font-size:11px;font-weight:normal;margin-top:6px;line-height:1.4&#x27;&gt;· 确定范围与依赖&lt;br&gt;· 抽取接口 / 事务 / 时序契约&lt;br&gt;· 需要时按硬件归属切分&lt;br&gt;· 搭建验证环境&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="265" y="140" width="270" height="170" as="geometry"/></mxCell>
    <mxCell id="s0_tests" value="&lt;b&gt;测试资产&lt;/b&gt;&lt;div style=&#x27;text-align:left;font-size:11px;font-weight:normal;margin-top:6px;line-height:1.4&#x27;&gt;· 已知向量 + 定向边角&lt;br&gt;· + 约束随机事务&lt;br&gt;· RealBench 用原生测试&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="265" y="330" width="270" height="110" as="geometry"/></mxCell>
    <mxCell id="s0_frozen" value="&lt;b&gt;冻结：测试与验收规则&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px;font-weight:normal;color:#555555&#x27;&gt;设计 agent 不能修改&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F2933;fontSize=13;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="265" y="455" width="270" height="60" as="geometry"/></mxCell>
    <mxCell id="f1" value="Stage 1 · 生成并验收 HINT" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9673A6;dashed=1;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontSize=13;fontStyle=1;fontColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="580" y="110" width="300" height="420" as="geometry"/></mxCell>
    <mxCell id="s1_gen" value="&lt;b&gt;选微架构，写成 HINT&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px;font-weight:normal;color:#555555&#x27;&gt;受限 C 风格参考 profile&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="595" y="140" width="270" height="90" as="geometry"/></mxCell>
    <mxCell id="s1_lint" value="&lt;b&gt;HINT Lint Checker&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px;font-weight:normal;color:#555555&#x27;&gt;仅完整工作流&lt;/font&gt;&lt;div style=&#x27;text-align:left;font-size:11px;font-weight:normal;margin-top:6px;line-height:1.4&#x27;&gt;只报结构违例；不提出微架构、不估 QoR&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="595" y="245" width="270" height="90" as="geometry"/></mxCell>
    <mxCell id="s1_acc" value="&lt;b&gt;可执行验收&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px;font-weight:normal;color:#555555&#x27;&gt;在 Stage 0 环境里跑同一套冻结测试&lt;/font&gt;&lt;div style=&#x27;text-align:left;font-size:11px;font-weight:normal;margin-top:6px;line-height:1.4&#x27;&gt;事务级比较输出与边界事件&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="595" y="350" width="270" height="90" as="geometry"/></mxCell>
    <mxCell id="s1_out" value="&lt;b&gt;已验收的 HINT&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px;font-weight:normal;color:#555555&#x27;&gt;定下微架构，约束 RTL lowering&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F2933;fontSize=13;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="595" y="455" width="270" height="60" as="geometry"/></mxCell>
    <mxCell id="f2" value="Stage 2 · RTL lowering 与验收" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#D6B656;dashed=1;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontSize=13;fontStyle=1;fontColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="910" y="110" width="300" height="420" as="geometry"/></mxCell>
    <mxCell id="s2_low" value="&lt;b&gt;按 lowering 义务写 RTL&lt;/b&gt;&lt;div style=&#x27;text-align:left;font-size:11px;font-weight:normal;margin-top:6px;line-height:1.4&#x27;&gt;接口、状态、数据通路、调度、资源&lt;br&gt;“不再从行为代码重新推断组织”&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="925" y="140" width="270" height="110" as="geometry"/></mxCell>
    <mxCell id="s2_cos" value="&lt;b&gt;HINT ↔ RTL 对比&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px;font-weight:normal;color:#555555&#x27;&gt;同一套冻结测试&lt;/font&gt;&lt;div style=&#x27;text-align:left;font-size:11px;font-weight:normal;margin-top:6px;line-height:1.4&#x27;&gt;比较可观察数据 + 时序&lt;br&gt;另与参考模型 / 原 RTL 比；都没有时用规格给的目标延迟&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="925" y="265" width="270" height="110" as="geometry"/></mxCell>
    <mxCell id="s2_fix" value="&lt;b&gt;局部实现修复&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px;font-weight:normal;color:#555555&#x27;&gt;留在 Stage 2&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="925" y="390" width="270" height="60" as="geometry"/></mxCell>
    <mxCell id="s2_out" value="&lt;b&gt;通过验收的 RTL&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F2933;fontSize=13;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="925" y="465" width="270" height="50" as="geometry"/></mxCell>
    <mxCell id="f3" value="Stage 3 · 综合与 QoR" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#82B366;dashed=1;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontSize=13;fontStyle=1;fontColor=#82B366;" vertex="1" parent="1"><mxGeometry x="1240" y="110" width="340" height="420" as="geometry"/></mxCell>
    <mxCell id="s3_syn" value="&lt;b&gt;综合&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px;font-weight:normal;color:#555555&#x27;&gt;SKY130 · DC compile_ultra&lt;/font&gt;&lt;div style=&#x27;text-align:left;font-size:11px;font-weight:normal;margin-top:6px;line-height:1.4&#x27;&gt;报告面积、关键路径、ADP&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1255" y="140" width="310" height="100" as="geometry"/></mxCell>
    <mxCell id="s3_fb" value="&lt;b&gt;可选的综合反馈&lt;/b&gt;&lt;div style=&#x27;text-align:left;font-size:11px;font-weight:normal;margin-top:6px;line-height:1.4&#x27;&gt;→ 局部 RTL 修复，或&lt;br&gt;→ 回到 Stage 1 改微架构&lt;br&gt;两条路都要重过对应关卡&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1255" y="260" width="310" height="110" as="geometry"/></mxCell>
    <mxCell id="s3_stop" value="&lt;b&gt;RQ1 的停止点&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px;font-weight:normal;color:#555555&#x27;&gt;验收后第一次综合成功即冻结&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1255" y="390" width="310" height="70" as="geometry"/></mxCell>
