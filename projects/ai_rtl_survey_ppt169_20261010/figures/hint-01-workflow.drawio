    <mxCell id="e_l_c" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="s2_low" target="s2_cos"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
    <mxCell id="e_c_f" value="不过" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#B85450;fontSize=10;labelBackgroundColor=#FFFFFF;fontColor=#B85450;" edge="1" parent="1" source="s2_cos" target="s2_fix"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
