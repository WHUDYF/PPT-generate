    <mxCell id="cfg_2_2" value="HINT Lint Checker 检查规范形式" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="430" y="648" width="290" height="30" as="geometry"/></mxCell>
    <mxCell id="cfg_3_0" value="切分 / 集成" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#999999;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="678" width="130" height="30" as="geometry"/></mxCell>
    <mxCell id="cfg_3_1" value="无" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="150" y="678" width="280" height="30" as="geometry"/></mxCell>
