    <mxCell id="cfg_0_2" value="完整工作流（RQ2，RealBench、Vortex）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="430" y="588" width="290" height="30" as="geometry"/></mxCell>
