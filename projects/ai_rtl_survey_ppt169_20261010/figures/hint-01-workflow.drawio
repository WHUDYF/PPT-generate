    <mxCell id="e_a_o" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="s1_acc" target="s1_out"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
