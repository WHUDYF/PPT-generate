    <mxCell id="cfg_1_1" value="一个 Codex ReAct 节点，固定反馈" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="150" y="618" width="280" height="30" as="geometry"/></mxCell>
    <mxCell id="cfg_1_2" value="多 agent：环境、生成、架构评审" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="430" y="618" width="290" height="30" as="geometry"/></mxCell>
    <mxCell id="cfg_2_0" value="Lint" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#999999;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="648" width="130" height="30" as="geometry"/></mxCell>
