<mxfile host="app.diagrams.net" agent="currygpu-subcore" version="24.7.17" type="device">
  <diagram id="hint04" name="HINT Vortex VPU">
    <mxGraphModel dx="1600" dy="590" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="590" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
    <mxCell id="t1" value="HINT ④ Vortex VPU 案例：按状态归属切 5 块，逐块验收后在顶层复验" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontColor=#1F2933;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="1560" height="28" as="geometry"/></mxCell>
    <mxCell id="t2" value="来源：HINT, arXiv 2608.07625v2（正文文字）。论文的图 1–3 是图片、HINT 规范未公开，框内名称用论文术语，不是 HINT 语法。" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="38" width="1560" height="20" as="geometry"/></mxCell>
    <mxCell id="vo" value="&lt;b&gt;C++ oracle（冻结）&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px;font-weight:normal;color:#555555&#x27;&gt;从 Vortex fe8168b 抽出&lt;/font&gt;&lt;div style=&#x27;text-align:left;font-size:11px;font-weight:normal;margin-top:6px;line-height:1.4&#x27;&gt;· 48 条定向 + 500 条种子随机根事务&lt;br&gt;· 配置 / CSR&lt;br&gt;· OPIVV / OPIVI / OPIVX / OPMVV / OPMVX&lt;br&gt;· 零长度与短长度&lt;br&gt;· 单位步长访存，宽度 1 / 2 / 4&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;fontSize=13;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="20" y="80" width="330" height="250" as="geometry"/></mxCell>
    <mxCell id="vscope" value="&lt;b&gt;范围&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px;font-weight:normal;color:#555555&#x27;&gt;128 位、非浮点向量子系统&lt;/font&gt;&lt;div style=&#x27;text-align:left;font-size:11px;font-weight:normal;margin-top:6px;line-height:1.4&#x27;&gt;· RVV 式配置 / CSR、32 个向量寄存器&lt;br&gt;· SEW 8/16/32 整数、乘法、mask、move&lt;br&gt;· 带 mask 的提交&lt;br&gt;· 单位步长访存请求 / 响应&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;fontSize=13;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="20" y="350" width="330" height="160" as="geometry"/></mxCell>
    <mxCell id="vp" value="Stage 0 按硬件归属切分（每块 HINT 与 RTL 各自对 oracle co-sim）" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#6C8EBF;dashed=1;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontSize=13;fontStyle=1;fontColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="380" y="70" width="820" height="440" as="geometry"/></mxCell>
    <mxCell id="vb0" value="&lt;b&gt;vcfg&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px;font-weight:normal;color:#555555&#x27;&gt;配置 / CSR 状态&lt;/font&gt;&lt;div style=&#x27;text-align:left;font-size:11px;font-weight:normal;margin-top:6px;line-height:1.4&#x27;&gt;HINT 461 行 → RTL 654 行&lt;br&gt;面积 14,647 µm²&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="395" y="110" width="250" height="170" as="geometry"/></mxCell>
    <mxCell id="vb1" value="&lt;b&gt;vrf&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px;font-weight:normal;color:#555555&#x27;&gt;32 个向量寄存器&lt;/font&gt;&lt;div style=&#x27;text-align:left;font-size:11px;font-weight:normal;margin-top:6px;line-height:1.4&#x27;&gt;HINT 358 行 → RTL 248 行&lt;br&gt;面积 177,245 µm²&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="660" y="110" width="250" height="170" as="geometry"/></mxCell>
    <mxCell id="vb2" value="&lt;b&gt;int_exec&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px;font-weight:normal;color:#555555&#x27;&gt;整数 / 乘法执行&lt;/font&gt;&lt;div style=&#x27;text-align:left;font-size:11px;font-weight:normal;margin-top:6px;line-height:1.4&#x27;&gt;HINT 809 行 → RTL 707 行&lt;br&gt;面积 94,411 µm²&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="925" y="110" width="250" height="170" as="geometry"/></mxCell>
    <mxCell id="vb3" value="&lt;b&gt;mv_mask&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px;font-weight:normal;color:#555555&#x27;&gt;move 与 mask&lt;/font&gt;&lt;div style=&#x27;text-align:left;font-size:11px;font-weight:normal;margin-top:6px;line-height:1.4&#x27;&gt;HINT 465 行 → RTL 380 行&lt;br&gt;面积 39,590 µm²&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="395" y="300" width="250" height="170" as="geometry"/></mxCell>
    <mxCell id="vb4" value="&lt;b&gt;vlsu&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px;font-weight:normal;color:#555555&#x27;&gt;单位步长访存&lt;/font&gt;&lt;div style=&#x27;text-align:left;font-size:11px;font-weight:normal;margin-top:6px;line-height:1.4&#x27;&gt;HINT 651 行 → RTL 871 行&lt;br&gt;面积 160,720 µm²&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="660" y="300" width="250" height="170" as="geometry"/></mxCell>
    <mxCell id="vtop" value="&lt;b&gt;顶层复验&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px;font-weight:normal;color:#555555&#x27;&gt;重新连接后&lt;/font&gt;&lt;div style=&#x27;text-align:left;font-size:11px;font-weight:normal;margin-top:6px;line-height:1.4&#x27;&gt;5 块重新连接后，在顶层事务边界再比一次&lt;br&gt;HINT 2,744 行 → RTL 3,541 行&lt;br&gt;561,667 µm² · 14.69 ns&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F2933;fontSize=13;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="925" y="300" width="250" height="170" as="geometry"/></mxCell>
    <mxCell id="vo_e" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.17;entryDx=0;entryDy=0;" edge="1" parent="1" source="vo" target="vp"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
    <mxCell id="vn" value="注意" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#B85450;dashed=1;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontSize=13;fontStyle=1;fontColor=#B85450;" vertex="1" parent="1"><mxGeometry x="1230" y="70" width="350" height="440" as="geometry"/></mxCell>
    <mxCell id="vn1" value="· vrf、vlsu 面积大，是因为库里没有存储宏，存储用标准单元寄存器&lt;br&gt;&lt;br&gt;· 论文没写各块的构建顺序，也没写契约是怎么抽出来的（只说是 Stage 0 环境 agent 的职责）&lt;br&gt;&lt;br&gt;· 这是可行性 / 规模证据，不并入 RQ1 的对比&lt;br&gt;&lt;br&gt;· 切分依据是“硬件归属”：每块拥有自己的状态，块之间只有事务接口" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="1245" y="105" width="320" height="390" as="geometry"/></mxCell>
    <mxCell id="n4" value="从作者角度：大设计不是一次写成，而是先由环境 agent 按状态归属切块、冻结每块的事务契约，每块独立走 Stage 1–2，最后只在顶层事务边界复验。" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="20" y="530" width="1560" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
