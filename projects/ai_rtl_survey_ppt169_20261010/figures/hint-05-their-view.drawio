<mxfile host="app.diagrams.net" agent="currygpu-subcore" version="24.7.17" type="device">
  <diagram id="hint05" name="HINT 视角与 subcore">
    <mxGraphModel dx="1600" dy="570" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="570" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
    <mxCell id="t1" value="HINT ⑤ 站在作者角度：为什么这样设计，以及拿它做 subcore 会遇到什么" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontColor=#1F2933;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="1560" height="28" as="geometry"/></mxCell>
    <mxCell id="t2" value="左栏是论文原文的设计理由；右栏是我们的推演（未经作者确认、未实验）。" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="38" width="1560" height="20" as="geometry"/></mxCell>
    <mxCell id="why" value="作者的设计理由（论文原文）" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9673A6;dashed=1;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontSize=13;fontStyle=1;fontColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="620" height="480" as="geometry"/></mxCell>
    <mxCell id="w0" value="&lt;b&gt;为什么要中间层&lt;/b&gt;&lt;div style=&#x27;text-align:left;font-size:11px;font-weight:normal;margin-top:6px;line-height:1.4&#x27;&gt;直接生成把选微架构和写底层代码耦合在一起，反馈里架构错和编码错混在一起&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="35" y="105" width="590" height="78" as="geometry"/></mxCell>
    <mxCell id="w1" value="&lt;b&gt;为什么可执行&lt;/b&gt;&lt;div style=&#x27;text-align:left;font-size:11px;font-weight:normal;margin-top:6px;line-height:1.4&#x27;&gt;信号级仿真之前就能用编译器、调试器、oracle 在事务层排错；QoR 决定显式可见&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="35" y="193" width="590" height="78" as="geometry"/></mxCell>
    <mxCell id="w2" value="&lt;b&gt;为什么停在周期级之上&lt;/b&gt;&lt;div style=&#x27;text-align:left;font-size:11px;font-weight:normal;margin-top:6px;line-height:1.4&#x27;&gt;要显式、可检查，但“高于周期和信号级实现”；周期精确 SystemC 接近被推迟的实现负担&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="35" y="281" width="590" height="78" as="geometry"/></mxCell>
    <mxCell id="w3" value="&lt;b&gt;为什么不用 HLS&lt;/b&gt;&lt;div style=&#x27;text-align:left;font-size:11px;font-weight:normal;margin-top:6px;line-height:1.4&#x27;&gt;C2HLSC 把调度、绑定、控制生成留给 HLS 工具；HINT 把它们写明&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="35" y="369" width="590" height="78" as="geometry"/></mxCell>
    <mxCell id="w4" value="&lt;b&gt;为什么不用 Calyx / FIRRTL / CIRCT&lt;/b&gt;&lt;div style=&#x27;text-align:left;font-size:11px;font-weight:normal;margin-top:6px;line-height:1.4&#x27;&gt;那些工作在前端已给出结构之后；HINT 针对更早的、面向 LLM 的架构编写阶段&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="35" y="457" width="590" height="78" as="geometry"/></mxCell>
    <mxCell id="ours" value="推演：用 HINT 写 subcore 的 S1 / S2" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#D79B00;dashed=1;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontSize=13;fontStyle=1;fontColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="670" y="70" width="910" height="480" as="geometry"/></mxCell>
    <mxCell id="m1" value="&lt;b&gt;能直接对上的&lt;/b&gt;&lt;div style=&#x27;text-align:left;font-size:11px;font-weight:normal;margin-top:6px;line-height:1.4&#x27;&gt;· 大级 = unit，自有状态 = 我们的“状态只有一个主人”&lt;br&gt;· commit 纪律 = 向前只走寄存器&lt;br&gt;· 按归属切块 = 一大级一模块&lt;br&gt;· 执行模型里有 pipeline 标签&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="685" y="105" width="430" height="120" as="geometry"/></mxCell>
    <mxCell id="m2" value="&lt;b&gt;要先定的：step 的 t 取什么&lt;/b&gt;&lt;div style=&#x27;text-align:left;font-size:11px;font-weight:normal;margin-top:6px;line-height:1.4&#x27;&gt;&lt;b&gt;t = 一条指令（事务）&lt;/b&gt;：符合 HINT 本意，但拍级约束写不进去&lt;br&gt;&lt;b&gt;t = 一拍&lt;/b&gt;：能写，但这正是作者刻意回避的周期级模型&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=13;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1135" y="105" width="430" height="120" as="geometry"/></mxCell>
    <mxCell id="m3" value="&lt;b&gt;若 t = 一条指令：G2 首轮会怎样&lt;/b&gt;&lt;div style=&#x27;text-align:left;font-size:11px;font-weight:normal;margin-top:6px;line-height:1.4&#x27;&gt;· “同一 warp 两次发射间隔 ≥ 2 拍”跨两条事务、且是拍级约束，事务层表达不出&lt;br&gt;· iadd3 的输出正确 → HINT vs oracle、HINT vs RTL 都会判通过（预计）&lt;br&gt;· 错误要到 mix / control_flow 的端到端结果才出现，与我们实际经历相同&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="685" y="240" width="880" height="100" as="geometry"/></mxCell>
    <mxCell id="m4" value="&lt;b&gt;动态行为放在哪&lt;/b&gt;&lt;div style=&#x27;text-align:left;font-size:11px;font-weight:normal;margin-top:6px;line-height:1.4&#x27;&gt;· canonical form 要求静态有界；多 warp 争抢、scoreboard、变长单元、反压都是数据相关的&lt;br&gt;· 论文的接口只有“有类型的事务边界”，没有 valid/ready / stall 的写法&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="685" y="355" width="880" height="80" as="geometry"/></mxCell>
    <mxCell id="m5" value="&lt;b&gt;因此我们要补的一层&lt;/b&gt;&lt;div style=&#x27;text-align:left;font-size:11px;font-weight:normal;margin-top:6px;line-height:1.4&#x27;&gt;在 HINT 式单元之上加“逐拍契约”：哪些拍数必须与性能模型相等、哪些只有上下界、哪些登记为偏差&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;fontSize=13;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="685" y="450" width="880" height="85" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
