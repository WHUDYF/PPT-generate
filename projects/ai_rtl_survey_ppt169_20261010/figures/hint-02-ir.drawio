<mxfile host="app.diagrams.net" agent="currygpu-subcore" version="24.7.17" type="device">
  <diagram id="hint02" name="HINT IR">
    <mxGraphModel dx="1600" dy="790" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="790" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
    <mxCell id="t1" value="HINT ② IR：五层义务 + 一个“单元”的构成" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontColor=#1F2933;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="1560" height="28" as="geometry"/></mxCell>
    <mxCell id="t2" value="来源：HINT, arXiv 2608.07625v2（正文文字）。论文的图 1–3 是图片、HINT 规范未公开，框内名称用论文术语，不是 HINT 语法。" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="38" width="1560" height="20" as="geometry"/></mxCell>
    <mxCell id="lt" value="论文表 1：每层赋予的硬件含义" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=14;fontColor=#1F2933;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="72" width="560" height="22" as="geometry"/></mxCell>
    <mxCell id="ly0" value="&lt;b&gt;1 · 程序 / 对象模型&lt;/b&gt;&lt;div style=&#x27;text-align:left;font-size:11px;font-weight:normal;margin-top:6px;line-height:1.4&#x27;&gt;units、持久的子 / helper 实例、层次、显式归属&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="20" y="100" width="560" height="82" as="geometry"/></mxCell>
    <mxCell id="ly1" value="&lt;b&gt;2 · 类型 / 接口 / 行为&lt;/b&gt;&lt;div style=&#x27;text-align:left;font-size:11px;font-weight:normal;margin-top:6px;line-height:1.4&#x27;&gt;定宽对象、有类型的事务边界、运算、存储 / buffer 语义&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="20" y="192" width="560" height="82" as="geometry"/></mxCell>
    <mxCell id="ly2" value="&lt;b&gt;3 · 状态 / 控制 / 执行&lt;/b&gt;&lt;div style=&#x27;text-align:left;font-size:11px;font-weight:normal;margin-top:6px;line-height:1.4&#x27;&gt;当前 / 下一状态、reset / commit、有界推进；&lt;br&gt;执行模型：组合 / FSM / phase / counter / pipeline&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="20" y="284" width="560" height="82" as="geometry"/></mxCell>
    <mxCell id="ly3" value="&lt;b&gt;4 · 资源 / QoR 模型&lt;/b&gt;&lt;div style=&#x27;text-align:left;font-size:11px;font-weight:normal;margin-top:6px;line-height:1.4&#x27;&gt;共享、复制、复用范围、staging、存储、QoR 标注&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="20" y="376" width="560" height="82" as="geometry"/></mxCell>
    <mxCell id="ly4" value="&lt;b&gt;5 · RTL lowering 义务&lt;/b&gt;&lt;div style=&#x27;text-align:left;font-size:11px;font-weight:normal;margin-top:6px;line-height:1.4&#x27;&gt;接口、状态、数据通路、调度、资源上的承诺带进 RTL&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=13;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="20" y="468" width="560" height="82" as="geometry"/></mxCell>
    <mxCell id="unit" value="一个 HINT 单元（unit）= 一个模块 / IP 级块" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#1F2933;dashed=1;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontSize=13;fontStyle=1;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="620" y="72" width="960" height="470" as="geometry"/></mxCell>
    <mxCell id="u_req" value="&lt;b&gt;请求对象&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px;font-weight:normal;color:#555555&#x27;&gt;有类型的事务边界（输入 i_t）&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="640" y="120" width="200" height="80" as="geometry"/></mxCell>
    <mxCell id="u_resp" value="&lt;b&gt;响应对象&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px;font-weight:normal;color:#555555&#x27;&gt;有类型的事务边界（输出 o_t）&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1360" y="120" width="200" height="80" as="geometry"/></mxCell>
    <mxCell id="u_step" value="&lt;b&gt;step 入口（每个单元恰好一个）&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px;font-weight:normal;color:#555555&#x27;&gt;(o_t, s_{t+1}) = step_H(i_t, s_t)&lt;/font&gt;&lt;div style=&#x27;text-align:left;font-size:11px;font-weight:normal;margin-top:6px;line-height:1.4&#x27;&gt;t 是抽象推进，&lt;b&gt;不一定是 RTL 时钟周期&lt;/b&gt;&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F2933;fontSize=13;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="880" y="110" width="440" height="110" as="geometry"/></mxCell>
    <mxCell id="u_state" value="&lt;b&gt;自有状态 s_t&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px;font-weight:normal;color:#555555&#x27;&gt;只有本单元能写&lt;/font&gt;&lt;div style=&#x27;text-align:left;font-size:11px;font-weight:normal;margin-top:6px;line-height:1.4&#x27;&gt;当前状态：输出只读它&lt;br&gt;只保留与架构相关的状态&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="880" y="250" width="210" height="130" as="geometry"/></mxCell>
    <mxCell id="u_next" value="&lt;b&gt;下一状态 s_{t+1}&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px;font-weight:normal;color:#555555&#x27;&gt;默认保持（hold）&lt;/font&gt;&lt;div style=&#x27;text-align:left;font-size:11px;font-weight:normal;margin-top:6px;line-height:1.4&#x27;&gt;在 step 边界 &lt;b&gt;commit&lt;/b&gt;&lt;br&gt;reset / commit 显式写出&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1110" y="250" width="210" height="130" as="geometry"/></mxCell>
    <mxCell id="u_inst" value="&lt;b&gt;子实例&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px;font-weight:normal;color:#555555&#x27;&gt;持久的子块，不是函数调用&lt;/font&gt;&lt;div style=&#x27;text-align:left;font-size:11px;font-weight:normal;margin-top:6px;line-height:1.4&#x27;&gt;例：一个 round 数据通路被所有轮复用&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="640" y="250" width="200" height="130" as="geometry"/></mxCell>
    <mxCell id="u_exec" value="&lt;b&gt;执行模型标签&lt;/b&gt;&lt;div style=&#x27;text-align:left;font-size:11px;font-weight:normal;margin-top:6px;line-height:1.4&#x27;&gt;组合 / FSM / phase /&lt;br&gt;counter / pipeline&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1360" y="250" width="200" height="130" as="geometry"/></mxCell>
    <mxCell id="u_res" value="&lt;b&gt;资源 / QoR 标注&lt;/b&gt;&lt;div style=&#x27;text-align:left;font-size:11px;font-weight:normal;margin-top:6px;line-height:1.4&#x27;&gt;共享 / 复制、复用范围、staging、存储；&lt;br&gt;需要时可承诺延迟、staging 或资源调度&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="640" y="410" width="450" height="110" as="geometry"/></mxCell>
    <mxCell id="u_obl" value="&lt;b&gt;lowering 义务&lt;/b&gt;&lt;div style=&#x27;text-align:left;font-size:11px;font-weight:normal;margin-top:6px;line-height:1.4&#x27;&gt;接口、状态、调度、资源的承诺必须在 RTL 中保留；&lt;br&gt;局部写法可以不同&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=13;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1110" y="410" width="450" height="110" as="geometry"/></mxCell>
    <mxCell id="ue1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="u_req" target="u_step"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
    <mxCell id="ue2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="u_step" target="u_resp"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
    <mxCell id="ue3" value="读" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.25;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="u_state" target="u_step"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
    <mxCell id="ue4" value="产生" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="u_step" target="u_next"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
    <mxCell id="ue5" value="commit：s_{t+1} 成为下一步的 s_t" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#D79B00;fontSize=10;labelBackgroundColor=#FFFFFF;dashed=1;fontColor=#D79B00;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="u_next" target="u_state"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1215" y="396"/><mxPoint x="985" y="396"/></Array></mxGeometry></mxCell>
    <mxCell id="ue6" value="step 内调用" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.05;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="u_inst" target="u_step"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="740" y="234"/><mxPoint x="902" y="234"/></Array></mxGeometry></mxCell>
    <mxCell id="cf" value="规范形式（canonical form）" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=14;fontColor=#1F2933;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="570" width="560" height="22" as="geometry"/></mxCell>
    <mxCell id="cf_b" value="&lt;b&gt;必须&lt;/b&gt;&lt;div style=&#x27;text-align:left;font-size:11px;font-weight:normal;margin-top:6px;line-height:1.4&#x27;&gt;· 静态有界&lt;br&gt;· 禁止动态分配、递归、无界行为、隐藏副作用&lt;br&gt;· 只保留与架构相关的状态&lt;br&gt;· 不要求唯一标识符或唯一文本写法&lt;br&gt;· 不需要写逐拍信号赋值或 RTL 进程结构&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;fontSize=13;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="20" y="598" width="560" height="150" as="geometry"/></mxCell>
    <mxCell id="ex" value="例：共享 round 的 AES（论文图 1 的文字描述；示意，非原文语法）" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=14;fontColor=#1F2933;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="620" y="570" width="960" height="22" as="geometry"/></mxCell>
    <mxCell id="ex_code" value="unit&amp;nbsp;AesShared&amp;nbsp;{&lt;br&gt;&amp;nbsp;&amp;nbsp;req&amp;nbsp;&amp;nbsp;&amp;nbsp;:&amp;nbsp;AesReq&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;//&amp;nbsp;有类型边界&lt;br&gt;&amp;nbsp;&amp;nbsp;resp&amp;nbsp;&amp;nbsp;:&amp;nbsp;AesResp&lt;br&gt;&amp;nbsp;&amp;nbsp;state&amp;nbsp;:&amp;nbsp;{&amp;nbsp;mode,&amp;nbsp;round_idx&amp;nbsp;}&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;//&amp;nbsp;控制模式&amp;nbsp;+&amp;nbsp;轮计数&amp;nbsp;=&amp;nbsp;有界推进&lt;br&gt;&amp;nbsp;&amp;nbsp;inst&amp;nbsp;round&amp;nbsp;:&amp;nbsp;AesRound&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;//&amp;nbsp;一个数据通路，被所有轮复用&lt;br&gt;&amp;nbsp;&amp;nbsp;step(req)&amp;nbsp;{&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;out&amp;nbsp;&amp;nbsp;=&amp;nbsp;f(state)&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;//&amp;nbsp;输出只读当前状态&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;next&amp;nbsp;=&amp;nbsp;state&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;//&amp;nbsp;默认保持&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;...&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;//&amp;nbsp;按&amp;nbsp;mode&amp;nbsp;推进&amp;nbsp;round_idx&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;commit(next)&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;//&amp;nbsp;边界处提交&lt;br&gt;&amp;nbsp;&amp;nbsp;}&lt;br&gt;}" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fontFamily=Consolas,DejaVu Sans Mono,monospace;fontSize=11;" vertex="1" parent="1"><mxGeometry x="620" y="598" width="960" height="182" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
