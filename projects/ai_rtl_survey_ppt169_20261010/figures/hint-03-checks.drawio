<mxfile host="app.diagrams.net" agent="currygpu-subcore" version="24.7.17" type="device">
  <diagram id="hint03" name="HINT 检查">
    <mxGraphModel dx="1600" dy="670" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="670" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
    <mxCell id="t1" value="HINT ③ 检查：四道关卡 + 冻结后审计；全部在事务层比较" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontColor=#1F2933;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="1560" height="28" as="geometry"/></mxCell>
    <mxCell id="t2" value="来源：HINT, arXiv 2608.07625v2（正文文字）。论文的图 1–3 是图片、HINT 规范未公开，框内名称用论文术语，不是 HINT 语法。" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="38" width="1560" height="20" as="geometry"/></mxCell>
    <mxCell id="g1" value="&lt;b&gt;Lint&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px;font-weight:normal;color:#555555&#x27;&gt;规范形式&lt;/font&gt;&lt;div style=&#x27;text-align:left;font-size:11px;font-weight:normal;margin-top:6px;line-height:1.4&#x27;&gt;· 允许的形式与标签&lt;br&gt;· 有类型的边界与引用&lt;br&gt;· 状态归属与 commit 纪律&lt;br&gt;· 有界推进&lt;br&gt;· 实例 / 资源数量&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="20" y="80" width="300" height="150" as="geometry"/></mxCell>
    <mxCell id="g1d" value="&lt;b&gt;→ conformance&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9673A6;fontSize=13;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="20" y="245" width="300" height="40" as="geometry"/></mxCell>
    <mxCell id="g2" value="&lt;b&gt;HINT vs 参考&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px;font-weight:normal;color:#555555&#x27;&gt;可执行验收&lt;/font&gt;&lt;div style=&#x27;text-align:left;font-size:11px;font-weight:normal;margin-top:6px;line-height:1.4&#x27;&gt;· 同一套冻结测试&lt;br&gt;· 比较输出与边界事件&lt;br&gt;· 粒度：事务&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="350" y="80" width="300" height="150" as="geometry"/></mxCell>
    <mxCell id="g2d" value="&lt;b&gt;→ 事务 / 状态缺陷&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9673A6;fontSize=13;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="350" y="245" width="300" height="40" as="geometry"/></mxCell>
    <mxCell id="ge1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="g1" target="g2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
    <mxCell id="g3" value="&lt;b&gt;HINT vs RTL&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px;font-weight:normal;color:#555555&#x27;&gt;co-sim&lt;/font&gt;&lt;div style=&#x27;text-align:left;font-size:11px;font-weight:normal;margin-top:6px;line-height:1.4&#x27;&gt;· 同一套冻结测试&lt;br&gt;· 比较可观察数据 + 事务时序&lt;br&gt;· 另与参考模型 / 原 RTL 比&lt;br&gt;· 不证明结构等价&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="680" y="80" width="300" height="150" as="geometry"/></mxCell>
    <mxCell id="g3d" value="&lt;b&gt;→ lowering 行为 / 时序错误&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D6B656;fontSize=13;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="680" y="245" width="300" height="40" as="geometry"/></mxCell>
    <mxCell id="ge2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="g2" target="g3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
    <mxCell id="g4" value="&lt;b&gt;综合&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px;font-weight:normal;color:#555555&#x27;&gt;QoR&lt;/font&gt;&lt;div style=&#x27;text-align:left;font-size:11px;font-weight:normal;margin-top:6px;line-height:1.4&#x27;&gt;· 面积、关键路径、ADP&lt;br&gt;· 可回到 Stage 1&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1010" y="80" width="300" height="150" as="geometry"/></mxCell>
    <mxCell id="g4d" value="&lt;b&gt;→ QoR 压力&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82B366;fontSize=13;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1010" y="245" width="300" height="40" as="geometry"/></mxCell>
    <mxCell id="ge3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="g3" target="g4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
    <mxCell id="g5" value="&lt;b&gt;冻结后审计&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px;font-weight:normal;color:#555555&#x27;&gt;非纠正性&lt;/font&gt;&lt;div style=&#x27;text-align:left;font-size:11px;font-weight:normal;margin-top:6px;line-height:1.4&#x27;&gt;源码审计确认 RTL 保留了 HINT 的控制、调度、资源组织&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;fontSize=13;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1340" y="80" width="240" height="150" as="geometry"/></mxCell>
    <mxCell id="ge4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="g4" target="g5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
    <mxCell id="g5d" value="&lt;b&gt;只确认，不再修改&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontSize=13;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1340" y="245" width="240" height="40" as="geometry"/></mxCell>
    <mxCell id="fm" value="形式验证的范围" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#B85450;dashed=1;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontSize=13;fontStyle=1;fontColor=#B85450;" vertex="1" parent="1"><mxGeometry x="20" y="310" width="760" height="150" as="geometry"/></mxCell>
    <mxCell id="fm1" value="· 只有 8 位 Hif8_mul 用 Synopsys Formality 做网表等价（对比工程师 RTL）&lt;br&gt;· 其余设计“超出现有形式工具范围”，用事务级回归 / co-sim&lt;br&gt;· 没有断言（SVA）&lt;br&gt;· Hif8_mul 是试点：HINT 由工程师写，Codex 只做 lowering" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="40" y="340" width="720" height="110" as="geometry"/></mxCell>
    <mxCell id="gr" value="“时序”在 HINT 里指什么" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#1F2933;dashed=1;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontSize=13;fontStyle=1;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="820" y="310" width="760" height="150" as="geometry"/></mxCell>
    <mxCell id="gr1" value="· 每个设计的&lt;b&gt;延迟 / II 目标&lt;/b&gt;：有参考 RTL 时取自它，否则人工固定，三条路线共用&lt;br&gt;· 比较的是事务边界上的数据和事务时序，不是逐拍信号&lt;br&gt;· 作者刻意停在周期级之上：周期精确 SystemC “接近 HINT 有意推迟的实现负担”&lt;br&gt;· 没有 valid/ready、stall、反压的写法" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="840" y="340" width="720" height="110" as="geometry"/></mxCell>
    <mxCell id="ax_t" value="比较粒度：HINT 的所有关卡停在哪一层" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=14;fontColor=#1F2933;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="480" width="1560" height="22" as="geometry"/></mxCell>
    <mxCell id="lv0" value="&lt;b&gt;行为 / 结果&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px;font-weight:normal;color:#555555&#x27;&gt;只看最终输出&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontSize=13;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="20" y="510" width="370" height="70" as="geometry"/></mxCell>
    <mxCell id="lv1" value="&lt;b&gt;事务&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px;font-weight:normal;color:#555555&#x27;&gt;每个请求 / 响应的数据 + 边界事件 + 延迟 / II&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="410" y="510" width="370" height="70" as="geometry"/></mxCell>
    <mxCell id="lve1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="lv0" target="lv1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
    <mxCell id="lv2" value="&lt;b&gt;逐拍契约&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px;font-weight:normal;color:#555555&#x27;&gt;跨事务的拍级约束，例：同 warp 发射间隔 ≥ 2&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontSize=13;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="800" y="510" width="370" height="70" as="geometry"/></mxCell>
    <mxCell id="lve2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="lv1" target="lv2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
    <mxCell id="lv3" value="&lt;b&gt;信号&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px;font-weight:normal;color:#555555&#x27;&gt;每拍每个信号的值&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontSize=13;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1190" y="510" width="370" height="70" as="geometry"/></mxCell>
    <mxCell id="lve3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="lv2" target="lv3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
    <mxCell id="lv_h" value="▲ HINT 的 Stage 1 / Stage 2 验收都在这里" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#9673A6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="410" y="588" width="370" height="20" as="geometry"/></mxCell>
    <mxCell id="lv_o" value="▲ 我们的逐信号波形比对在这里" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#D79B00;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1190" y="588" width="370" height="20" as="geometry"/></mxCell>
    <mxCell id="lv_g" value="▲ 两边都没有显式覆盖" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#B85450;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="800" y="588" width="370" height="20" as="geometry"/></mxCell>
    <mxCell id="n3" value="作者的取舍：可执行 → 在信号级仿真之前，就能用编译器、软件调试器和 oracle 比对在事务层排错；QoR 相关的决定写在 IR 里，不需要外部 QoR 预测器。" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="20" y="620" width="1560" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
