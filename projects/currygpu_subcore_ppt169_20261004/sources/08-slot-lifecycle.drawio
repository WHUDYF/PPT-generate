<mxfile host="app.diagrams.net" agent="currygpu-subcore" version="24.7.17" type="device">
  <diagram id="slot_life" name="slot 生命周期与计数器">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="880" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
    <mxCell id="c1" value="warp slot 生命周期中的 scoreboard 计数器" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontColor=#1F2933;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1000" height="30" as="geometry"/></mxCell>
    <mxCell id="lau" value="① launch&#xa;launch_wslot_mask&#xa;slot_active ← 1 · wslot_gen + 1&#xa;stall / yield / grace 清零&#xa;计数器不清" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="280" height="130" as="geometry"/></mxCell>
    <mxCell id="iss" value="② issue 带 barrier&#xa;counter[slot][sb] + 1&#xa;同拍同 sb 最多 +1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;" vertex="1" parent="1"><mxGeometry x="400" y="120" width="280" height="110" as="geometry"/></mxCell>
    <mxCell id="busy" value="③ busy&#xa;busy_q = 1&#xa;wait_mask 命中 → 阻塞消费者&#xa;counter == cap(256) → sb_saturated" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;" vertex="1" parent="1"><mxGeometry x="760" y="120" width="300" height="110" as="geometry"/></mxCell>
    <mxCell id="cmp" value="④ 完成事件到达（t）&#xa;lane_accept 且 gen 匹配&#xa;counter − 1（t+1）" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1140" y="120" width="300" height="110" as="geometry"/></mxCell>
    <mxCell id="drn" value="⑤ drained&#xa;counter = 0 → busy = 0&#xa;wait_mask_clear → eligible 可变高" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1140" y="320" width="300" height="100" as="geometry"/></mxCell>
    <mxCell id="ext" value="⑥ EXIT issue&#xa;必须 drained&#xa;否则 exit_drain_violation" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;" vertex="1" parent="1"><mxGeometry x="760" y="320" width="300" height="100" as="geometry"/></mxCell>
    <mxCell id="ret" value="⑦ retire&#xa;retire_valid&#xa;slot_active ← 0&#xa;计数器不清" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;" vertex="1" parent="1"><mxGeometry x="400" y="320" width="280" height="110" as="geometry"/></mxCell>
    <mxCell id="stale" value="slot 重用后的迟到事件&#xa;gen 不同 → 过滤并置 gen_mismatch&#xa;gen 相同（2 bit 回绕，重用 4 次）→ 误减" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=13;" vertex="1" parent="1"><mxGeometry x="760" y="560" width="520" height="110" as="geometry"/></mxCell>
    <mxCell id="o2" value="计数器不由 launch / retire 清除，&#xa;只靠 EXIT 前 drained 保证归零。&#xa;非 EXIT 退休（trap / kill）后是否残留：待核实（O2）" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="700" width="340" height="110" as="geometry"/></mxCell>
    <mxCell id="c2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="lau" target="iss"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
    <mxCell id="c3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="iss" target="busy"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
    <mxCell id="c4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="busy" target="cmp"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
    <mxCell id="c5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="cmp" target="drn"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
    <mxCell id="c6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="drn" target="ext"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
    <mxCell id="c7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ext" target="ret"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
    <mxCell id="c8" value="再次 launch" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.25;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="ret" target="lau"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="110" y="375"/></Array></mxGeometry></mxCell>
    <mxCell id="c9" value="gen + 1 使旧事件失效" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#B85450;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="lau" target="stale"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="250" y="615"/></Array></mxGeometry></mxCell>
    <mxCell id="c10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#B85450;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="stale" target="cmp"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1500" y="615"/><mxPoint x="1500" y="175"/></Array></mxGeometry></mxCell>
    <mxCell id="c11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ret" target="o2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="540" y="755"/></Array></mxGeometry></mxCell>
    <mxCell id="c12" value="图例：紫=控制  蓝=数据通路  黄=存储  橙=completion  红=待核实" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="40" y="830" width="1000" height="24" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
