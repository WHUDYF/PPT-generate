    <mxCell id="t1" value="Warp slot 生命周期：计数器怎么变" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontColor=#1F2933;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="900" height="28" as="geometry"/></mxCell>
    <mxCell id="p0" value="Launch&lt;br&gt;&lt;font style='font-size:10px;font-weight:normal;color:#555555'&gt;slot active&lt;br&gt;generation +1&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="100" width="215" height="100" as="geometry"/></mxCell>
