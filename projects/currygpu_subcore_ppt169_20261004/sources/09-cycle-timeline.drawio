    <mxCell id="c169" value="第二行：只有 w3 可发时隔拍发射。发射沿清掉 head valid，decode 下一拍才补上 head，再下一拍调度器才看到。常量未命中保持的逻辑存在，但 head_const_tag_hit 恒为 1，不会触发。" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="880" y="850" width="780" height="40" as="geometry"/></mxCell>
    <mxCell id="c170" value="D · VALU 完成拍（L = launch 拍）" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9AA5B1;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=15;fontStyle=1;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="20" y="960" width="820" height="280" as="geometry"/></mxCell>
