<mxfile host="app.diagrams.net" agent="currygpu-subcore" version="24.7.17" type="device">
  <diagram id="s1s2" name="S1 S2 Issue">
    <mxGraphModel dx="1600" dy="1064" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1064" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
    <mxCell id="t1" value="S1 · subcore_decode + S2 · subcore_issue：当前目标方案" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontColor=#1F2933;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="1560" height="28" as="geometry"/></mxCell>
    <mxCell id="t2" value="2026-10-08 讨论定稿，未实现。依据 curryGPU 本地 document/2026-10-05-subcore-rtl-structure-spec.md（§1、§3、§11 第 5、7 条）与 2026-10-08-s2cd-plan.md。拍数按规范推算，未用波形确认。" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="38" width="1560" height="20" as="geometry"/></mxCell>
    <mxCell id="ib" value="&lt;b&gt;IB&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px;font-weight:normal;color:#555555&#x27;&gt;S0 拥有 · S0 → S1 边界&lt;/font&gt;&lt;div style=&#x27;text-align:left;font-size:11px;font-weight:normal;margin-top:6px;line-height:1.4&#x27;&gt;每 warp 8 项 FIFO&lt;br&gt;vld = count ≠ 0&lt;br&gt;S1 只取队头并弹出&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="20" y="150" width="140" height="170" as="geometry"/></mxCell>
    <mxCell id="f1" value="S1 · subcore_decode" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#82B366;dashed=1;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontSize=13;fontStyle=1;fontColor=#82B366;" vertex="1" parent="1"><mxGeometry x="190" y="95" width="330" height="255" as="geometry"/></mxCell>
    <mxCell id="s1" value="&lt;b&gt;s0 · 补 head&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px;font-weight:normal;color:#555555&#x27;&gt;vld_s0 = refill_grant · 一拍组合（同现状）&lt;/font&gt;&lt;div style=&#x27;text-align:left;font-size:11px;font-weight:normal;margin-top:6px;line-height:1.4&#x27;&gt;&lt;b&gt;补充条件&lt;/b&gt;：IB 有指令 &amp;amp; head FIFO 有空位&lt;br&gt;&amp;nbsp;&amp;nbsp;credit：现有项数 + 未处理 consumed ≤ 2&lt;br&gt;&lt;b&gt;选 warp&lt;/b&gt;：round robin&lt;br&gt;&lt;b&gt;读 IB 队头 → 译码 + 预译码&lt;/b&gt;：&lt;br&gt;&amp;nbsp;&amp;nbsp;源寄存器 · 写目标（B0/B1/P）&lt;br&gt;&amp;nbsp;&amp;nbsp;写回 offset · hold 种类&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="205" y="150" width="300" height="170" as="geometry"/></mxCell>
    <mxCell id="hreg" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F2933;strokeColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="538" y="140" width="8" height="190" as="geometry"/></mxCell>
    <mxCell id="hregl" value="&lt;b&gt;head FIFO[w] ×16 · 每 warp 2 项&lt;/b&gt;&lt;br&gt;= S1/S2 级间寄存器（触发器）&lt;br&gt;每项 255 位，共 32 项 ≈ 1 KB&lt;br&gt;S2 只看第 0 项；发射沿弹出" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="405" y="358" width="195" height="72" as="geometry"/></mxCell>
    <mxCell id="f2" value="S2 · subcore_issue · 单拍环（无内部流水）" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9673A6;dashed=1;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontSize=13;fontStyle=1;fontColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="605" y="95" width="690" height="455" as="geometry"/></mxCell>
    <mxCell id="el" value="&lt;b&gt;① eligible ×16&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px;font-weight:normal;color:#555555&#x27;&gt;每 warp 并行，只读寄存器&lt;/font&gt;&lt;div style=&#x27;text-align:left;font-size:11px;font-weight:normal;margin-top:6px;line-height:1.4&#x27;&gt;lifecycle = RUN&lt;br&gt;&amp;amp; hold 行全 0 &amp;amp; head 有效&lt;br&gt;&amp;amp; stall = 0 &amp;amp; wait mask 已清&lt;br&gt;&amp;amp; SB 余量 &amp;amp; depbar_ok&lt;br&gt;&amp;amp; credit_ok &amp;amp; its_available&lt;br&gt;&amp;amp; grid_dep_ok&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="620" y="150" width="215" height="170" as="geometry"/></mxCell>
    <mxCell id="b1" value="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1F2933;strokeColor=#1F2933;fontColor=#FFFFFF;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="628" y="158" width="24" height="24" as="geometry"/></mxCell>
    <mxCell id="pk" value="&lt;b&gt;② pick warp&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px;font-weight:normal;color:#555555&#x27;&gt;sched_cggty_select&lt;/font&gt;&lt;div style=&#x27;text-align:left;font-size:11px;font-weight:normal;margin-top:6px;line-height:1.4&#x27;&gt;优先级只编码一次：&lt;br&gt;sel_case = HOLD / SWITCH /&lt;br&gt;&amp;nbsp;&amp;nbsp;STICKY / OLDEST / NONE&lt;br&gt;依据 age · last_issued · yield&lt;br&gt;最外层：stop_issue 总开关&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="855" y="150" width="200" height="170" as="geometry"/></mxCell>
    <mxCell id="b2" value="2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1F2933;strokeColor=#1F2933;fontColor=#FFFFFF;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="863" y="158" width="24" height="24" as="geometry"/></mxCell>
    <mxCell id="is" value="&lt;b&gt;③ issue&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px;font-weight:normal;color:#555555&#x27;&gt;每拍最多 1 条&lt;/font&gt;&lt;div style=&#x27;text-align:left;font-size:11px;font-weight:normal;margin-top:6px;line-height:1.4&#x27;&gt;issue_valid =&lt;br&gt;&amp;nbsp;&amp;nbsp;选中 &amp;amp; credit_ok &amp;amp; rdy_s3&lt;br&gt;&lt;br&gt;&lt;b&gt;不查&lt;/b&gt;读口 · 写口 · 写回窗口&lt;br&gt;（全部移到 S4 allocate）&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1075" y="150" width="205" height="170" as="geometry"/></mxCell>
    <mxCell id="b3" value="3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1F2933;strokeColor=#1F2933;fontColor=#FFFFFF;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1083" y="158" width="24" height="24" as="geometry"/></mxCell>
    <mxCell id="st_life" value="&lt;b&gt;生命周期 · hold 表&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px;font-weight:normal;color:#555555&#x27;&gt;每 warp 一份&lt;/font&gt;&lt;div style=&#x27;text-align:left;font-size:11px;font-weight:normal;margin-top:6px;line-height:1.4&#x27;&gt;IDLE → INIT →&lt;br&gt;RUN → DRAIN&lt;br&gt;hold：BRANCH · MEMBAR&lt;br&gt;· SETMAXREG · CCTL&lt;br&gt;· ERRBAR&lt;br&gt;发射置位 · 事件清除&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="620" y="385" width="160" height="150" as="geometry"/></mxCell>
    <mxCell id="st_sb" value="&lt;b&gt;stall · scoreboard · credit&lt;/b&gt;&lt;div style=&#x27;text-align:left;font-size:11px;font-weight:normal;margin-top:6px;line-height:1.4&#x27;&gt;stall：发射时载入&lt;br&gt;SB 计数器 ×6 / warp：&lt;br&gt;&amp;nbsp;&amp;nbsp;发射 +1，ev_complete −1&lt;br&gt;变长队列 credit：&lt;br&gt;&amp;nbsp;&amp;nbsp;发射 −1，归还 +1&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="790" y="385" width="160" height="150" as="geometry"/></mxCell>
    <mxCell id="st_age" value="&lt;b&gt;age · last_issued · yield&lt;/b&gt;&lt;div style=&#x27;text-align:left;font-size:11px;font-weight:normal;margin-top:6px;line-height:1.4&#x27;&gt;age 矩阵&lt;br&gt;上次发射的 warp&lt;br&gt;YIELD 只改优先级&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="960" y="385" width="145" height="150" as="geometry"/></mxCell>
    <mxCell id="st_its" value="&lt;b&gt;ITS 状态 + 分支 FSM&lt;/b&gt;&lt;div style=&#x27;text-align:left;font-size:11px;font-weight:normal;margin-top:6px;line-height:1.4&#x27;&gt;lane PC · lane 状态&lt;br&gt;splinter · selected_pc · BX&lt;br&gt;分支 / CONV FSM：&lt;br&gt;&amp;nbsp;&amp;nbsp;整个 subcore 一个（维持现状）&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1115" y="385" width="165" height="150" as="geometry"/></mxCell>
    <mxCell id="r23" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F2933;strokeColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="1318" y="140" width="8" height="190" as="geometry"/></mxCell>
    <mxCell id="r23l" value="S2/S3 reg（新增）&lt;br&gt;issue_valid · warp 号&lt;br&gt;· 已寄存 ITS 状态" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="1300" y="332" width="140" height="44" as="geometry"/></mxCell>
    <mxCell id="s3" value="&lt;b&gt;S3 · subcore_dispatch&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px;font-weight:normal;color:#555555&#x27;&gt;下一大级&lt;/font&gt;&lt;div style=&#x27;text-align:left;font-size:11px;font-weight:normal;margin-top:6px;line-height:1.4&#x27;&gt;payload 译码&lt;br&gt;读 S2 寄存的 ITS 状态取 lane mask&lt;br&gt;按延迟分流：&lt;br&gt;&amp;nbsp;&amp;nbsp;固定 → S4 · 变长 → 单元队列&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;fontSize=13;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1350" y="150" width="230" height="170" as="geometry"/></mxCell>
    <mxCell id="sw" value="&lt;b&gt;S5 执行 / SW 写回&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px;font-weight:normal;color:#555555&#x27;&gt;后级（寄存后送出）&lt;/font&gt;&lt;div style=&#x27;text-align:left;font-size:11px;font-weight:normal;margin-top:6px;line-height:1.4&#x27;&gt;ev_complete：warp · SB 号 · 减量&lt;br&gt;ev_credit_return：队列号&lt;br&gt;各操作的完成事件（清 hold）&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;fontSize=13;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1350" y="600" width="230" height="110" as="geometry"/></mxCell>
