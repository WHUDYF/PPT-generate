    <mxCell id="tt" value="逐拍例子：warp 3 连发 A、B、C（stall 都为 1）：2 项 head FIFO，同一 warp 每拍发 1 条，与性能模型 max(1, stall) 一致" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontColor=#1F2933;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="770" width="1500" height="24" as="geometry"/></mxCell>
