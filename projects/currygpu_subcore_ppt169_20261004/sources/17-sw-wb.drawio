    <mxCell id="vp_3_1" value="pair 低 / 高字（变长 VALU 序列）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="92" y="374" width="328" height="26" as="geometry"/></mxCell>
