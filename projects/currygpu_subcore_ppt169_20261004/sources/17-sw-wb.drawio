    <mxCell id="vp_0_1" value="来源" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="92" y="296" width="328" height="26" as="geometry"/></mxCell>
