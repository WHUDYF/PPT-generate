    <mxCell id="vp_7_0" value="7" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#999999;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="32" y="478" width="60" height="26" as="geometry"/></mxCell>
    <mxCell id="vp_7_1" value="ldc · uimad（UIMAD.WIDE 改为固定后不再用）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="92" y="478" width="328" height="26" as="geometry"/></mxCell>
