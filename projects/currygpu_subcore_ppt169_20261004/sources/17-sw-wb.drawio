    <mxCell id="vp_2_1" value="xlane" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="92" y="348" width="328" height="26" as="geometry"/></mxCell>
