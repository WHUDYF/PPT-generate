    <mxCell id="t1" value="SW · subcore_wb：固定延迟按预约拍直接写，变长只用没被预约的写口" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontColor=#1F2933;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="1560" height="28" as="geometry"/></mxCell>
    <mxCell id="t2" value="目标结构，未实现。依据 curryGPU 本地 document/2026-10-09-subcore-target-design-v1.md §6 与规范 §11 第 19、22 条。结构复用原版 exec_wb_arb；拍数读代码推出，未用波形确认。" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="38" width="1560" height="20" as="geometry"/></mxCell>
    <mxCell id="fx" value="&lt;b&gt;固定延迟结果（已预约）&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px;font-weight:normal;color:#555555&#x27;&gt;S5 最后一级的 result reg&lt;/font&gt;&lt;div style=&#x27;text-align:left;font-size:11px;font-weight:normal;margin-top:6px;line-height:1.4&#x27;&gt;VALU：wb、wb2 两路；SALU：URF、UP&lt;br&gt;在 allocate 预约好的那一拍直接写入对应写口，&lt;br&gt;不经过仲裁，不设结果队列&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="20" y="100" width="400" height="130" as="geometry"/></mxCell>
    <mxCell id="vr" value="&lt;b&gt;变长结果&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px;font-weight:normal;color:#555555&#x27;&gt;变长写口编号沿用原版&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="20" y="250" width="400" height="340" as="geometry"/></mxCell>
