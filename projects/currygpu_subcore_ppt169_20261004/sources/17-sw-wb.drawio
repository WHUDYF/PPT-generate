  <diagram id="sw" name="SW Writeback">
    <mxGraphModel dx="1600" dy="846" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="846" math="0" shadow="0">
