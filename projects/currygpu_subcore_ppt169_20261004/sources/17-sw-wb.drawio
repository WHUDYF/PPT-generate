    <mxCell id="vp_6_0" value="6" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#999999;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="32" y="452" width="60" height="26" as="geometry"/></mxCell>
