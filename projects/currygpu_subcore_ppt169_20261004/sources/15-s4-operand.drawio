    <mxCell id="tl_1_10" value="s5 · 同拍&lt;br&gt;写 B0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1427" y="722" width="143" height="42" as="geometry"/></mxCell>
