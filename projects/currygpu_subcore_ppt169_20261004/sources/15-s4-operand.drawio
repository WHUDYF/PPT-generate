    <mxCell id="tn" value="都是移位寄存器：第 k 位 = k 拍后已被占，左 = 本拍，每拍整体前移一格；表长 16" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="660" y="152" width="318" height="40" as="geometry"/></mxCell>
