    <mxCell id="tb4c_13" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontSize=9;" vertex="1" parent="1"><mxGeometry x="907" y="490" width="19" height="18" as="geometry"/></mxCell>
    <mxCell id="tb4c_14" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontSize=9;" vertex="1" parent="1"><mxGeometry x="926" y="490" width="19" height="18" as="geometry"/></mxCell>
