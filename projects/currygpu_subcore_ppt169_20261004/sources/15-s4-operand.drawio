    <mxCell id="oreg" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F2933;strokeColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="1010" y="100" width="8" height="140" as="geometry"/></mxCell>
    <mxCell id="oregl" value="operand reg" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="990" y="76" width="80" height="20" as="geometry"/></mxCell>
    <mxCell id="s5" value="&lt;b&gt;S5 · 固定延迟单元（VALU · SALU）&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px;font-weight:normal;color:#555555&#x27;&gt;在 e 拍启动，下一页&lt;/font&gt;&lt;div style=&#x27;text-align:left;font-size:11px;font-weight:normal;margin-top:6px;line-height:1.4&#x27;&gt;操作数、lane mask、写回偏移已定&lt;br&gt;过了 allocate，启动拍、完成拍、写回拍都固定：&lt;br&gt;读冲突不会推迟写回，固定延迟结果不会积压&lt;br&gt;stall 一直有效，不需要结果队列、不需要额外的依赖保护&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;fontSize=13;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1030" y="100" width="550" height="140" as="geometry"/></mxCell>
    <mxCell id="vf" value="&lt;b&gt;变长前门 → 读口请求&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px;font-weight:normal;color:#555555&#x27;&gt;访存 · SFU/XLANE · CBU · 控制 · TQ · async · tensor_gpr_req 读代理&lt;/font&gt;&lt;div style=&#x27;text-align:left;font-size:11px;font-weight:normal;margin-top:6px;line-height:1.4&#x27;&gt;&lt;b&gt;申请方式&lt;/b&gt;：在队头每次申请下一拍（第 1 位）的一个读口；同 bank 的多次读分多拍申请，读回的数据先存在前门自己的操作数缓冲，凑齐后命令寄存送出&lt;br&gt;&lt;b&gt;同一拍的优先级&lt;/b&gt;：allocate 先占位；变长请求只看没被占的读口；多个变长之间轮询&lt;br&gt;&lt;b&gt;防饿死&lt;/b&gt;：某 bank 的变长请求连续等满 N 拍（v1 取 N = 8）就挂保留标记，allocate 把该 bank 的第 1 位当作已占&lt;br&gt;&lt;b&gt;uniform、谓词读口&lt;/b&gt;：v1 不建预约表，固定延迟优先，变长只在空闲拍读&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1030" y="270" width="550" height="220" as="geometry"/></mxCell>
    <mxCell id="nv" value="&lt;b&gt;对 S2 不再有 rd_busy&lt;/b&gt;&lt;div style=&#x27;text-align:left;font-size:11px;font-weight:normal;margin-top:6px;line-height:1.4&#x27;&gt;变长单元读不到口，只会停在自己前门的队头；前门队列满了由 credit 挡住 S2。&lt;br&gt;原版 u_issue_rd_arb 只在没有发射的空闲拍给读口，无防饿死，读期间还组合反压 S2&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;fontSize=13;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1030" y="510" width="550" height="94" as="geometry"/></mxCell>
    <mxCell id="e_in" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="in" target="al"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
