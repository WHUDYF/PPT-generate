<mxfile host="app.diagrams.net" agent="currygpu-subcore" version="24.7.17" type="device">
  <diagram id="s4" name="S4 Operand">
    <mxGraphModel dx="1600" dy="906" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="906" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
    <mxCell id="t1" value="S4 · subcore_operand：allocate 一次预约，之后读、启动、写回的拍数全部固定" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontColor=#1F2933;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="1560" height="28" as="geometry"/></mxCell>
    <mxCell id="t2" value="目标结构，未实现。依据 curryGPU 本地 document/2026-10-09-subcore-target-design-v1.md §4 与规范 §11 第 13、15、17、18、19、20、22 条。表长 16 是 v1 补的取值，拍数读代码推出，未用波形确认。" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="38" width="1560" height="20" as="geometry"/></mxCell>
    <mxCell id="dreg" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F2933;strokeColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="20" y="100" width="8" height="400" as="geometry"/></mxCell>
    <mxCell id="dregl" value="dispatch reg" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="0" y="76" width="80" height="20" as="geometry"/></mxCell>
    <mxCell id="in" value="&lt;b&gt;S3 来的指令&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px;font-weight:normal;color:#555555&#x27;&gt;固定延迟 + 变长 VALU 序列&lt;/font&gt;&lt;div style=&#x27;text-align:left;font-size:11px;font-weight:normal;margin-top:6px;line-height:1.4&#x27;&gt;已寄存：&lt;br&gt;warp 号&lt;br&gt;源寄存器 · 写口&lt;br&gt;tap · rounds 所需信息&lt;br&gt;lane mask&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;fontSize=13;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="150" height="200" as="geometry"/></mxCell>
    <mxCell id="f4" value="S4 · subcore_operand · allocate 1 拍 + 读 rounds 拍（rounds = 0 … 3）" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#D6B656;dashed=1;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontSize=13;fontStyle=1;fontColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="210" y="90" width="790" height="530" as="geometry"/></mxCell>
    <mxCell id="al" value="&lt;b&gt;① allocate · 每拍最多放行 1 条&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px;font-weight:normal;color:#555555&#x27;&gt;查表，不通过就停在这里&lt;/font&gt;&lt;div style=&#x27;text-align:left;font-size:11px;font-weight:normal;margin-top:6px;line-height:1.4&#x27;&gt;&lt;b&gt;1&lt;/b&gt;　读级入口这一拍空闲&lt;br&gt;&lt;b&gt;2&lt;/b&gt;　&lt;b&gt;读口表&lt;/b&gt;：读窗口内要读的格，每个 bank 剩余读口够&lt;br&gt;&lt;b&gt;3&lt;/b&gt;　&lt;b&gt;写回拍表&lt;/b&gt;：要写的每个写口，在 a + rounds + tap 这一格为空&lt;br&gt;&lt;b&gt;4&lt;/b&gt;　&lt;b&gt;VALU 出口计数&lt;/b&gt; &amp;lt; 2 · &lt;b&gt;入口拍表&lt;/b&gt;：a + 1 + rounds 这一格为空&lt;br&gt;&lt;br&gt;全部通过：同拍置位，放行　·　否则：拉低 ena_s4_0，下一拍重试&lt;br&gt;不通过时 stall 计数全局冻结（v1 先保守，§11 第 15 条）&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="230" y="130" width="400" height="250" as="geometry"/></mxCell>
    <mxCell id="b1" value="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1F2933;strokeColor=#1F2933;fontColor=#FFFFFF;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="238" y="136" width="24" height="24" as="geometry"/></mxCell>
    <mxCell id="rd" value="&lt;b&gt;② 读窗口与 RF 读&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px;font-weight:normal;color:#555555&#x27;&gt;rounds = 各 bank 读次数的最大值（去掉 reuse 命中和重复寄存器）&lt;/font&gt;&lt;div style=&#x27;text-align:left;font-size:11px;font-weight:normal;margin-top:6px;line-height:1.4&#x27;&gt;读地址在 a + 1 … a + rounds 发出；执行在 e = a + 1 + rounds 启动&lt;br&gt;uniform 源按编译器的 uniform_rounds 计入&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="230" y="400" width="400" height="100" as="geometry"/></mxCell>
    <mxCell id="b2" value="2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1F2933;strokeColor=#1F2933;fontColor=#FFFFFF;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="238" y="406" width="24" height="24" as="geometry"/></mxCell>
    <mxCell id="ru" value="&lt;b&gt;③ reuse cache（保留原版）&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px;font-weight:normal;color:#555555&#x27;&gt;3 单元 × 4 lane × 2 项&lt;/font&gt;&lt;div style=&#x27;text-align:left;font-size:11px;font-weight:normal;margin-top:6px;line-height:1.4&#x27;&gt;标签在 allocate 按序更新，数据在读完后填入&lt;br&gt;按目标寄存器、写口 snoop 两种方式作废&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="230" y="520" width="400" height="84" as="geometry"/></mxCell>
    <mxCell id="b3" value="3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1F2933;strokeColor=#1F2933;fontColor=#FFFFFF;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="238" y="526" width="24" height="24" as="geometry"/></mxCell>
