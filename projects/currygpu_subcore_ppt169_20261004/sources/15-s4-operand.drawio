    <mxCell id="e_vf" value="申请第 1 位" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#9673A6;fontSize=10;labelBackgroundColor=#FFFFFF;dashed=1;fontColor=#6B4F7A;exitX=0;exitY=0.15;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="vf" target="tb1"><mxGeometry x="-0.3" relative="1" as="geometry"><Array as="points"><mxPoint x="1005" y="303"/><mxPoint x="1005" y="233"/></Array></mxGeometry></mxCell>
