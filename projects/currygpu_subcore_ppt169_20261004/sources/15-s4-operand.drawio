    <mxCell id="e_rd_ru" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="rd" target="ru"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
    <mxCell id="e_al_tb" value="查 / 置位" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#6C8EBF;fontSize=10;labelBackgroundColor=#FFFFFF;dashed=1;fontColor=#3B5E8C;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="1" source="al" target="tb1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
