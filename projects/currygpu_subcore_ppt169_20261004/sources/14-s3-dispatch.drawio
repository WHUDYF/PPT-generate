    <mxCell id="s4" value="&lt;b&gt;S4 · subcore_operand&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px;font-weight:normal;color:#555555&#x27;&gt;下一页&lt;/font&gt;&lt;div style=&#x27;text-align:left;font-size:11px;font-weight:normal;margin-top:6px;line-height:1.4&#x27;&gt;allocate 查表预约 → 读 RF（1–3 拍）&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;fontSize=13;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1262" y="100" width="318" height="120" as="geometry"/></mxCell>
