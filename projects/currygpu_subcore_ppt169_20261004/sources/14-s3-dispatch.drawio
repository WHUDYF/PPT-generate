    <mxCell id="t1" value="S3 · subcore_dispatch：一拍完成译码、取 lane mask、分流；变长指令推进级间队列" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontColor=#1F2933;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="1560" height="28" as="geometry"/></mxCell>
    <mxCell id="t2" value="目标结构，未实现。依据 curryGPU 本地 document/2026-10-09-subcore-target-design-v1.md §2、§3 与规范 §11 第 16、23、24 条。拍数读代码推出，未用波形确认。" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="38" width="1560" height="20" as="geometry"/></mxCell>
    <mxCell id="s1f" value="&lt;b&gt;S1 · head FIFO[w]&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px;font-weight:normal;color:#555555&#x27;&gt;每 warp 2 项 · 触发器&lt;/font&gt;&lt;div style=&#x27;text-align:left;font-size:11px;font-weight:normal;margin-top:6px;line-height:1.4&#x27;&gt;完整指令（255 位）&lt;br&gt;S1 按寄存的 warp 号，在 t+1 取出&lt;br&gt;刚发射的那一项，同拍弹出&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="20" y="100" width="210" height="120" as="geometry"/></mxCell>
    <mxCell id="r23" value="&lt;b&gt;S2/S3 reg&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px;font-weight:normal;color:#555555&#x27;&gt;S2 发射拍寄存&lt;/font&gt;&lt;div style=&#x27;text-align:left;font-size:11px;font-weight:normal;margin-top:6px;line-height:1.4&#x27;&gt;issue_valid&lt;br&gt;warp 号&lt;br&gt;S3 要用的 ITS 状态&lt;br&gt;（不含指令）&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="20" y="250" width="210" height="120" as="geometry"/></mxCell>
    <mxCell id="s2c" value="&lt;b&gt;S2 · credit 池&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px;font-weight:normal;color:#555555&#x27;&gt;发射时扣，前门归还时加&lt;/font&gt;&lt;div style=&#x27;text-align:left;font-size:11px;font-weight:normal;margin-top:6px;line-height:1.4&#x27;&gt;LSU 8 · AGU 2 · SFU/XLANE 18&lt;br&gt;CBU 1 · 控制 1 · TQ 8 · async 2&lt;br&gt;FP64 5 · valu_var 2&lt;br&gt;每个池 = 对应队列深度&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="20" y="470" width="210" height="130" as="geometry"/></mxCell>
    <mxCell id="f3" value="S3 · subcore_dispatch · 1 拍（三步同拍组合完成）" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9673A6;dashed=1;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontSize=13;fontStyle=1;fontColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="260" y="90" width="580" height="350" as="geometry"/></mxCell>
    <mxCell id="c1" value="&lt;b&gt;① payload 译码&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px;font-weight:normal;color:#555555&#x27;&gt;原 exec_dispatch 的译码部分&lt;/font&gt;&lt;div style=&#x27;text-align:left;font-size:11px;font-weight:normal;margin-top:6px;line-height:1.4&#x27;&gt;操作数选择 · 目标单元 · 写哪几个写口&lt;br&gt;其中 tap、写口、是否固定延迟由 S1 预译码给出，这里只取用&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="280" y="130" width="540" height="88" as="geometry"/></mxCell>
    <mxCell id="b1" value="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1F2933;strokeColor=#1F2933;fontColor=#FFFFFF;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="288" y="136" width="24" height="24" as="geometry"/></mxCell>
    <mxCell id="c2" value="&lt;b&gt;② 取 lane mask&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px;font-weight:normal;color:#555555&#x27;&gt;读 S2 寄存的 ITS 状态&lt;/font&gt;&lt;div style=&#x27;text-align:left;font-size:11px;font-weight:normal;margin-top:6px;line-height:1.4&#x27;&gt;选出当前发射组的 lane mask（原 its_top 的 channel 过滤）&lt;br&gt;计算，不更新状态：下一拍选择用不到，所以出环&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="280" y="238" width="540" height="88" as="geometry"/></mxCell>
    <mxCell id="b2" value="2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1F2933;strokeColor=#1F2933;fontColor=#FFFFFF;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="288" y="244" width="24" height="24" as="geometry"/></mxCell>
    <mxCell id="c3" value="&lt;b&gt;③ 分流 route&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px;font-weight:normal;color:#555555&#x27;&gt;按 S1 预译码的分类&lt;/font&gt;&lt;div style=&#x27;text-align:left;font-size:11px;font-weight:normal;margin-top:6px;line-height:1.4&#x27;&gt;固定延迟（含变长 VALU 序列）→ dispatch reg　·　其余变长 → 各自的级间队列&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="280" y="346" width="540" height="76" as="geometry"/></mxCell>
    <mxCell id="b3" value="3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1F2933;strokeColor=#1F2933;fontColor=#FFFFFF;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="288" y="352" width="24" height="24" as="geometry"/></mxCell>
    <mxCell id="fx" value="&lt;b&gt;固定延迟路径&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px;font-weight:normal;color:#555555&#x27;&gt;含变长 VALU 序列&lt;/font&gt;&lt;div style=&#x27;text-align:left;font-size:11px;font-weight:normal;margin-top:6px;line-height:1.4&#x27;&gt;写 dispatch reg，下一拍进 S4 allocate&lt;br&gt;rdy_s3 = ena_s4_0&lt;br&gt;变长 VALU 序列只预约读口，&lt;br&gt;不预约写回拍（credit：valu_var 2、fp64 5）&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="880" y="100" width="310" height="120" as="geometry"/></mxCell>
    <mxCell id="dreg" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F2933;strokeColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="1222" y="100" width="8" height="120" as="geometry"/></mxCell>
