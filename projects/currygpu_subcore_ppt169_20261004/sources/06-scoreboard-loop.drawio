    <mxCell id="c17" value="固定延迟依赖靠 stall_count_q（issue 载入、每拍减 1），不经过 scoreboard。只有带 barrier 的变长完成指令才产生计数器流量。" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="340" y="975" width="1100" height="24" as="geometry"/></mxCell>
