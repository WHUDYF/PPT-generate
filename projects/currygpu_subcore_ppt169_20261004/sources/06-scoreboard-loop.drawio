<mxfile host="app.diagrams.net" agent="currygpu-subcore" version="24.7.17" type="device">
  <diagram id="sb_loop" name="scoreboard 依赖环">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1060" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
    <mxCell id="c1" value="scoreboard 依赖环：issue 占用 → 计数器 → eligible → issue；completion 释放" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontColor=#1F2933;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1400" height="30" as="geometry"/></mxCell>
    <mxCell id="alloc" value="sched_allocate&#xa;sel_ctrl → issue_sb_wr [12-:3]&#xa;issue_sb_rd [15-:3]" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="120" width="240" height="100" as="geometry"/></mxCell>
    <mxCell id="gate" value="scoreboard_issue_valid&#xa;= issue_valid&#xa;&amp;&amp; (!sel_is_direct&#xa;|| direct_issue_produces_completion)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="290" width="240" height="110" as="geometry"/></mxCell>
    <mxCell id="pnl" value="sched_top" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9AA5B1;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=16;fontStyle=1;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="290" y="60" width="1200" height="950" as="geometry"/></mxCell>
    <mxCell id="pnl2" value="sched_sbx_scoreboard" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9AA5B1;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=16;fontStyle=1;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="330" y="100" width="640" height="400" as="geometry"/></mxCell>
    <mxCell id="inc" value="issue 增量 increment&#xa;同 slot 同 sb：写 id 与读 id 相同时&#xa;同拍只 +1（布尔，不是 +2）" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;" vertex="1" parent="1"><mxGeometry x="350" y="150" width="260" height="100" as="geometry"/></mxCell>
    <mxCell id="genf" value="gen 过滤&#xa;lane_gen == wslot_gen[slot]&#xa;不等 → gen_mismatch，不减" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=13;" vertex="1" parent="1"><mxGeometry x="680" y="150" width="260" height="100" as="geometry"/></mxCell>
    <mxCell id="cnt" value="counter_q [12 slot × 6 sb × 9 bit]&#xa;busy_q [12 × 6]" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="350" y="330" width="240" height="100" as="geometry"/></mxCell>
    <mxCell id="upd" value="counter_d 组合更新&#xa;updated = counter + inc − dec&#xa;== cap(256) 丢弃 +1 → overcommit&#xa;&lt; 0 钳 0 → underflow" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;" vertex="1" parent="1"><mxGeometry x="680" y="320" width="260" height="120" as="geometry"/></mxCell>
    <mxCell id="ld" value="sched_completion_event_lane_decode&#xa;lane_accept = in_subcore &amp;&amp; key_ok&#xa;&amp;&amp; sb&lt;6 &amp;&amp; delta &amp;&amp; wslot&lt;12&#xa;（纯组合，不检查 gen）" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1000" y="150" width="330" height="120" as="geometry"/></mxCell>
    <mxCell id="wg" value="sched_warp_ctrl&#xa;wslot_gen_q[12]&#xa;launch → +1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1000" y="330" width="330" height="100" as="geometry"/></mxCell>
    <mxCell id="flags" value="overcommit_o · underflow_o&#xa;gen_mismatch_o&#xa;→ trap_scoreboard_* / trap_wslot_gen_mismatch_o" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1000" y="520" width="330" height="110" as="geometry"/></mxCell>
    <mxCell id="cond" value="sched_warp_ctrl 的 scoreboard 条件&#xa;wait_mask_clear = (wait_mask &amp; busy) == 0&#xa;barrier_headroom = !sb_full(wr/rd)&#xa;depbar_ok = counter ≤ thresh&#xa;exit_drain_violation = issue &amp;&amp; exit &amp;&amp; !drained" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;" vertex="1" parent="1"><mxGeometry x="350" y="680" width="580" height="140" as="geometry"/></mxCell>
    <mxCell id="chain" value="eligible → age_matrix → CGGTY → allocate" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;" vertex="1" parent="1"><mxGeometry x="350" y="880" width="580" height="70" as="geometry"/></mxCell>
    <mxCell id="swb" value="exec_wb_arb&#xa;ev_wr0 / ev_wr1&#xa;（release = Wr0 / Wr1）" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1570" y="130" width="300" height="80" as="geometry"/></mxCell>
    <mxCell id="srd" value="rd 事件：共用一条 lane&#xa;mem · CBU · tensor · async&#xa;（见图 07）" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1570" y="250" width="300" height="90" as="geometry"/></mxCell>
    <mxCell id="sreq" value="req lane：LSU / TMA 等&#xa;mbar lane：mbarrier" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1570" y="380" width="300" height="80" as="geometry"/></mxCell>
    <mxCell id="c2" value="issue_sb_wr/rd&#xa;issue_wslot" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.2;entryDx=0;entryDy=0;" edge="1" parent="1" source="alloc" target="inc"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="305" y="170"/><mxPoint x="305" y="170"/></Array></mxGeometry></mxCell>
