<mxfile host="drawio"><diagram id="target-v2" name="target-pipeline-v2"><mxGraphModel dx="2300" dy="2484" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2300" pageHeight="2484" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Subcore 目标流水线结构 v2：大流水线套小流水线（由 subcore_structure.py 生成，未全部实现）" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontColor=#1F2933;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="1900" height="32" as="geometry"/></mxCell><mxCell id="subtitle" value="虚线框 = 小级（框内各项同一拍完成），细横条 = 小级寄存器；粗竖条 = 大级边界（寄存器或 FIFO，不归任何一级）；黄色块 = 存储，箭头连到读它 / 写它的小级。灰色 [ ] 为出处；绿色 [定 x] 为已定；橙色 [暂定 x] 为暂定、按指令逐条复核；红色【建议 x】待确认。" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="20" y="38" width="2260" height="18" as="geometry"/></mxCell><mxCell id="f_S0_0" value="" style="rounded=1;arcSize=4;html=1;fillColor=none;dashed=1;strokeColor=#888888;" vertex="1" parent="1"><mxGeometry x="54" y="154" width="206" height="92" as="geometry"/></mxCell><mxCell id="fl_S0_0" value="&lt;b&gt;s0&lt;/b&gt; · 1 拍" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="58" y="156" width="198" height="18" as="geometry"/></mxCell><mxCell id="fn_S0_0_0" value="&lt;b&gt;arbitrate + tag compare&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px;font-weight:normal;color:#444444&#x27;&gt;选 warp；tag 在寄存器 &lt;font style=&#x27;color:#888888&#x27;&gt;[fig12]&lt;/font&gt;&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="60" y="176" width="194" height="62" as="geometry"/></mxCell><mxCell id="sr_S0_0" value="" style="html=1;fillColor=#555555;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="54" y="252" width="206" height="5" as="geometry"/></mxCell><mxCell id="f_S0_1" value="" style="rounded=1;arcSize=4;html=1;fillColor=none;dashed=1;strokeColor=#888888;" vertex="1" parent="1"><mxGeometry x="54" y="263" width="206" height="86" as="geometry"/></mxCell><mxCell id="fl_S0_1" value="&lt;b&gt;s1&lt;/b&gt; · 1 拍" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="58" y="265" width="198" height="18" as="geometry"/></mxCell><mxCell id="fn_S0_1_0" value="&lt;b&gt;L0I data read&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px;font-weight:normal;color:#444444&#x27;&gt;SRAM 同步读 &lt;font style=&#x27;color:#888888&#x27;&gt;[§12]&lt;/font&gt;&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="60" y="285" width="194" height="56" as="geometry"/></mxCell><mxCell id="sr_S0_1" value="" style="html=1;fillColor=#555555;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="54" y="355" width="206" height="5" as="geometry"/></mxCell><mxCell id="f_S0_2" value="" style="rounded=1;arcSize=4;html=1;fillColor=none;dashed=1;strokeColor=#888888;" vertex="1" parent="1"><mxGeometry x="54" y="366" width="206" height="106" as="geometry"/></mxCell><mxCell id="fl_S0_2" value="&lt;b&gt;s2&lt;/b&gt; · 1 拍" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="58" y="368" width="198" height="18" as="geometry"/></mxCell><mxCell id="fn_S0_2_0" value="&lt;b&gt;respond&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px;font-weight:normal;color:#444444&#x27;&gt;命中 → 写 IB；未命中 → 向 L1I 发 miss；预取 hint &lt;font style=&#x27;color:#888888&#x27;&gt;[fig12]&lt;/font&gt;&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="60" y="388" width="194" height="76" as="geometry"/></mxCell><mxCell id="f_S1_0" value="" style="rounded=1;arcSize=4;html=1;fillColor=none;dashed=1;strokeColor=#888888;" vertex="1" parent="1"><mxGeometry x="344" y="154" width="186" height="134" as="geometry"/></mxCell><mxCell id="fl_S1_0" value="&lt;b&gt;s0&lt;/b&gt; · 1 拍" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="348" y="156" width="178" height="18" as="geometry"/></mxCell><mxCell id="fn_S1_0_0" value="&lt;b&gt;IB read + decode&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px;font-weight:normal;color:#444444&#x27;&gt;预译码：源寄存器、写目标、写回 tap、hold 种类、目标前门（含 valu_var 位，供 S2 扣 credit，E24） &lt;font style=&#x27;color:#888888&#x27;&gt;[fig13]&lt;/font&gt;&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="350" y="176" width="174" height="104" as="geometry"/></mxCell><mxCell id="f_S2_0" value="" style="rounded=1;arcSize=4;html=1;fillColor=none;dashed=1;strokeColor=#888888;" vertex="1" parent="1"><mxGeometry x="614" y="154" width="286" height="256" as="geometry"/></mxCell><mxCell id="fl_S2_0" value="&lt;b&gt;s0&lt;/b&gt; · 单拍环" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="618" y="156" width="278" height="18" as="geometry"/></mxCell><mxCell id="fn_S2_0_0" value="&lt;b&gt;eligible ×16&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px;font-weight:normal;color:#444444&#x27;&gt;slot_valid &amp; head &amp; stall = 0 &amp; 显式 SB &amp; 隐式 SB 全 0 &amp; credit &amp; its_available &amp; grid_dep_ok &lt;font style=&#x27;color:#888888&#x27;&gt;[fig13]&lt;/font&gt;&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="620" y="176" width="274" height="90" as="geometry"/></mxCell><mxCell id="fn_S2_0_1" value="&lt;b&gt;pick warp&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px;font-weight:normal;color:#444444&#x27;&gt;age · last_issued · yield · stop_issue &lt;font style=&#x27;color:#888888&#x27;&gt;[fig13]&lt;/font&gt;&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="620" y="272" width="274" height="62" as="geometry"/></mxCell><mxCell id="fn_S2_0_2" value="&lt;b&gt;issue&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px;font-weight:normal;color:#444444&#x27;&gt;选中 &amp; credit_ok &amp; rdy_s3；发射沿更新左侧状态 &lt;font style=&#x27;color:#888888&#x27;&gt;[§11-14]&lt;/font&gt;&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="620" y="340" width="274" height="62" as="geometry"/></mxCell><mxCell id="f_S3_0" value="" style="rounded=1;arcSize=4;html=1;fillColor=none;dashed=1;strokeColor=#888888;" vertex="1" parent="1"><mxGeometry x="984" y="154" width="206" height="340" as="geometry"/></mxCell><mxCell id="fl_S3_0" value="&lt;b&gt;s0&lt;/b&gt; · 1 拍" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="988" y="156" width="198" height="18" as="geometry"/></mxCell><mxCell id="fn_S3_0_0" value="&lt;b&gt;payload decode&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px;font-weight:normal;color:#444444&#x27;&gt;指令来自 head FIFO 读口 &lt;font style=&#x27;color:#888888&#x27;&gt;[fig14]&lt;/font&gt; &lt;font style=&#x27;color:#1E7B34;font-weight:bold&#x27;&gt;[定 F2]&lt;/font&gt;&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="990" y="176" width="194" height="76" as="geometry"/></mxCell><mxCell id="fn_S3_0_1" value="&lt;b&gt;take lane mask&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px;font-weight:normal;color:#444444&#x27;&gt;读 S2/S3 reg 里的 ITS 状态 &lt;font style=&#x27;color:#888888&#x27;&gt;[fig14]&lt;/font&gt;&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="990" y="258" width="194" height="62" as="geometry"/></mxCell><mxCell id="fn_S3_0_2" value="&lt;b&gt;route&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px;font-weight:normal;color:#444444&#x27;&gt;按通道 + opcode 拆通道：固定延迟（含 VOTE / VOTEU / ELECT / CREDUX / PMTRIG）→ dispatch reg；变长由 S3 拼好队列项（meta + payload，不含操作数与 guard mask），直接推入级间队列，推入一定成功 &lt;font style=&#x27;color:#1E7B34;font-weight:bold&#x27;&gt;[定 B1]&lt;/font&gt; &lt;font style=&#x27;color:#1E7B34;font-weight:bold&#x27;&gt;[定 R2]&lt;/font&gt; &lt;font style=&#x27;color:#1E7B34;font-weight:bold&#x27;&gt;[定 E8]&lt;/font&gt;&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="990" y="326" width="194" height="160" as="geometry"/></mxCell><mxCell id="f_S4_0" value="" style="rounded=1;arcSize=4;html=1;fillColor=none;dashed=1;strokeColor=#888888;" vertex="1" parent="1"><mxGeometry x="1274" y="154" width="296" height="168" as="geometry"/></mxCell><mxCell id="fl_S4_0" value="&lt;b&gt;s0&lt;/b&gt; · 1 拍" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="1278" y="156" width="288" height="18" as="geometry"/></mxCell><mxCell id="fn_S4_0_0" value="&lt;b&gt;allocate&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px;font-weight:normal;color:#444444&#x27;&gt;查表：入口 · 读口 · 写回拍 · 出口计数；不通过拉低 ena_s4_0 并冻结 stall &lt;font style=&#x27;color:#888888&#x27;&gt;[§3-6]&lt;/font&gt; &lt;font style=&#x27;color:#888888&#x27;&gt;[§11-15]&lt;/font&gt;&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1280" y="176" width="284" height="76" as="geometry"/></mxCell><mxCell id="fn_S4_0_1" value="&lt;b&gt;reuse 标签查找&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px;font-weight:normal;color:#444444&#x27;&gt;命中的源不计读次数 &lt;font style=&#x27;color:#888888&#x27;&gt;[§11-17]&lt;/font&gt;&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1280" y="258" width="284" height="56" as="geometry"/></mxCell><mxCell id="sr_S4_0" value="" style="html=1;fillColor=#555555;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1274" y="328" width="296" height="5" as="geometry"/></mxCell><mxCell id="f_S4_1" value="" style="rounded=1;arcSize=4;html=1;fillColor=none;dashed=1;strokeColor=#888888;" vertex="1" parent="1"><mxGeometry x="1274" y="339" width="296" height="230" as="geometry"/></mxCell><mxCell id="fl_S4_1" value="&lt;b&gt;s1&lt;/b&gt; · rounds = 0…3 拍" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="1278" y="341" width="288" height="18" as="geometry"/></mxCell><mxCell id="fn_S4_1_0" value="&lt;b&gt;RF read&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px;font-weight:normal;color:#444444&#x27;&gt;读地址 a … a + rounds − 1；SRAM 同步读；e = a + rounds &lt;font style=&#x27;color:#888888&#x27;&gt;[§11-18]&lt;/font&gt; &lt;font style=&#x27;color:#1E7B34;font-weight:bold&#x27;&gt;[定 E17]&lt;/font&gt;&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1280" y="361" width="284" height="76" as="geometry"/></mxCell><mxCell id="fn_S4_1_1" value="&lt;b&gt;前门读请求&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px;font-weight:normal;color:#444444&#x27;&gt;由前门队头 / 状态寄存器组合译码的请求（不依赖 S4 本拍批准与别级组合输出），每拍每 bank 至多 1 个，S4 当拍仲裁当拍读；固定（allocate）优先，变长按 LDC &gt; XLANE &gt; MUFU &gt; 访存 &lt;font style=&#x27;color:#888888&#x27;&gt;[§11-20]&lt;/font&gt; &lt;font style=&#x27;color:#1E7B34;font-weight:bold&#x27;&gt;[定 verify-b4]&lt;/font&gt; &lt;font style=&#x27;color:#1E7B34;font-weight:bold&#x27;&gt;[定 E3]&lt;/font&gt; &lt;font style=&#x27;color:#1E7B34;font-weight:bold&#x27;&gt;[定 E4]&lt;/font&gt;&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1280" y="443" width="284" height="118" as="geometry"/></mxCell><mxCell id="ln_S5_0" value="&lt;b&gt;VALU&lt;/b&gt; &lt;font style=&#x27;color:#888888&#x27;&gt;[§11-22]&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="1654" y="154" width="133" height="18" as="geometry"/></mxCell><mxCell id="lb_S5_0_0" value="s0" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1654" y="174" width="133" height="28" as="geom