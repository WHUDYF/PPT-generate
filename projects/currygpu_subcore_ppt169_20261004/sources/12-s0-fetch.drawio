    <mxCell id="e13" value="查找未结束：下一拍不选" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#9673A6;fontSize=10;labelBackgroundColor=#FFFFFF;dashed=1;fontColor=#6B4F7A;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="rsp" target="arb"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="836" y="585"/><mxPoint x="180" y="585"/></Array></mxGeometry></mxCell>
    <mxCell id="e14" value="IB 条数 · 还能撑几拍" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#D6B656;fontSize=10;labelBackgroundColor=#FFFFFF;dashed=1;fontColor=#7A6420;exitX=0;exitY=0.9;exitDx=0;exitDy=0;entryX=0.233;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="ib" target="arb"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1130" y="470.8"/><mxPoint x="1130" y="730"/><mxPoint x="100" y="730"/></Array></mxGeometry></mxCell>
    <mxCell id="e15" value="分支跳转：改到目标地址，旧指令作废，清空 IB" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#B85450;fontSize=10;labelBackgroundColor=#FFFFFF;dashed=1;fontColor=#B85450;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s2" target="ws"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1295" y="770"/><mxPoint x="12" y="770"/><mxPoint x="12" y="165"/></Array></mxGeometry></mxCell>
