    <mxCell id="e11" value="回填完成：结束等待" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#D6B656;fontSize=10;labelBackgroundColor=#FFFFFF;dashed=1;fontColor=#7A6420;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="l0i" target="ws"><mxGeometry relative="1" as="geometry"/></mxCell>
