<mxfile host="app.diagrams.net" agent="currygpu-subcore" version="24.7.17" type="device">
  <diagram id="s0" name="S0 Fetch">
    <mxGraphModel dx="1600" dy="1040" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1040" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
    <mxCell id="t1" value="S0 · subcore_fetch：现状的三步取指（arbitrate → L0I lookup → respond / IB write）" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontColor=#1F2933;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="1400" height="28" as="geometry"/></mxCell>
    <mxCell id="t2" value="按 curryGPU main eaf47c84 的 ifetch_frontend / ifetch_arb / ifetch_l0i / ifetch_ib 读出，未仿真。每个 subcore 一份；L1I、miss queue、TLB 在 SM 层，4 个 subcore 共用。" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="38" width="1560" height="20" as="geometry"/></mxCell>
    <mxCell id="fr" value="c0 · ① ② 同一拍组合完成" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9673A6;dashed=1;strokeWidth=1.5;verticalAlign=bottom;align=right;spacingRight=10;spacingBottom=2;fontSize=11;fontStyle=1;fontColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="20" y="270" width="690" height="250" as="geometry"/></mxCell>
    <mxCell id="ws" value="&lt;b&gt;挑选 warp 时看的状态&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px;font-weight:normal;color:#555555&#x27;&gt;每个 warp 一份 ×16&lt;/font&gt;&lt;div style=&#x27;text-align:left;font-size:11px;font-weight:normal;margin-top:6px;line-height:1.35&#x27;&gt;&lt;b&gt;1 分支情况&lt;/b&gt;：跳转后改从目标地址取，&lt;br&gt;&amp;nbsp;&amp;nbsp;跳转前取回的旧指令作废&lt;br&gt;&lt;b&gt;2 warp 是否启用&lt;/b&gt;：未启用的 warp 不取指&lt;br&gt;&lt;b&gt;3 指令未命中&lt;/b&gt;：正从上级指令缓存（L1I）&lt;br&gt;&amp;nbsp;&amp;nbsp;取回，等待期间不参加仲裁&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;fontStyle=1;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="30" y="90" width="300" height="150" as="geometry"/></mxCell>
    <mxCell id="l0i" value="&lt;b&gt;L0I&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px;font-weight:normal;color:#555555&#x27;&gt;每 subcore 一块 · 8 KB&lt;/font&gt;&lt;div style=&#x27;text-align:left;font-size:11px;font-weight:normal;margin-top:6px;line-height:1.35&#x27;&gt;64 行全相联，每行 1024 位 = 8 条指令&lt;br&gt;回填 FSM：Idle → Beat ×4（256 位）→ Commit&lt;br&gt;替换：同一行 → 无效行 → 轮转&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;fontStyle=1;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="400" y="90" width="300" height="150" as="geometry"/></mxCell>
    <mxCell id="arb" value="&lt;b&gt;arbitrate&lt;/b&gt;&lt;div style=&#x27;text-align:left;font-size:11px;font-weight:normal;margin-top:6px;line-height:1.35&#x27;&gt;&lt;b&gt;有资格&lt;/b&gt;：warp 已启用 · 不在等未命中&lt;br&gt;&amp;nbsp;&amp;nbsp;· IB 至少空 2 格 · 没取到程序末尾&lt;br&gt;&amp;nbsp;&amp;nbsp;· 上一次查找已结束 · 没有被暂停&lt;br&gt;&lt;b&gt;选择顺序&lt;/b&gt;：1 久未选中的优先 · 2 IB 快空的&lt;br&gt;&amp;nbsp;&amp;nbsp;优先 · 3 IB 条数少 · 4 warp 号小&lt;br&gt;&lt;b&gt;输出&lt;/b&gt;：选中的 warp · 它的取指地址&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;fontStyle=1;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="30" y="280" width="300" height="212" as="geometry"/></mxCell>
    <mxCell id="b1" value="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1F2933;strokeColor=#1F2933;fontColor=#FFFFFF;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="38" y="288" width="24" height="24" as="geometry"/></mxCell>
    <mxCell id="lk" value="&lt;b&gt;L0I lookup&lt;/b&gt;&lt;div style=&#x27;text-align:left;font-size:11px;font-weight:normal;margin-top:6px;line-height:1.35&#x27;&gt;取指地址 = 第几行 + 行内第几条（0–7）&lt;br&gt;64 行同时比较行号 → 是否命中&lt;br&gt;命中：读出整行 1024 位（64 选 1）&lt;br&gt;同时看下一行在不在（预取 hint 用）&lt;br&gt;&lt;b&gt;拍末寄存&lt;/b&gt;：是否命中 · 整行 · 行内第几条&lt;br&gt;&amp;nbsp;&amp;nbsp;· 哪个 warp · 取指地址 · 分支版本号&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;fontStyle=1;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="400" y="280" width="300" height="212" as="geometry"/></mxCell>
    <mxCell id="b2" value="2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1F2933;strokeColor=#1F2933;fontColor=#FFFFFF;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="408" y="288" width="24" height="24" as="geometry"/></mxCell>
    <mxCell id="clk" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F2933;strokeColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="735" y="270" width="8" height="250" as="geometry"/></mxCell>
    <mxCell id="e9l" value="回填" style="text;html=1;align=right;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="710" y="592" width="38" height="16" as="geometry"/></mxCell>
    <mxCell id="clkl" value="response reg&lt;br&gt;（11 号图同名）" style="text;html=1;align=right;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontColor=#1F2933;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="612" y="524" width="128" height="40" as="geometry"/></mxCell>
    <mxCell id="rsp" value="&lt;b&gt;respond / IB write&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px;font-weight:normal;color:#555555&#x27;&gt;c1&lt;/font&gt;&lt;div style=&#x27;text-align:left;font-size:11px;font-weight:normal;margin-top:6px;line-height:1.35&#x27;&gt;&lt;b&gt;(a) 作废&lt;/b&gt;：查找后该 warp 已跳转、退出或&lt;br&gt;&amp;nbsp;&amp;nbsp;重新启动 → 取回的是旧指令，丢弃&lt;br&gt;&lt;b&gt;(b) 命中&lt;/b&gt;：取当前条 + 下一条（行尾只取 1 条，&lt;br&gt;&amp;nbsp;&amp;nbsp;不越过程序末尾）→ 写 IB，取指地址 +1 或 +2&lt;br&gt;&lt;b&gt;(c) 未命中&lt;/b&gt;：发 miss（每 4 拍最多 1 个），&lt;br&gt;&amp;nbsp;&amp;nbsp;该 warp 进入等待，退出仲裁&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;fontStyle=1;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="770" y="280" width="330" height="212" as="geometry"/></mxCell>
    <mxCell id="b3" value="3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1F2933;strokeColor=#1F2933;fontColor=#FFFFFF;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="778" y="288" width="24" height="24" as="geometry"/></mxCell>
    <mxCell id="ib" value="&lt;b&gt;Instr Buffer&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px;font-weight:normal;color:#555555&#x27;&gt;×16 warps&lt;/font&gt;&lt;div style=&#x27;text-align:left;font-size:11px;font-weight:normal;margin-top:6px;line-height:1.35&#x27;&gt;每 warp 8 项，分 2 个 bank：&lt;br&gt;&amp;nbsp;&amp;nbsp;相邻两条在不同 bank → 每拍写 2 条&lt;br&gt;head 缓存：IB 空时第一条直接写入&lt;br&gt;记录条数，以及还能撑几拍（每条 1 + stall）&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;fontStyle=1;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1160" y="280" width="270" height="212" as="geometry"/></mxCell>
    <mxCell id="slot0" value="B0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=9;fontColor=#7A6420;" vertex="1" parent="1"><mxGeometry x="1179" y="452" width="29" height="22" as="geometry"/></mxCell>
