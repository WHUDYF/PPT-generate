    <mxCell id="e_sram" value="整行" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="sram" target="s1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
    <mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
    <mxCell id="e2ib" value="1–2 条" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s2" target="ib"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
    <mxCell id="e_head" value="head" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.35;exitDx=0;exitDy=0;entryX=0;entryY=0.35;entryDx=0;entryDy=0;" edge="1" parent="1" source="ib" target="dec"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
    <mxCell id="e_pop" value="弹出" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=1;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="dec" target="ib"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
    <mxCell id="e_miss" value="miss 请求" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s2" target="l1i"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
    <mxCell id="e_rdy" value="ready（寄存）" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#B85450;fontSize=10;labelBackgroundColor=#FFFFFF;dashed=1;fontColor=#B85450;exitX=0.7;exitY=0;exitDx=0;exitDy=0;entryX=0.7;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="l1i" target="s2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
    <mxCell id="e_hint" value="预取 hint" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#6C8EBF;fontSize=10;labelBackgroundColor=#FFFFFF;dashed=1;fontColor=#6C8EBF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s2" target="l1i"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
    <mxCell id="e_fill" value="回填写整行" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.25;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="l1i" target="sram"><mxGeometry x="-0.8" relative="1" as="geometry"><Array as="points"><mxPoint x="762" y="635"/><mxPoint x="762" y="164"/></Array></mxGeometry></mxCell>
    <mxCell id="e_done" value="回填 Commit：清等这一行的 warp 的 MISS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#D6B656;fontSize=10;labelBackgroundColor=#FFFFFF;dashed=1;fontColor=#7A6420;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=1;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="l1i" target="ws"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
    <mxCell id="e_upd" value="PC 前进 · 清在途位 · 未命中进 MISS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#9673A6;fontSize=10;labelBackgroundColor=#FFFFFF;dashed=1;fontColor=#6B4F7A;exitX=0.15;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="1" source="s2" target="ws"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="831" y="570"/><mxPoint x="400" y="570"/><mxPoint x="400" y="642"/></Array></mxGeometry></mxCell>
    <mxCell id="e_room" value="IB 条数 · 还能撑几拍" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#D6B656;fontSize=10;labelBackgroundColor=#FFFFFF;dashed=1;fontColor=#7A6420;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.8;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ib" target="s0"><mxGeometry x="-0.6" relative="1" as="geometry"><Array as="points"><mxPoint x="1310" y="268"/><mxPoint x="294" y="268"/></Array></mxGeometry></mxCell>
