<mxfile host="app.diagrams.net" agent="currygpu-subcore" version="24.7.17" type="device">
  <diagram id="s0" name="S0 Fetch">
    <mxGraphModel dx="1600" dy="1054" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1054" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
    <mxCell id="t1" value="S0 · subcore_fetch：目标三级取指（s0 选 + tag 比较 → s1 L0I 数据 SRAM 读 → s2 写 IB）" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontColor=#1F2933;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="1500" height="28" as="geometry"/></mxCell>
    <mxCell id="t2" value="2026-10-08 讨论定稿，未实现。每个 subcore 一份；L1I、miss queue、TLB 在 SM 层，4 个 subcore 共用。现状（两级、全局锁）见本图旧版 ef62769 与 curryGPU 本地 document/2026-10-08-s0-fetch-spec.md 第 2–7 节。" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="38" width="1560" height="20" as="geometry"/></mxCell>
    <mxCell id="l0i" value="L0I · 每 subcore 一块 · 8 KB" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#6C8EBF;dashed=1;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontSize=12;fontStyle=1;fontColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="20" y="72" width="730" height="168" as="geometry"/></mxCell>
    <mxCell id="tag" value="&lt;b&gt;tag ×64 · 寄存器&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px;font-weight:normal;color:#555555&#x27;&gt;64 个 tag 合计不到 1 KB，留在触发器&lt;/font&gt;&lt;div style=&#x27;text-align:left;font-size:11px;font-weight:normal;margin-top:6px;line-height:1.4&#x27;&gt;64 行全相联，s0 同拍比较 → 命中行号&lt;br&gt;同时看下一行在不在（预取 hint 用）&lt;br&gt;替换：同一行 → 无效行 → 轮转&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="30" y="98" width="330" height="132" as="geometry"/></mxCell>
    <mxCell id="sram" value="&lt;b&gt;data · SRAM 64 × 1024 位&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px;font-weight:normal;color:#555555&#x27;&gt;1RW · 同步读：本拍给行号，下拍出整行&lt;/font&gt;&lt;div style=&#x27;text-align:left;font-size:11px;font-weight:normal;margin-top:6px;line-height:1.4&#x27;&gt;回填：Idle → Beat ×4（256 位）→ Commit 写整行&lt;br&gt;Commit 优先：前一拍已知，寄存&quot;下一拍要写&quot;&lt;br&gt;&amp;nbsp;&amp;nbsp;→ s0 那拍不发查找（不形成组合反压）&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="420" y="98" width="320" height="132" as="geometry"/></mxCell>
    <mxCell id="s0" value="&lt;b&gt;s0 · 选 + tag 比较&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px;font-weight:normal;color:#555555&#x27;&gt;小级 vld_s0 = grant_valid（源头级）&lt;/font&gt;&lt;div style=&#x27;text-align:left;font-size:11px;font-weight:normal;margin-top:6px;line-height:1.4&#x27;&gt;&lt;b&gt;有资格&lt;/b&gt;：warp 已启用 · &lt;b&gt;不在途&lt;/b&gt; · 不在等未命中&lt;br&gt;&amp;nbsp;&amp;nbsp;· IB 空位够（现有 + 在途 + 2 ≤ 8）· 没取到末尾&lt;br&gt;&amp;nbsp;&amp;nbsp;· 下一拍没有回填写 · rdy_s0&lt;br&gt;&lt;b&gt;选择顺序&lt;/b&gt;：久未选中 → IB 快空 → IB 条数少 → warp 号小&lt;br&gt;&lt;b&gt;选中&lt;/b&gt;：置该 warp 在途位；地址 = PC + code_base；&lt;br&gt;&amp;nbsp;&amp;nbsp;tag 比较得到命中行号&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="30" y="300" width="330" height="196" as="geometry"/></mxCell>
    <mxCell id="b1" value="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1F2933;strokeColor=#1F2933;fontColor=#FFFFFF;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="38" y="308" width="24" height="24" as="geometry"/></mxCell>
    <mxCell id="s1" value="&lt;b&gt;s1 · 读 L0I 数据&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px;font-weight:normal;color:#555555&#x27;&gt;vld_s1 &amp;lt;= handshake_s0&lt;/font&gt;&lt;div style=&#x27;text-align:left;font-size:11px;font-weight:normal;margin-top:6px;line-height:1.4&#x27;&gt;用命中行号读数据 SRAM，下一拍出整行 1024 位&lt;br&gt;未命中：不读 SRAM，只带着 warp / PC 往下走&lt;br&gt;&lt;br&gt;&lt;b&gt;s2 停住时&lt;/b&gt;：不读 SRAM，s2 的数据保持；&lt;br&gt;&amp;nbsp;&amp;nbsp;回填写照常&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="420" y="300" width="300" height="196" as="geometry"/></mxCell>
    <mxCell id="b2" value="2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1F2933;strokeColor=#1F2933;fontColor=#FFFFFF;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="428" y="308" width="24" height="24" as="geometry"/></mxCell>
    <mxCell id="s2" value="&lt;b&gt;s2 · 处理结果 / 写 IB&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px;font-weight:normal;color:#555555&#x27;&gt;vld_s2 &amp;lt;= handshake_s1&lt;/font&gt;&lt;div style=&#x27;text-align:left;font-size:11px;font-weight:normal;margin-top:6px;line-height:1.4&#x27;&gt;&lt;b&gt;(a) 作废&lt;/b&gt;：epoch 不符，或该 warp 被跳转、退出、重启&lt;br&gt;&amp;nbsp;&amp;nbsp;→ 丢弃，直接放行&lt;br&gt;&lt;b&gt;(b) 命中&lt;/b&gt;：取当前条 + 下一条（行尾 1 条）→ 写 IB，&lt;br&gt;&amp;nbsp;&amp;nbsp;PC +1 / +2，清在途位&lt;br&gt;&lt;b&gt;(c) 未命中&lt;/b&gt;：向 L1I 发 miss，该 warp 进 MISS；&lt;br&gt;&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#B85450&quot;&gt;&lt;b&gt;L1I 不收 → rdy_s2 = 0，整条 S0 停住&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="780" y="300" width="340" height="196" as="geometry"/></mxCell>
    <mxCell id="b3" value="3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1F2933;strokeColor=#1F2933;fontColor=#FFFFFF;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="788" y="308" width="24" height="24" as="geometry"/></mxCell>
    <mxCell id="r01" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F2933;strokeColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="383" y="290" width="8" height="216" as="geometry"/></mxCell>
    <mxCell id="r12" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F2933;strokeColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="743" y="290" width="8" height="216" as="geometry"/></mxCell>
    <mxCell id="r01l" value="寄存：warp · PC · epoch · 命中&lt;br&gt;· 命中行号 · 行内序号" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="290" y="508" width="200" height="30" as="geometry"/></mxCell>
    <mxCell id="r12l" value="寄存：SRAM 输出整行&lt;br&gt;（response reg，停住时保持）" style="text;html=1;align=right;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="560" y="508" width="178" height="30" as="geometry"/></mxCell>
    <mxCell id="ib" value="&lt;b&gt;Instr Buffer ×16 warps&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px;font-weight:normal;color:#555555&#x27;&gt;S0 拥有 · S0 → S1 的大级边界&lt;/font&gt;&lt;div style=&#x27;text-align:left;font-size:11px;font-weight:normal;margin-top:6px;line-height:1.4&#x27;&gt;每 warp 一个 8 项 FIFO，16 个共用一块存储&lt;br&gt;2 个 bank × 64 项 × 128 位（相邻两条在不同 bank）&lt;br&gt;每 bank 每拍一写一读（1R1W），同步读&lt;br&gt;指针 · 条数 · deadline 用寄存器&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1170" y="300" width="280" height="196" as="geometry"/></mxCell>
    <mxCell id="slot0" value="B0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=9;fontColor=#7A6420;" vertex="1" parent="1"><mxGeometry x="1190" y="462" width="30" height="22" as="geometry"/></mxCell>
    <mxCell id="slot1" value="B1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=9;fontColor=#7A6420;" vertex="1" parent="1"><mxGeometry x="1220" y="462" width="30" height="22" as="geometry"/></mxCell>
    <mxCell id="slot2" value="B0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=9;fontColor=#7A6420;" vertex="1" parent="1"><mxGeometry x="1250" y="462" width="30" height="22" as="geometry"/></mxCell>
    <mxCell id="slot3" value="B1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=9;fontColor=#7A6420;" vertex="1" parent="1"><mxGeometry x="1280" y="462" width="30" height="22" as="geometry"/></mxCell>
    <mxCell id="slot4" value="B0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=9;fontColor=#7A6420;" vertex="1" parent="1"><mxGeometry x="1310" y="462" width="30" height="22" as="geometry"/></mxCell>
    <mxCell id="slot5" value="B1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=9;fontColor=#7A6420;" vertex="1" parent="1"><mxGeometry x="1340" y="462" width="30" height="22" as="geometry"/></mxCell>
    <mxCell id="slot6" value="B0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=9;fontColor=#7A6420;" vertex="1" parent="1"><mxGeometry x="1370" y="462" width="30" height="22" as="geometry"/></mxCell>
    <mxCell id="slot7" value="B1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=9;fontColor=#7A6420;" vertex="1" parent="1"><mxGeometry x="1400" y="462" width="30" height="22" as="geometry"/></mxCell>
    <mxCell id="dec" value="&lt;b&gt;S1&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px;font-weight:normal;color:#555555&#x27;&gt;subcore_decode&lt;/font&gt;&lt;div style=&#x27;text-align:left;font-size:11px;font-weight:normal;margin-top:6px;line-height:1.4&#x27;&gt;每拍弹 1 条&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1490" y="350" width="90" height="110" as="geometry"/></mxCell>
    <mxCell id="ws" value="&lt;b&gt;每 warp 取指状态 ×16&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px;font-weight:normal;color:#555555&#x27;&gt;S0 拥有&lt;/font&gt;&lt;div style=&#x27;text-align:left;font-size:11px;font-weight:normal;margin-top:6px;line-height:1.4&#x27;&gt;fetch PC · epoch（分支版本号）· 启用&lt;br&gt;&lt;b&gt;在途位&lt;/b&gt;（取代现状的全局锁）&lt;br&gt;小 FSM：IDLE → RUN ⇄ MISS；跳转、退出时 epoch +1&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="30" y="610" width="330" height="130" as="geometry"/></mxCell>
    <mxCell id="l1i" value="&lt;b&gt;L1I（SM 层，4 个 subcore 共用）&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px;font-weight:normal;color:#555555&#x27;&gt;miss queue · TLB&lt;/font&gt;&lt;div style=&#x27;text-align:left;font-size:11px;font-weight:normal;margin-top:6px;line-height:1.4&#x27;&gt;ready 必须是寄存器输出（下一拍能收 / credit）&lt;br&gt;节流：每 4 拍最多收 1 个 · 回填 4 拍 × 256 位&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="780" y="610" width="340" height="100" as="geometry"/></mxCell>
    <mxCell id="s2m" value="&lt;b&gt;S2 / warp 管理&lt;/b&gt;&lt;div style=&#x27;text-align:left;font-size:11px;font-weight:normal;margin-top:6px;line-height:1.4&#x27;&gt;分支跳转（warp、目标地址）&lt;br&gt;warp 启动 · 退出&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1170" y="610" width="280" height="100" as="geometry"/></mxCell>
    <mxCell id="e_ws" value="PC · epoch · 在途 · 等待" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="ws" target="s0"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
