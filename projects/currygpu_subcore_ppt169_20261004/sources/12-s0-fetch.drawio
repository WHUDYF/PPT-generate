    <mxCell id="slot4" value="B0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=9;fontColor=#7A6420;" vertex="1" parent="1"><mxGeometry x="1295" y="452" width="29" height="22" as="geometry"/></mxCell>
    <mxCell id="slot5" value="B1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D6B656;fontSize=9;fontColor=#7A6420;" vertex="1" parent="1"><mxGeometry x="1324" y="452" width="29" height="22" as="geometry"/></mxCell>
    <mxCell id="slot6" value="B0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=9;fontColor=#7A6420;" vertex="1" parent="1"><mxGeometry x="1353" y="452" width="29" height="22" as="geometry"/></mxCell>
    <mxCell id="slot7" value="B1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D6B656;fontSize=9;fontColor=#7A6420;" vertex="1" parent="1"><mxGeometry x="1382" y="452" width="29" height="22" as="geometry"/></mxCell>
    <mxCell id="s1" value="&lt;b&gt;S1&lt;/b&gt;&lt;div style=&#x27;text-align:left;font-size:11px;font-weight:normal;margin-top:6px;line-height:1.35&#x27;&gt;subcore_decode&lt;br&gt;refill pick&lt;br&gt;每拍弹 1 条&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;fontStyle=1;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1470" y="330" width="110" height="130" as="geometry"/></mxCell>
    <mxCell id="l1i" value="&lt;b&gt;L1I（SM 层，4 个 subcore 共用）&lt;/b&gt;&lt;div style=&#x27;text-align:left;font-size:11px;font-weight:normal;margin-top:6px;line-height:1.35&#x27;&gt;miss queue · TLB&lt;br&gt;回填：4 拍 × 256 位 = 一整行&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;fontStyle=1;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="770" y="600" width="330" height="90" as="geometry"/></mxCell>
    <mxCell id="s2" value="&lt;b&gt;S2 / warp 管理&lt;/b&gt;&lt;div style=&#x27;text-align:left;font-size:11px;font-weight:normal;margin-top:6px;line-height:1.35&#x27;&gt;分支跳转（warp、目标地址）&lt;br&gt;warp 启动 · 退出&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;fontStyle=1;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1160" y="600" width="270" height="90" as="geometry"/></mxCell>
    <mxCell id="e1" value="取指地址 · 状态" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ws" target="arb"><mxGeometry relative="1" as="geometry"/></mxCell>
