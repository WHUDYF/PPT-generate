        <mxCell id="title" value="ITS subsystem — independent thread scheduling · per-lane PC + splinter table + rebuild walker" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#1F2933;" vertex="1" parent="1">
