<mxfile host="app.diagrams.net"><diagram name="hazard3_frontend"><mxGraphModel dx="1800" dy="1000" grid="1" gridSize="10" page="1" pageWidth="2160" pageHeight="1767" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Hazard3 F 级：一个大流水级套 5 个小级（hazard3_frontend）" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontColor=#1F2933;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="1800" height="30" as="geometry"/></mxCell><mxCell id="c2" value="Hazard3 v1.1.1（8af9929）· 以 RV32IMC、2port 为例 · 虚线框 = 可选（由配置参数决定）· 下方卡片里灰色小字是 hazard3_frontend.v 行号" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="2100" height="20" as="geometry"/></mxCell><mxCell id="ahb" value="存储侧接口 · I 侧 AHB5 → 存储（以后可以换成 I-cache）&lt;br&gt;&lt;font style=&#x27;font-size:9px;font-weight:normal&#x27;&gt;地址相位 HADDR / HTRANS ← F0      数据相位 HRDATA / HREADY / HRESP → F1      hazard3_cpu_2port.v:208&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="72" width="620" height="50" as="geometry"/></mxCell><mxCell id="c3" value="F · 取指   hazard3_frontend&lt;br&gt;&lt;font style=&#x27;font-size:9px;font-weight:normal&#x27;&gt;一个大流水级：内部 5 个小级，其中 F0 → F1 隔一个时钟沿，F1 → F4 在同一拍里组合完成&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEEEEE;strokeColor=#666666;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="140" width="1610" height="40" as="geometry"/></mxCell><mxCell id="c4" value="X · 译码 + 执行&lt;br&gt;&lt;font style=&#x27;font-size:9px;font-weight:normal&#x27;&gt;这里只画与 F 相关的部分&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEEEEE;strokeColor=#666666;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1680" y="140" width="220" height="40" as="geometry"/></mxCell><mxCell id="c5" value="M · 访存 + 写回&lt;br&gt;&lt;font style=&#x27;font-size:9px;font-weight:normal&#x27;&gt;这里只画与 F 相关的部分&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEEEEE;strokeColor=#666666;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1940" y="140" width="190" height="40" as="geometry"/></mxCell><mxCell id="c6" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F2933;strokeColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="1652" y="140" width="8" height="466" as="geometry"/></mxCell><mxCell id="c7" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F2933;strokeColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="1912" y="140" width="8" height="466" as="geometry"/></mxCell><mxCell id="c8" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F2933;strokeColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="337" y="196" width="6" height="410" as="geometry"/></mxCell><mxCell id="c9" value="同一拍（拍 n+1）：旁路时 F1 → F4 组合完成，末沿同时锁存 IB 和 CIR" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;dashed=1;strokeWidth=1;verticalAlign=bottom;align=center;spacingBottom=-16;fontSize=10;fontColor=#777777;" vertex="1" parent="1"><mxGeometry x="348" y="188" width="1300" height="426" as="geometry"/></mxCell><mxCell id="c10" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#6C8EBF;strokeWidth=1.5;dashed=1;" vertex="1" parent="1"><mxGeometry x="30" y="196" width="290" height="410" as="geometry"/></mxCell><mxCell id="c11" value="F0 · 发地址" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#6C8EBF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="202" width="290" height="18" as="geometry"/></mxCell><mxCell id="c12" value="拍 n · 逻辑上和 X 同一拍" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="30" y="220" width="290" height="16" as="geometry"/></mxCell><mxCell id="f0_sel" value="地址选择 → 总线&lt;br&gt;&lt;font style=&#x27;font-size:9px;font-weight:normal&#x27;&gt;优先级  hold &amp;gt; jump &amp;gt; debug 停取 &amp;gt; 顺序&lt;br&gt;总是整字对齐、32 bit&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="44" y="246" width="262" height="56" as="geometry"/></mxCell><mxCell id="f0_stall" value="节流 fetch_stall&lt;br&gt;&lt;font style=&#x27;font-size:9px;font-weight:normal&#x27;&gt;FIFO 满；或 FIFO 有 1 项且还有在途；&lt;br&gt;或在途 ≥ 2  → 本拍不发&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="44" y="328" width="262" height="56" as="geometry"/></mxCell><mxCell id="f0_btb" value="BTB 换地址（可选）&lt;br&gt;&lt;font style=&#x27;font-size:9px;font-weight:normal&#x27;&gt;取到最近一次 taken 的后向分支&lt;br&gt;→ 下一个地址直接换成目标&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;fontStyle=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="44" y="410" width="262" height="56" as="geometry"/></mxCell><mxCell id="c13" value="owns&lt;br&gt;&lt;font style=&#x27;font-size:9px;font-weight:normal&#x27;&gt;fetch_addr · fetch_priv&lt;br&gt;mem_addr_hold · reset_holdoff&lt;br&gt;BTB 1 项（可选）&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="44" y="506" width="262" height="88" as="geometry"/></mxCell><mxCell id="e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#6C8EBF;fontColor=#6C8EBF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="f0_stall" target="f0_sel"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#6C8EBF;fontColor=#6C8EBF;dashed=1;exitX=0.85;exitY=0;exitDx=0;exitDy=0;entryX=0.85;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="f0_btb" target="f0_sel"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#82B366;strokeWidth=1.5;dashed=1;" vertex="1" parent="1"><mxGeometry x="360" y="196" width="290" height="410" as="geometry"/></mxCell><mxCell id="c17" value="F1 · 收数据" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#82B366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="360" y="202" width="290" height="18" as="geometry"/></mxCell><mxCell id="c18" value="拍 n+1 · 总线数据相位" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="360" y="220" width="290" height="16" as="geometry"/></mxCell><mxCell id="f1_rx" value="收数据&lt;br&gt;&lt;font style=&#x27;font-size:9px;font-weight:normal&#x27;&gt;hready=1 时 mem_data 有效&lt;br&gt;带上元数据：哪半有效 · 错误 · 断点&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="374" y="246" width="262" height="56" as="geometry"/></mxCell><mxCell id="f1_cnt" value="在途计数&lt;br&gt;&lt;font style=&#x27;font-size:9px;font-weight:normal&#x27;&gt;pending_fetches：已发未回 0..2&lt;br&gt;ctr_flush_pending：跳转前在途的，回来就丢&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="374" y="328" width="262" height="56" as="geometry"/></mxCell><mxCell id="f1_steer" value="数据去向&lt;br&gt;&lt;font style=&#x27;font-size:9px;font-weight:normal&#x27;&gt;旧请求 → 丢弃&lt;br&gt;FIFO 空且 IB 有空位 → 旁路&lt;br&gt;否则 → 进 FIFO&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="374" y="410" width="262" height="69" as="geometry"/></mxCell><mxCell id="c19" value="owns&lt;br&gt;&lt;font style=&#x27;font-size:9px;font-weight:normal&#x27;&gt;pending_fetches · ctr_flush_pending&lt;br&gt;mem_data_hwvld · predbranch&lt;br&gt;check_addr（PMP / 断点，可选）&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="374" y="506" width="262" height="88" as="geometry"/></mxCell><mxCell id="e20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#82B366;fontColor=#82B366;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="f1_rx" target="f1_cnt"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#82B366;fontColor=#82B366;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="f1_cnt" target="f1_steer"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c22" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9673A6;strokeWidth=1.5;dashed=1;" vertex="1" parent="1"><mxGeometry x="690" y="196" width="290" height="410" as="geometry"/></mxCell><mxCell id="c23" value="F2 · 预取 FIFO" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#9673A6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="690" y="202" width="290" height="18" as="geometry"/></mxCell><mxCell id="c24" value="队列 · 空时旁路，不加延迟" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="690" y="220" width="290" height="16" as="geometry"/></mxCell><mxCell id="f2_pop" value="取数 / 弹出&lt;br&gt;&lt;font style=&#x27;font-size:9px;font-weight:normal&#x27;&gt;FIFO 空 → 直接用总线数据（旁路）&lt;br&gt;否则取 FIFO 头；IB 有空位就弹出&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="704" y="246" width="262" height="56" as="geometry"/></mxCell><mxCell id="f2_push" value="推入&lt;br&gt;&lt;font style=&#x27;font-size:9px;font-weight:normal&#x27;&gt;数据回来、但没能走旁路&lt;br&gt;跳转时全部清空&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="704" y="328" width="262" height="56" as="geometry"/></mxCell><mxCell id="c25" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F2933;strokeColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="750" y="490" width="170" height="3" as="geometry"/></mxCell><mxCell id="c26" value="末沿" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=9;fontColor=#777777;" vertex="1" parent="1"><mxGeometry x="920" y="482" width="60" height="14" as="geometry"/></mxCell><mxCell id="c27" value="owns&lt;br&gt;&lt;font style=&#x27;font-size:9px;font-weight:normal&#x27;&gt;fifo_mem 2 项 × 32 bit&lt;br&gt;每项：哪半有效 · err · break · predbranch&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="704" y="506" width="262" height="88" as="geometry"/></mxCell><mxCell id="e28" value="下一拍起" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#9673A6;fontColor=#9673A6;dashed=1;exitX=0.2;exitY=0;exitDx=0;exitDy=0;entryX=0.2;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="f2_push" target="f2_pop"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c29" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9673A6;strokeWidth=1.5;dashed=1;" vertex="1" parent="1"><mxGeometry x="1020" y="196" width="290" height="410" as="geometry"/></mxCell><mxCell id="c30" value="F3 · 指令缓冲 IB" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#9673A6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1020" y="202" width="290" height="18" as="geometry"/></mxCell><mxCell id="c31" value="队列 · 按半字存，3 个槽" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="1020" y="220" width="290" height="16" as="geometry"/></mxCell><mxCell id="f3_shift" value="移位&lt;br&gt;&lt;font style=&#x27;font-size:9px;font-weight:normal&#x27;&gt;按 cir_use 去掉 X 本拍用掉的&lt;br&gt;0 / 1 / 2 个半字&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1034" y="246" width="262" height="56" as="geometry"/></mxCell><mxCell id="f3_ovl" value="叠加新字&lt;br&gt;&lt;font style=&#x27;font-size:9px;font-weight:normal&#x27;&gt;剩余 ≤ 1 个半字才收（同时让 FIFO 弹出）&lt;br&gt;新字只有高半有效时先对齐&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1034" y="328" width="262" height="56" as="geometry"/></mxCell><mxCell id="f3_flush" value="冲刷&lt;br&gt;&lt;font style=&#x27;font-size:9px;font-weight:normal&#x27;&gt;jump：清空&lt;br&gt;cir_flush_behind：保留当前指令&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1034" y="410" width="262" height="56" as="geometry"/></mxCell><mxCell id="c32" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F2933;strokeColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="1080" y="490" width="170" height="3" as="geometry"/></mxCell><mxCell id="c33" value="末沿" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=9;fontColor=#777777;" vertex="1" parent="1"><mxGeometry x="1250" y="482" width="60" height="14" as="geometry"/></mxCell><mxCell id="c34" value="owns&lt;br&gt;&lt;font style=&#x27;font-size:9px;font-weight:normal&#x27;&gt;buf_contents：3 个半字槽（含元数据）&lt;br&gt;buf_level 0..3&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1034" y="506" width="262" height="88" as="geometry"/></mxCell><mxCell id="e35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#9673A6;fontColor=#9673A6;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="f3_shift" target="f3_ovl"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#9673A6;fontColor=#9673A6;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="f3_ovl" target="f3_flush"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c37" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#6C8EBF;strokeWidth=1.5;dashed=1;" vertex="1" parent="1"><mxGeometry x="1350" y="196" width="290" height="410" as="geometry"/></mxCell><mxCell id="c38" value="F4 · 预译码 / 解压" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#6C8EBF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1350" y="202" width="290" height="18" as="geometry"/></mxCell><mxCell id="c39" value="组合 · 末沿锁存成 CIR" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="1350" y="220" width="290" height="16" as="geometry"/></mxCell><mxCell id="f4_next" value="next_instr&lt;br&gt;&lt;font style=&#x27;font-size:9px;font-weight:normal&#x27;&gt;叠加后的槽 0、1 = 下一拍的指令&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1364" y="246" width="262" height="43" as="geometry"/></mxCell><mxCell id="f4_pre" value="预译码 rs1 / rs2&lt;br&gt;&lt;font style=&#x27;font-size:9px;font-weight:normal&#x27;&gt;→ 寄存器堆读地址、bypass 选择&lt;br&gt;比 X 正式译码早一拍&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1364" y="315" width="262" height="56" as="geometry"/></mxCell><mxCell id="f4_dec" value="解压 + uop&lt;br&gt;&lt;font style=&#x27;font-size:9px;font-weight:normal&#x27;&gt;16 bit → 32 bit&lt;br&gt;Zcmp push / pop 拆成 uop&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1364" y="397" width="262" height="56" as="geometry"/></mxCell><mxCell id="c40" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F2933;strokeColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="1410" y="490" width="170" height="3" as="geometry"/></mxCell><mxCell id="c41" value="末沿" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=9;fontColor=#777777;" vertex="1" parent="1"><mxGeometry x="1580" y="482" width="60" height="14" as="geometry"/></mxCell><mxCell id="c42" value="owns&lt;br&gt;&lt;font style=&#x27;font-size:9px;font-weight:normal&#x27;&gt;cir（已解压，= IB 队头）· cir_vld&lt;br&gt;cir_is_32bit · uop 标志&lt;/font&gt;" style="rounded=0;whiteS