ndArrow=block;endSize=4;html=1;strokeColor=#0066CC;fontSize=8;fontColor=#0066CC;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeWidth=2;exitX=1;exitY=0.7;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="pre" target="o_byp"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e67" value="cir_use[2]   cir_flush_behind（同拍，可能依赖 hready）" style="endArrow=block;endSize=4;html=1;strokeColor=#0066CC;fontSize=8;fontColor=#0066CC;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeWidth=2;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="o_dec" target="shift"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2455" y="196"/><mxPoint x="1857" y="196"/></Array></mxGeometry></mxCell><mxCell id="e68" value="uop_stall / uop_clear" style="endArrow=block;endSize=4;html=1;strokeColor=#000000;fontSize=8;fontColor=#000000;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=0;exitY=0.85;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="o_dec" target="dec"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2312" y="642"/></Array></mxGeometry></mxCell><mxCell id="e69" value="btb_target_addr_out[32]" style="endArrow=block;endSize=4;html=1;strokeColor=#888888;fontSize=8;fontColor=#888888;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=0;dashed=1;dashPattern=6 4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="btb" target="o_pc"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="635" y="788"/></Array></mxGeometry></mxCell><mxCell id="e70" value="" style="endArrow=block;endSize=4;html=1;strokeColor=#000000;fontSize=8;fontColor=#000000;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="pmpchk" target="pmp"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e71" value="" style="endArrow=block;endSize=4;html=1;strokeColor=#000000;fontSize=8;fontColor=#000000;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="x_dbg" target="dbgin"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1040" y="768"/></Array></mxGeometry></mxCell><mxCell id="b72" value="①  预取：顺序取指与节流" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;strokeColor=#000000;fillColor=none;align=center;strokeWidth=2;verticalAlign=top;spacingTop=3;" vertex="1" parent="1"><mxGeometry x="20" y="998" width="840" height="148" as="geometry"/></mxCell><mxCell id="b73" value="fetch_addr 每被接收一次就 +4：F 总是按字在 PC 前面取，取回的字先放进 FIFO / IB，等 X 来用   L346" style="rounded=0;whiteSpace=wrap;html=1;fontSize=9;strokeColor=#000000;fillColor=none;align=center;" vertex="1" parent="1"><mxGeometry x="34" y="1028" width="812" height="18" as="geometry"/></mxCell><mxCell id="b74" value="要不要再发由 fetch_stall 决定：FIFO 满；或 FIFO 有 1 项且还有在途；或在途 ≥ 2   L416-418" style="rounded=0;whiteSpace=wrap;html=1;fontSize=9;strokeColor=#000000;fillColor=none;align=center;" vertex="1" parent="1"><mxGeometry x="34" y="1050" width="812" height="18" as="geometry"/></mxCell><mxCell id="b75" value="它按「在途的都会回来」预留空间，只看寄存器、不看本拍 hready → hready 不会组合地影响下一个地址   L413" style="rounded=0;whiteSpace=wrap;html=1;fontSize=9;strokeColor=#000000;fillColor=none;align=center;" vertex="1" parent="1"><mxGeometry x="34" y="1072" width="812" height="18" as="geometry"/></mxCell><mxCell id="b76" value="例   X 停住（div）   拍 0 发 W1 · 拍 1 发 W2、W1 进 FIFO · 拍 2 停发、W2 进 FIFO（满）· 之后一直停发，直到 X 恢复消耗" style="rounded=0;whiteSpace=wrap;html=1;fontSize=9;strokeColor=#000000;fillColor=none;align=center;" vertex="1" parent="1"><mxGeometry x="34" y="1094" width="812" height="18" as="geometry"/></mxCell><mxCell id="b77" value="结论   FIFO 2 项是满速取指的下限；32 bit 指令每拍用掉 1 个字，正好等于取指带宽；RVC 指令消耗慢，FIFO 很快满，取指自动降速" style="rounded=0;whiteSpace=wrap;html=1;fontSize=9;strokeColor=#000000;fillColor=none;align=center;" vertex="1" parent="1"><mxGeometry x="34" y="1116" width="812" height="18" as="geometry"/></mxCell><mxCell id="b78" value="②  跳转：jal / jalr / taken 分支 / trap" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;strokeColor=#000000;fillColor=none;align=center;strokeWidth=2;verticalAlign=top;spacingTop=3;" vertex="1" parent="1"><mxGeometry x="880" y="998" width="840" height="192" as="geometry"/></mxCell><mxCell id="b79" value="来源   X：jal、jalr、taken 条件分支，目标在 X 用 x_addr_sum 算出      M：trap 进入，优先于 X   core.v:1376-1377" style="rounded=0;whiteSpace=wrap;html=1;fontSize=9;strokeColor=#000000;fillColor=none;align=center;" vertex="1" parent="1"><mxGeometry x="894" y="1028" width="812" height="18" as="geometry"/></mxCell><mxCell id="b80" value="接受条件   jump_target_rdy = !mem_addr_hold：上拍地址正被总线保持时不能换地址，X 停一拍   L401   core.v:478" style="rounded=0;whiteSpace=wrap;html=1;fontSize=9;strokeColor=#000000;fillColor=none;align=center;" vertex="1" parent="1"><mxGeometry x="894" y="1050" width="812" height="18" as="geometry"/></mxCell><mxCell id="b81" value="被接受那拍（jump_now）：目标当拍直接作为 mem_addr 发出，不经过 fetch_addr；fetch_addr ← 目标（已被接收则再 +4）   L391 L327" style="rounded=0;whiteSpace=wrap;html=1;fontSize=9;strokeColor=#000000;fillColor=none;align=center;" vertex="1" parent="1"><mxGeometry x="894" y="1072" width="812" height="18" as="geometry"/></mxCell><mxCell id="b82" value="同拍冲刷：FIFO 全清、IB 清 0；已发出未返回的请求个数记入 ctr_flush_pending，它们回来时被丢掉   L212 L436 L649" style="rounded=0;whiteSpace=wrap;html=1;fontSize=9;strokeColor=#000000;fillColor=none;align=center;" vertex="1" parent="1"><mxGeometry x="894" y="1094" width="812" height="18" as="geometry"/></mxCell><mxCell id="b83" value="跳到奇数半字：首字低半无效（hwvld=10）；若目标是 32 bit 指令还要再取一个字，多 1 拍   L462" style="rounded=0;whiteSpace=wrap;html=1;fontSize=9;strokeColor=#000000;fillColor=none;align=center;" vertex="1" parent="1"><mxGeometry x="894" y="1116" width="812" height="18" as="geometry"/></mxCell><mxCell id="b84" value="CIR 保留：X 被 stall（stall 依赖 hready，挡不住跳转）却发了跳转 → cir_flush_behind=1，保留当前指令、只冲刷后面的   L648   decode.v:146" style="rounded=0;whiteSpace=wrap;html=1;fontSize=9;strokeColor=#000000;fillColor=none;align=center;" vertex="1" parent="1"><mxGeometry x="894" y="1138" width="812" height="18" as="geometry"/></mxCell><mxCell id="b85" value="代价   jal = 2 拍：拍 0 X 发目标 · 拍 1 目标数据进 IB / CIR（X 空 1 拍）· 拍 2 X 执行目标指令" style="rounded=0;whiteSpace=wrap;html=1;fontSize=9;strokeColor=#000000;fillColor=none;align=center;" vertex="1" parent="1"><mxGeometry x="894" y="1160" width="812" height="18" as="geometry"/></mxCell><mxCell id="b86" value="③  分支：默认不跳，可选 1 项 BTB" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;strokeColor=#000000;fillColor=none;align=center;strokeWidth=2;verticalAlign=top;spacingTop=3;" vertex="1" parent="1"><mxGeometry x="1740" y="998" width="840" height="148" as="geometry"/></mxCell><mxCell id="b87" value="条件分支在 X 比较（FAST_BRANCHCMP 时用专门比较器）；taken 就按 ② 发跳转；不 taken 什么都不做 → 等于静态预测「不跳」   core.v:935" style="rounded=0;whiteSpace=wrap;html=1;fontSize=9;strokeColor=#000000;fillColor=none;align=center;" vertex="1" parent="1"><mxGeometry x="1754" y="1028" width="812" height="18" as="geometry"/></mxCell><mxCell id="b88" value="BRANCH_PREDICTOR=1：BTB 只记最近一次 taken 的后向条件分支（循环回跳）   set core.v:943   clear core.v:948" style="rounded=0;whiteSpace=wrap;html=1;fontSize=9;strokeColor=#000000;fillColor=none;align=center;" vertex="1" parent="1"><mxGeometry x="1754" y="1050" width="812" height="18" as="geometry"/></mxCell><mxCell id="b89" value="F 侧：fetch_addr 落在 btb_src 所在字 → 下一个地址直接换成 btb_target，并给该指令的半字打 predbranch 标记   L343 L482" style="rounded=0;whiteSpace=wrap;html=1;fontSize=9;strokeColor=#000000;fillColor=none;align=center;" vertex="1" parent="1"><mxGeometry x="1754" y="1072" width="812" height="18" as="geometry"/></mxCell><mxCell id="b90" value="X 侧：带 predbranch 的分支比较结果取反、偏移改成指令长度 → 预测对：不发跳转，PC ← btb_target；预测错：跳回顺序地址并清 BTB   core.v:912   decode.v:224 242" style="rounded=0;whiteSpace=wrap;html=1;fontSize=9;strokeColor=#000000;fillColor=none;align=center;" vertex="1" parent="1"><mxGeometry x="1754" y="1094" width="812" height="18" as="geometry"/></mxCell><mxCell id="b91" value="代价   预测对 1 拍（两段取指被拼成连续的）      未预测的 taken / 预测错 2 拍" style="rounded=0;whiteSpace=wrap;html=1;fontSize=9;strokeColor=#000000;fillColor=none;align=center;" vertex="1" parent="1"><mxGeometry x="1754" y="1116" width="812" height="18" as="geometry"/></mxCell><mxCell id="b92" value="④  取回的数据怎么处理" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;strokeColor=#000000;fillColor=none;align=center;strokeWidth=2;verticalAlign=top;spacingTop=3;" vertex="1" parent="1"><mxGeometry x="20" y="1210" width="840" height="170" as="geometry"/></mxCell><mxCell id="b93" value="数据回来（mem_data_vld）先看 ctr_flush_pending：非 0 → 是跳转前发出的旧请求，丢弃   L425 L592" style="rounded=0;whiteSpace=wrap;html=1;fontSize=9;strokeColor=#000000;fillColor=none;align=center;" vertex="1" parent="1"><mxGeometry x="34" y="1240" width="812" height="18" as="geometry"/></mxCell><mxCell id="b94" value="否则带上元数据：hwvld（哪半有效）、err（总线错误或 PMP 失败）、break（断点）、predbranch（预测分支）   L129-147" style="rounded=0;whiteSpace=wrap;html=1;fontSize=9;strokeColor=#000000;fillColor=none;align=center;" vertex="1" parent="1"><mxGeometry x="34" y="1262" width="812" height="18" as="geometry"/></mxCell><mxCell id="b95" value="FIFO 空 且 IB 有空位 → 旁路，当拍进 IB 并算出下一拍 CIR；否则推入 FIFO，等 IB 有空位再弹出   L425 L594 L635" style="rounded=0;whiteSpace=wrap;html=1;fontSize=9;strokeColor=#000000;fillColor=none;align=center;" vertex="1" parent="1"><mxGeometry x="34" y="1284" width="812" height="18" as="geometry"/></mxCell><mxCell id="b96" value="进 IB 前先对齐：只有高半有效时把高半放到低位（fetch_contents_aligned）   L617" style="rounded=0;whiteSpace=wrap;html=1;fontSize=9;strokeColor=#000000;fillColor=none;align=center;" vertex="1" parent="1"><mxGeometry x="34" y="1306" width="812" height="18" as="geometry"/></mxCell><mxCell id="b97" value="叠加：新字接在 IB 剩余半字之后；IB 剩余 ≤ 1 个半字（新字只半个有效时 ≤ 2）才收   L634-641" style="rounded=0;whiteSpace=wrap;html=1;fontSize=9;strokeColor=#000000;fillColor=none;align=center;" vertex="1" parent="1"><mxGeometry x="34" y="1328" width="812" height="18" as="geometry"/></mxCell><mxCell id="b98" value="元数据只在被译码时才生效：带错误的字如果被跳转冲掉，就当没发生过   L145" style="rounded=0;whiteSpace=wrap;html=1;fontSize=9;strokeColor=#000000;fillColor=none;align=center;" vertex="1" parent="1"><mxGeometry x="34" y="1350" width="812" height="18" as="geometry"/></mxCell><mxCell id="b99" value="⑤  IB 与 CIR：半字粒度的指令缓冲" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;strokeColor=#000000;fillColor=none;align=center;strokeWidth=2;verticalAlign=top;spacingTop=3;" vertex="1" parent="1"><mxGeometry x="880" y="1210" width="840" height="170" as="geometry"/></mxCell><mxCell id="b100" value="IB = 3 个半字槽；FIFO 按字、IB 按半字，因为指令可以是 16 或 32 bit，而且可以不按字对齐" style="rounded=0;whiteSpace=wrap;html=1;fontSize=9;strokeColor=#000000;fillColor=none;align=center;" vertex="1" parent="1"><mxGeometry x="894" y="1240" width="812" height="18" as="geometry"/></mxCell><mxCell id="b101" value="X 每拍回送 cir_use = 本拍用掉的半字数 0 / 1 / 2（stall 时为 0）→ 同拍移位，再叠加新字   decode.v:142   L625" style="rounded=0;whiteSpace=wrap;html=1;fontSize=9;strokeColor=#000000;fillColor=none;align=center;" vertex="1" parent="1"><mxGeometry x="894" y="1262" width="812" height="18" as="geometry"/></mxCell><mxCell id="b102" value="next_instr = 移位 + 叠加后的槽 0、1，同拍送去预译码和解压，末沿锁进 CIR   L701 L874" style="rounded=0;whiteSpace=wrap;html=1;fontSize=9;strokeColor=#000000;fillColor=none;align=center;" vertex="1" parent="1"><mxGeometry x="894" y="1284" width="812" height="18" as="geometry"/></mxCell><mxCell id="b103" value="CIR = 槽 0、1 的解压版，和 buf_contents 同一个沿更新；cir_vld = min(buf_level, 2)   L661" style="rounded=0;whiteSpace=wrap;html=1;fontSize=9;strokeColor=#000000;fillColor=none;align=center;" vertex="1" parent="1"><mxGeometry x="894" y="1306" width="812" height="18" as="geometry"/></mxCell><mxCell id="b104" value="例   内存 [c.addi | lw 低半] [lw 高半 | c.mv]：CIR=c.addi → use=1 → CIR=lw（跨字）→ use=2 → CIR=c.mv" style="rounded=0;whiteSpace=wrap;html=1;fontSize=9;strokeColor=#000000;fillColor=none;align=center;" vertex="1" parent="1"><mxGeometry x="894" y="1328" width="812" height="18" as="geometry"/></mxCell><mxCell id="b105" value="最长同拍路径   hready → X stall → cir_use → 移位 → 叠加 → next_instr → 预译码 → 寄存器堆读地址；接口注释允许 cir_use 依赖 hready   L54" style="rounded=0;whiteSpace=wrap;html=1;fontSize=9;strokeColor=#000000;fillColor=none;align=center;" vertex="1" parent="1"><mxGeometry x="894" y="1350" width="812" height="18" as="geometry"/></mxCell><mxCell id="b106" value="⑥  预译码、解压与 uop" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;strokeColor=#000000;fillColor=none;align=center;strokeWidth=2;verticalAlign=top;spacingTop=3;" vertex="1" parent="1"><mxGeometry x="1740" y="1210" width="840" height="148" as="geometry"/></mxCell><mxCell id="b107" value="预译码在 F 里提前从 next_instr 抽出 rs1 / rs2：coarse 直接作寄存器堆读地址，fine 给 bypass 选择；都不够准，不能用来判断 stall   L85-93" style="rounded=0;whiteSpace=wrap;html=1;fontSize=9;strokeColor=#000000;fillColor=none;align=center;" vertex="1" parent="1"><mxGeometry x="1754" y="1240" width="812" height="18" as="geometry"/></mxCell><mxCell id="b108" value="解压 hazard3_instr_decompress：16 bit → 32 bit，CIR 存的是解压后的指令；非法压缩码置 cir_invalid_16bit" style="rounded=0;whiteSpace=wrap;html=1;fontSize=9;strokeColor=#000000;fillColor=none;align=center;" vertex="1" parent="1"><mxGeometry x="1754" y="1262" width="812" height="18" as="geometry"/></mxCell><mxCell id="b109" value="Zcmp push / pop：一条指令拆成多个 uop，计数器在解压模块里；X 用 uop_stall 让它停、uop_clear 中止   L838-869" style="rounded=0;whiteSpace=wrap;html=1;fontSize=9;strokeColor=#000000;fillColor=none;align=center;" vertex="1" parent="1"><mxGeometry x="1754" y="1284" width="812" height="18" as="geometry"/></mxCell><mxCell id="b110" value="uop 标志 nonfinal / no_pc_update / atomic 告诉 X：PC 何时前进，以及中间态不允许被中断打断" style="rounded=0;whiteSpace=wrap;html=1;fontSize=9;strokeColor=#000000;fillColor=none;align=center;" vertex="1" parent="1"><mxGeometry x="1754" y="1306" width="812" height="18" as="geometry"/></mxCell><mxCell id="b111" value="不开 C 扩展时没有解压，CIR 直接是 IB 槽 0、1（L810）；IB 槽 2 和对齐逻辑都被常量折叠掉" style="rounded=0;whiteSpace=wrap;html=1;fontSize=9;strokeColor=#000000;fillColor=none;align=center;" vertex="1" parent="1"><mxGeometry x="1754" y="1328" width="812" height="18" as="geometry"/></mxCell><mxCell id="b112" value="时序对照      依据 doc/sections/instruction_timings.adoc（总线无等待）" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;strokeColor=#777777;fillColor=none;align=center;dashed=1;dashPattern=8 6;verticalAlign=top;spacingTop=3;" vertex="1" parent="1"><mxGeometry x="20" y="1400" width="840" height="200" as="geometry"/></mxCell><mxCell id="b113" value="顺序 32 bit 指令   每拍 1 条（FIFO 旁路：拍 n 发地址 → 拍 n+2 X 执行）" style="rounded=0;whiteSpace=wrap;html=1;fontSize=9;strokeColor=#000000;fillColor=none;align=center;" vertex="1" parent="1"><mxGeometry x="34" y="1432" width="812" height="18" as="geometry"/></mxCell><mxCell id="b114" value="jal / jalr   2 拍          taken 条件分支   2 拍          BTB 预测对   1 拍          预测错   2 拍" style="rounded=0;whiteSpace=wrap;html=1;fontSize=9;strokeColor=#000000;fillColor=none;align=center;" vertex="1" parent="1"><mxGeometry x="34" y="1454" width="812" height="18" as="geometry"/></mxCell><mxCell id="b115" value="跳到不按字对齐的 32 bit 指令   再 +1 拍（要取两个字）" style="rounded=0;whiteSpace=wrap;html=1;fontSize=9;strokeColor=#000000;fillColor=none;align=center;" vertex="1" parent="1"><mxGeometry x="34" y="1476" width="812" height="18" as="geometry"/></mxCell><mxCell id="b116" value="总线等待 n 拍   取指晚 n 拍；FIFO / IB 里已有的指令可以掩盖一部分" style="rounded=0;whiteSpace=wrap;html=1;fontSize=9;strokeColor=#000000;fillColor=none;align=center;" vertex="1" parent="1"><mxGeometry x="34" y="1498" width="812" height="18" as="geometry"/></mxCell><mxCell id="b117" value="load-use 等停顿发生在 X / M，F 只看到 cir_use=0，FIFO 被填满后停发" style="rounded=0;whiteSpace=wrap;html=1;fontSize=9;strokeColor=#000000;fillColor=none;align=center;" vertex="1" parent="1"><mxGeometry x="34" y="1520" width="812" height="18" as="geometry"/></mxCell><mxCell id="b118" value="与 curryGPU ifetch_top 对照" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;strokeColor=#777777;fillColor=none;align=center;dashed=1;dashPattern=8 6;verticalAlign=top;spacingTop=3;" vertex="1" parent="1"><mxGeometry x="880" y="1400" width="840" height="200" as="geometry"/></mxCell><mxCell id="b119" value="fetch_addr_q   ↔   ifetch_frontend 的 fetch_pc_q（每 warp 一个）" style="rounded=0;whiteSpace=wrap;html=1;fontSize=9;strokeColor=#000000;fillColor=none;align=center;" vertex="1" parent="1"><mxGeometry x="894" y="1432" width="812" height="18" as="geometry"/></mxCell><mxCell id="b120" value="I 侧 AHB + 存储   ↔   ifetch_l0i / ifetch_l1i" style="rounded=0;whiteSpace=wrap;html=1;fontSize=9;strokeColor=#000000;fillColor=none;align=center;" vertex="1" parent="1"><mxGeometry x="894" y="1454" width="812" height="18" as="geometry"/></mxCell><mxCell id="b121" value="FIFO + IB 3 槽   ↔   ifetch_ib（8 条 / warp）          CIR   ↔   IB 队头（decode 读的那条）" style="rounded=0;whiteSpace=wrap;html=1;fontSize=9;strokeColor=#000000;fillColor=none;align=center;" vertex="1" parent="1"><mxGeometry x="894" y="1476" width="812" height="18" as="geometry"/></mxCell><mxCell id="b122" value="cir_use   ↔   decode 的弹出（issue_valid）          jump   ↔   redirect" style="rounded=0;whiteSpace=wrap;html=1;fontSize=9;strokeColor=#000000;fillColor=none;align=center;" vertex="1" parent="1"><mxGeometry x="894" y="1498" width="812" height="18" as="geometry"/></mxCell><mxCell id="b123" value="ctr_flush_pending   ↔   epoch_q：Hazard3 单线程、按序返回，数在途个数即可；curryGPU 多 warp、可能乱序，用 epoch 判过期" style="rounded=0;whiteSpace=wrap;html=1;fontSize=9;strokeColor=#000000;fillColor=none;align=center;" vertex="1" parent="1"><mxGeometry x="894" y="1520" width="812" height="18" as="geometry"/></mxCell><mxCell id="b124" value="图例   provenance" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;strokeColor=#777777;fillColor=none;align=center;dashed=1;dashPattern=8 6;verticalAlign=top;spacingTop=3;" vertex="1" parent="1"><mxGeometry x="1740" y="1400" width="840" height="200" as="geometry"/></mxCell><mxCell id="b125" value="" style="rounded=0;whiteSpace=wrap;html=1;fontSize=9;strokeColor=#000000;fillColor=none;align=center;" vertex="1" parent="1"><mxGeometry x="1756" y="1432" width="30" height="14" as="geometry"/></mxCell><mxCell id="t126" value="黑色细框  =  RTL 已有，结构照搬（本图全部是）" style="text;html=1;fontSize=9;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1796" y="1431" width="770" height="16" as="geometry"/></mxCell><mxCell id="b127" value="" style="rounded=0;whiteSpace=wrap;html=1;fontSize=9;strokeColor=#000000;fillColor=none;align=center;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1756" y="1454" width="30" height="14" as="geometry"/></mxCell><mxCell id="t128" value="黑色粗框  =  一个子功能的分组，编号对应下方说明" style="text;html=1;fontSize=9;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1796" y="1453" width="770" height="16" as="geometry"/></mxCell><mxCell id="b129" value="" style="rounded=0;whiteSpace=wrap;html=1;fontSize=9;strokeColor=#777777;fillColor=none;align=center;strokeWidth=1.5;dashed=1;dashPattern=8 6;" vertex="1" parent="1"><mxGeometry x="1756" y="1476" width="30" height="14" as="geometry"/></mxCell><mxCell id="t130" value="灰色虚线框  =  可选，由配置参数决定是否存在" style="text;html=1;fontSize=9;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1796" y="1475" width="770" height="16" as="geometry"/></mxCell><mxCell id="l131" value="" style="endArrow=block;endSize=4;html=1;strokeColor=#0066CC;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1754" y="1505" as="sourcePoint"/><mxPoint x="1788" y="1505" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t132" value="蓝色粗箭头  =  同拍组合（读本拍的值）" style="text;html=1;fontSize=9;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1796" y="1497" width="770" height="16" as="geometry"/></mxCell><mxCell id="l133" value="" style="endArrow=block;endSize=4;html=1;strokeColor=#888888;strokeWidth=1;dashed=1;dashPattern=6 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1754" y="1527" as="sourcePoint"/><mxPoint x="1788" y="1527" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t134" value="灰色虚箭头  =  寄存器输出（上一拍的值）" style="text;html=1;fontSize=9;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1796" y="1519" width="770" height="16" as="geometry"/></mxCell><mxCell id="t135" value="依据   Hazard3/hdl/hazard3_{frontend,core,decode,instr_decompress,cpu_2port}.v   v1.1.1" style="text;html=1;fontSize=9;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1756" y="1548" width="810" height="14" as="geometry"/></mxCell><mxCell id="t136" value="          doc/sections/{introduction,instruction_timings}.adoc      官方总图 https://wren.wtf/hazard3/doc/#_pipeline_stages" style="text;html=1;fontSize=9;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1756" y="1564" width="810" height="14" as="geometry"/></mxCell><mxCell id="t137" value="          画法参照 curryGPU docs/design/uarch/ifetch_top.drawio" style="text;html=1;fontSize=9;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1756" y="1580" width="810" height="14" as="geometry"/></m