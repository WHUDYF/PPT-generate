;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;fontColor=#333333;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ahb" target="f1_rx"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e49" value="进 FIFO" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;fontColor=#333333;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="f1_steer" target="f2_push"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e50" value="旁路" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;fontColor=#333333;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="f1_steer" target="f2_pop"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e51" value="fetch_data（1 个字）" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;fontColor=#333333;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="f2_pop" target="f3_ovl"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e52" value="next_instr" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;fontColor=#333333;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="f3_ovl" target="f4_next"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e53" value="CIR" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;fontColor=#333333;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="f4_dec" target="x_dec"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e54" value="rs1 / rs2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;fontColor=#333333;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="f4_pre" target="x_rf"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c55" value="&lt;b&gt;▲ 时钟沿&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:9px;font-weight:normal&#x27;&gt;总线：地址相位 → 数据相位&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="250" y="620" width="180" height="34" as="geometry"/></mxCell><mxCell id="c56" value="&lt;b&gt;▲ IB + CIR&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:9px;font-weight:normal&#x27;&gt;末沿同时锁存&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="1566" y="620" width="180" height="34" as="geometry"/></mxCell><mxCell id="c57" value="&lt;b&gt;▲ xm_*&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:9px;font-weight:normal&#x27;&gt;X / M 级间寄存器&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="1826" y="620" width="180" height="34" as="geometry"/></mxCell><mxCell id="c58" value="握手 / 流控" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#1F2933;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="670" width="300" height="18" as="geometry"/></mxCell><mxCell id="c59" value="F0 / F1 ↔ 总线 · 地址 vld / rdy，没被接收就保持；数据无反压，所以 F0 只在放得下时才发" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="692" width="620" height="38" as="geometry"/></mxCell><mxCell id="c60" value="F1 → F2 → F3 · 没有握手：去向只由「FIFO 是否空」和「IB 剩余几个半字」决定" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="670" y="692" width="970" height="38" as="geometry"/></mxCell><mxCell id="c61" value="F → X · cir_vld 给出有效半字数；X 用 cir_use 当拍回送用掉多少" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1680" y="692" width="450" height="38" as="geometry"/></mxCell><mxCell id="c62" value="反向事件通道   同拍 = 组合，当拍生效      reg = 来自寄存器，或写寄存器、下一拍生效" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#1F2933;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="750" width="1400" height="20" as="geometry"/></mxCell><mxCell id="c63" value="&lt;b&gt;jump_target / jump_now&lt;/b&gt;   X（jal · jalr · taken 分支）、M（trap，优先）→ F0 换地址 · F1 记在途个数 · F2 清 FIFO · F3 清 IB      ②" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontColor=#B85450;" vertex="1" parent="1"><mxGeometry x="195.0" y="777" width="722.8000000000009" height="16" as="geometry"/></mxCell><mxCell id="l64" value="" style="html=1;strokeColor=#B85450;strokeWidth=1.5;dashed=1;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1774.0" y="796" as="sourcePoint"/><mxPoint x="179.0" y="796" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c65" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#B85450;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="172.0" y="793" width="6" height="6" as="geometry"/></mxCell><mxCell id="c66" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#B85450;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="502.0" y="793" width="6" height="6" as="geometry"/></mxCell><mxCell id="c67" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#B85450;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="832.0" y="793" width="6" height="6" as="geometry"/></mxCell><mxCell id="c68" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#B85450;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="1162.0" y="793" width="6" height="6" as="geometry"/></mxCell><mxCell id="c69" value="同拍" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B85450;fontSize=9;fontStyle=1;fontColor=#B85450;" vertex="1" parent="1"><mxGeometry x="1774.0" y="787" width="32" height="18" as="geometry"/></mxCell><mxCell id="c70" value="&lt;b&gt;cir_use[2] / cir_flush_behind&lt;/b&gt;   X → F3 · 本拍用掉几个半字，同拍移位；可能依赖 hready，是最长的同拍路径      ⑤" style="text;html=1;align=right;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="542.9999999999999" y="826" width="608.0000000000001" height="16" as="geometry"/></mxCell><mxCell id="l71" value="" style="html=1;strokeColor=#D79B00;strokeWidth=1.5;dashed=1;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1774.0" y="834" as="sourcePoint"/><mxPoint x="1169.0" y="834" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c72" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#D79B00;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="1162.0" y="831" width="6" height="6" as="geometry"/></mxCell><mxCell id="c73" value="同拍" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;fontSize=9;fontStyle=1;fontColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="1774.0" y="825" width="32" height="18" as="geometry"/></mxCell><mxCell id="c74" value="&lt;b&gt;uop_stall / uop_clear&lt;/b&gt;   X → F4 · 让 Zcmp 的 uop 序列停住或中止      ⑥" style="text;html=1;align=right;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="1075.4" y="864" width="405.6" height="16" as="geometry"/></mxCell><mxCell id="l75" value="" style="html=1;strokeColor=#9673A6;strokeWidth=1.5;dashed=1;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1774.0" y="872" as="sourcePoint"/><mxPoint x="1499.0" y="872" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c76" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#9673A6;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="1492.0" y="869" width="6" height="6" as="geometry"/></mxCell><mxCell id="c77" value="同拍" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9673A6;fontSize=9;fontStyle=1;fontColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="1774.0" y="863" width="32" height="18" as="geometry"/></mxCell><mxCell id="c78" value="&lt;b&gt;btb_set / btb_clear&lt;/b&gt;   X → F0 · 写 BTB，下一拍生效（可选）      ③" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="195.0" y="891" width="375.20000000000005" height="16" as="geometry"/></mxCell><mxCell id="l79" value="" style="html=1;strokeColor=#9673A6;strokeWidth=1.5;dashed=1;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1774.0" y="910" as="sourcePoint"/><mxPoint x="179.0" y="910" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c80" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#9673A6;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="172.0" y="907" width="6" height="6" as="geometry"/></mxCell><mxCell id="c81" value="reg" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9673A6;fontSize=9;fontStyle=1;fontColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="1774.0" y="901" width="32" height="18" as="geometry"/></mxCell><mxCell id="c82" value="&lt;b&gt;jump_target_rdy = !mem_addr_hold&lt;/b&gt;   F0 → X · 总线正保持地址时不能跳转，X 停一拍      ②" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="195.0" y="929" width="486.80000000000007" height="16" as="geometry"/></mxCell><mxCell id="l83" value="" style="html=1;strokeColor=#6C8EBF;strokeWidth=1.5;dashed=1;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="191.0" y="948" as="sourcePoint"/><mxPoint x="1786.0" y="948" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c84" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#6C8EBF;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="1787.0" y="945" width="6" height="6" as="geometry"/></mxCell><mxCell id="c85" value="reg" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;fontSize=9;fontStyle=1;fontColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="159.0" y="939" width="32" height="18" as="geometry"/></mxCell><mxCell id="c86" value="各部分怎么工作" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=15;fontColor=#1F2933;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="1006" width="1400" height="26" as="geometry"/></mxCell><mxCell id="c87" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#6C8EBF;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="30" y="1042" width="680" height="183" as="geometry"/></mxCell><mxCell id="c88" value="①  预取：F0 每拍决定发不发" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontColor=#6C8EBF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="46" y="1050" width="648" height="24" as="geometry"/></mxCell><mxCell id="c89" value="• fetch_addr 每被总线接收一次就 +4，所以 F 总是按字在 PC 前面取&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color=&#x27;#9AA5B1&#x27; style=&#x27;font-size:10px&#x27;&gt;L346&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="48" y="1082" width="644" height="21" as="geometry"/></mxCell><mxCell id="c90" value="• 是否再发由 fetch_stall 决定：FIFO 满；或 FIFO 有 1 项且还有在途；或在途 ≥ 2&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color=&#x27;#9AA5B1&#x27; style=&#x27;font-size:10px&#x27;&gt;L416&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="48" y="1109" width="644" height="21" as="geometry"/></mxCell><mxCell id="c91" value="• 只看寄存器、不看本拍 hready：按「在途的都会回来」预留空间，hready 不会组合地影响下一个地址&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color=&#x27;#9AA5B1&#x27; style=&#x27;font-size:10px&#x27;&gt;L413&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="48" y="1136" width="644" height="21" as="geometry"/></mxCell><mxCell id="c92" value="• 例：X 停住（div）→ 拍 0 发 W1 · 拍 1 发 W2，W1 进 FIFO · 拍 2 停发，W2 进 FIFO，正好满" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="48" y="1163" width="644" height="21" as="geometry"/></mxCell><mxCell id="c93" value="• 所以 FIFO 至少 2 项才能满速取指；RVC 指令消耗慢时 FIFO 很快满，取指自动降速&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color=&#x27;#9AA5B1&#x27; style=&#x27;font-size:10px&#x27;&gt;L119&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="48" y="1190" width="644" height="21" as="geometry"/></mxCell><mxCell id="c94" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#B85450;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="745" y="1042" width="680" height="237" as="geometry"/></mxCell><mxCell id="c95" value="②  跳转：jal / jalr / taken 分支 / trap" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontColor=#B85450;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="761" y="1050" width="648" height="24" as="geometry"/></mxCell><mxCell id="c96" value="• 来源：X 的 jal、jalr、taken 分支（目标在 X 算出）；M 的 trap 进入，优先于 X&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color=&#x27;#9AA5B1&#x27; style=&#x27;font-size:10px&#x27;&gt;core.v:1376&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="763" y="1082" width="644" height="21" as="geometry"/></mxCell><mxCell id="c97" value="• 只有 jump_target_rdy = !mem_addr_hold 时能接受；总线正保持上拍地址时 X 停一拍&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color=&#x27;#9AA5B1&#x27; style=&#x27;font-size:10px&#x27;&gt;L401&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="763" y="1109" width="644" height="21" as="geometry"/></mxCell><mxCell id="c98" value="• 接受那拍（jump_now）：目标当拍直接作为地址发出，不经过 fetch_addr&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color=&#x27;#9AA5B1&#x27; style=&#x27;font-size:10px&#x27;&gt;L391&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="763" y="1136" width="644" height="21" as="geometry"/></mxCell><mxCell id="c99" value="• 同拍冲刷：FIFO、IB 清空；已发出未返回的个数记入 ctr_flush_pending，回来就丢&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color=&#x27;#9AA5B1&#x27; style=&#x27;font-size:10px&#x27;&gt;L212 L436&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="763" y="1163" width="644" height="21" as="geometry"/></mxCell><mxCell id="c100" value="• 跳到奇数半字：首字低半无效；目标是 32 bit 指令时还要再取一个字，多 1 拍&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color=&#x27;#9AA5B1&#x27; style=&#x27;font-size:10px&#x27;&gt;L462&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="763" y="1190" width="644" height="21" as="geometry"/></mxCell><mxCell id="c101" value="• CIR 保留：X 被 stall 却发了跳转 → cir_flush_behind，保留当前指令、只冲刷后面的&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color=&#x27;#9AA5B1&#x27; style=&#x27;font-size:10px&#x27;&gt;L648&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="763" y="1217" width="644" height="21" as="geometry"/></mxCell><mxCell id="c102" value="• 代价：jal 2 拍 = 拍 0 发目标 · 拍 1 数据进 IB / CIR（X 空 1 拍）· 拍 2 执行" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="763" y="1244" width="644" height="21" as="geometry"/></mxCell><mxCell id="c103" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9673A6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1460" y="1042" width="680" height="183" as="geometry"/></mxCell><mxCell id="c104" value="③  分支：默认不跳，可选 1 项 BTB" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontColor=#9673A6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1476" y="1050" width="648" height="24" as="geometry"/></mxCell><mxCell id="c105" value="• 条件分支在 X 比较；taken 按 ② 发跳转，不 taken 什么都不做，等于静态预测「不跳」&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color=&#x27;#9AA5B1&#x27; style=&#x27;font-size:10px&#x27;&gt;core.v:935&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="1478" y="1082" width="644" height="21" as="geometry"/></mxCell><mxCell id="c106" value="• 可选 BTB 只有 1 项：记最近一次 taken 的后向条件分支（循环回跳）&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color=&#x27;#9AA5B1&#x27; style=&#x27;font-size:10px&#x27;&gt;core.v:943&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="1478" y="1109" width="644" height="21" as="geometry"/></mxCell><mxCell id="c107" value="• F0：取到该分支所在的字 → 下一个地址直接换成目标，并给这条指令打上 predbranch 标记&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color=&#x27;#9AA5B1&#x27; style=&#x27;font-size:10px&#x27;&gt;L343 L482&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="1478" y="1136" width="644" height="21" as="geometry"/></mxCell><mxCell id="c108" value="• X：预测对 → 不发跳转，PC ← BTB 目标；预测错 → 跳回顺序地址，并清 BTB&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color=&#x27;#9AA5B1&#x27; style=&#x27;font-size:10px&#x27;&gt;core.v:912 948&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="1478" y="1163" width="644" height="21" as="geometry"/></mxCell><mxCell id="c109" value="• 代价：预测对 1 拍；未预测的 taken、预测错都是 2 拍" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="1478" y="1190" width="644" height="21" as="geometry"/></mxCell><mxCell id="c110" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#82B366;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="30" y="1303" width="680" height="183" as="geometry"/></mxCell><mxCell id="c111" value="④  取回的数据：F1 → F2 → F3" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontColor=#82B366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="46" y="1311" width="648" height="24" as="geometry"/></mxCell><mxCell id="c112" value="• F1 数据回来先看 ctr_flush_pending：非 0 说明是跳转前的旧请求，丢弃&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color=&#x27;#9AA5B1&#x27; style=&#x27;font-size:10px&#x27;&gt;L425&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="48" y="1343" width="644" height="21" as="geometry"/></mxCell><mxCell id="c113" value="• 元数据和数据一起走：哪半有效、总线错误或 PMP 失败、断点、预测分支&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color=&#x27;#9AA5B1&#x27; style=&#x27;font-size:10px&#x27;&gt;L129-147&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="48" y="1370" width="644" height="21" as="geometry"/></mxCell><mxCell id="c114" value="• FIFO 空且 IB 有空位 → 旁路，当拍进 IB；否则推入 FIFO，等 IB 有空位再弹出&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color=&#x27;#9AA5B1&#x27; style=&#x27;font-size:10px&#x27;&gt;L594 L635&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="48" y="1397" width="644" height="21" as="geometry"/></mxCell><mxCell id="c115" value="• 进 IB 前先对齐：只有高半有效时（跳到奇数半字），把高半放到低位&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color=&#x27;#9AA5B1&#x27; style=&#x27;font-size:10px&#x27;&gt;L617&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="48" y="1424" width="644" height="21" as="geometry"/></mxCell><mxCell id="c116" value="• 元数据只在被译码时才生效：带错误的字如果被跳转冲掉，就当没发生过&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color=&#x27;#9AA5B1&#x27; style=&#x27;font-size:10px&#x27;&gt;L145&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="48" y="1451" width="644" height="21" as="geometry"/></mxCell><mxCell id="c117" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9673A6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="745" y="1303" width="680" height="210" as="geometry"/></mxCell><mxCell id="c118" value="⑤  IB 与 CIR：半字粒度的队列" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontColor=#9673A6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="761" y="1311" width="648" height="24" as="geometry"/></mxCell><mxCell id="c119" value="• 指令可以是 16 或 32 bit，而且可以不按字对齐，所以 IB 按半字存，共 3 个槽&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color=&#x27;#9AA5B1&#x27; style=&#x27;font-size:10px&#x27;&gt;L568&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="763" y="1343" width="644" height="21" as="geometry"/></mxCell><mxCell id="c120" value="• X 每拍回送 cir_use = 用掉的半字数 0 / 1 / 2 → 同拍移位，再把新字接在剩余半字后面&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color=&#x27;#9AA5B1&#x27; style=&#x27;font-size:10px&#x27;&gt;L625 L637&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="763" y="1370" width="644" height="21" as="geometry"/></mxCell><mxCell id="c121" value="• 剩余 ≤ 1 个半字（新字只半个有效时 ≤ 2）才收新字，同时决定 FIFO 弹不弹&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color=&#x27;#9AA5B1&#x27; style=&#x27;font-size:10px&#x27;&gt;L634&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="763" y="1397" width="644" height="21" as="geometry"/></mxCell><mxCell id="c122" value="• CIR = 槽 0、1 的解压版，和 IB 同一个沿锁存，也就是 IB 的队头&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color=&#x27;#9AA5B1&#x27; style=&#x27;font-size:10px&#x27;&gt;L874&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="763" y="1424" width="644" height="21" as="geometry"/></mxCell><mxCell id="c123" value="• 例：内存 [c.addi | lw 低半] [lw 高半 | c.mv] → CIR=c.addi，用 1 → CIR=lw（跨字），用 2 → CIR=c.mv" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="763" y="1451" width="644" height="21" as="geometry"/></mxCell><mxCell id="c124" value="• 最长同拍路径：hready → X stall → cir_use → 移位 → 叠加 → 预译码 → 寄存器堆读地址&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color=&#x27;#9AA5B1&#x27; style=&#x27;font-size:10px&#x27;&gt;L54&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="763" y="1478" width="644" height="21" as="geometry"/></mxCell><mxCell id="c125" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#6C8EBF;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1460" y="1303" width="680" height="183" as="geometry"/></mxCell><mxCell id="c126" value="⑥  预译码、解压与 uop" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontColor=#6C8EBF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1476" y="1311" width="648" height="24" as="geometry"/></mxCell><mxCell id="c127" value="• 预译码：从下一拍的 CIR 里提前抽出 rs1 / rs2，作寄存器堆读地址和 bypass 选择，省一拍&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color=&#x27;#9AA5B1&#x27; style=&#x27;font-size:10px&#x27;&gt;L734&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="1478" y="1343" width="644" height="21" as="geometry"/></mxCell><mxCell id="c128" value="• 它只是近似，不能用来判断 stall；正式译码仍在 X&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color=&#x27;#9AA5B1&#x27; style=&#x27;font-size:10px&#x27;&gt;L85-93&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="1478" y="1370" width="644" height="21" as="geometry"/></mxCell><mxCell id="c129" value="• 解压：16 bit → 32 bit，CIR 存的是解压后的指令；非法压缩码置 invalid&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color=&#x27;#9AA5B1&#x27; style=&#x27;font-size:10px&#x27;&gt;L844&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="1478" y="1397" width="644" height="21" as="geometry"/></mxCell><mxCell id="c130" value="• Zcmp push / pop：一条指令拆成多个 uop，X 用 uop_stall / uop_clear 控制&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color=&#x27;#9AA5B1&#x27; style=&#x27;font-size:10px&#x27;&gt;L838&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="1478" y="1424" width="644" height="21" as="geometry"/></mxCell><mxCell id="c131" value="• 不开 C 扩展时没有解压，IB 第 3 个槽和对齐逻辑都会被常量折叠掉&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color=&#x27;#9AA5B1&#x27; style=&#x27;font-size:10px&#x27;&gt;L810&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="1478" y="1451" width="644" height="21" as="geometry"/></mxCell><mxCell id="c132" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9AA5B1;strokeWidth=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="30" y="1537" width="680" height="183" as="geometry"/></mxCell><mxCell id="c133" value="时序对照（官方文档，总线无等待）" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontColor=#9AA5B1;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="46" y="1545" width="648" height="24" as="geometry"/></mxCell><mxCell id="c134" value="• 顺序 32 bit 指令每拍 1 条：拍 n 发地址 → 拍 n+2 X 执行" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="48" y="1577" width="644" height="21" as="geometry"/></mxCell><mxCell id="c135" value="• jal / jalr 2 拍；taken 分支 2 拍；BTB 预测对 1 拍、预测错 2 拍" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="48" y="1604" width="644" height="21" as="geometry"/></mxCell><mxCell id="c136" value="• 跳到不按字对齐的 32 bit 指令：再 +1 拍（要取两个字）" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="48" y="1631" width="644" height="21" as="geometry"/></mxCell><mxCell id="c137" value="• 总线等待 n 拍 → 取指晚 n 拍；FIFO / IB 里已有的指令可以掩盖一部分" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="48" y="1658" width="644" height="21" as="geometry"/></mxCell><mxCell id="c138" value="• 依据&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color=&#x27;#9AA5B1&#x27; style=&#x27;font-size:10px&#x27;&gt;doc/sections/instruction_timings.adoc&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="48" y="1685" width="644" height="21" as="geometry"/></mxCell><mxCell id="c139" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9AA5B1;strokeWidth=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="745" y="1537" width="680" height="200" as="geometry"/></mxCell><mxCell id="c140" value="与 curryGPU ifetch_top 对照" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontColor=#9AA5B1;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="761" y="1545" width="648" height="24" as="geometry"/></mxCell><mxCell id="c141" value="• fetch_addr ↔ ifetch_frontend 的 fetch_pc_q（每 warp 一个）" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="763" y="1577" width="644" height="21" as="geometry"/></mxCell><mxCell id="c142" value="• I 侧 AHB + 存储 ↔ ifetch_l0i / ifetch_l1i" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="763" y="1604" width="644" height="21" as="geometry"/></mxCell><mxCell id="c143" value="• FIFO + IB ↔ ifetch_ib；CIR ↔ IB 队头（decode 读的那条）" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="763" y="1631" width="644" height="21" as="geometry"/></mxCell><mxCell id="c144" value="• cir_use ↔ decode 的弹出；jump ↔ redirect" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="763" y="1658" width="644" height="21" as="geometry"/></mxCell><mxCell id="c145" value="• ctr_flush_pending ↔ epoch：Hazard3 单线程、按序返回，数在途个数就够；curryGPU 多 warp、可能乱序，用 epoch 判断过期" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="763" y="1685" width="644" height="38" as="geometry"/></mxCell><mxCell id="c146" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9AA5B1;strokeWidth=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="1460" y="1537" width="680" height="200" as="geometry"/></mxCell><mxCell id="c147" value="图例" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontColor=#9AA5B1;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1476" y="1545" width="648" height="24" as="geometry"/></mxCell><mxCell id="c148" value="" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="1480" y="1579" width="34" height="16" as="geometry"/></mxCell><mxCell id="c149" value="蓝色 = 组合步骤（F0 发地址、F4 预译码 / 解压）" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="1524" y="1577" width="300" height="20" as="geometry"/></mxCell><mxCell id="c150" value="" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="1480" y="1603" width="34" height="16" as="geometry"/></mxCell><mxCell id="c151" value="绿色 = 存储侧（总线、F1 收数据）" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="1524" y="1601" width="300" height="20" as="geometry"/></mxCell><mxCell id="c152" value="" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="1480" y="1627" width="34" height="16" as="geometry"/></mxCell><mxCell id="c153" value="紫色 = 队列（F2 FIFO、F3 IB）" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="1524" y="1625" width="300" height="20" as="geometry"/></mxCell><mxCell id="c154" value="" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1480" y="1651" width="34" height="16" as="geometry"/></mxCell><mxCell id="c155" value="黄色 owns = 这个小级拥有的寄存器" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="1524" y="1649" width="300" height="20" as="geometry"/></mxCell><mxCell id="c156" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F2933;strokeColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="1840" y="1585" width="34" height="4" as="geometry"/></mxCell><mxCell id="c157" value="黑粗杠 = 时钟沿（寄存器边界）" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="1884" y="1577" width="250" height="20" as="geometry"/></mxCell><mxCell id="c158" value="" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;strokeWidth=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="1840" y="1603" width="34" height="16" as="geometry"/></mxCell><mxCell id="c159" value="灰色虚线框 = 同一拍内组合完成" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="1884" y="1601" width="250" height="20" as="geometry"/></mxCell><mxCell id="c160" value="" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;strokeWidth=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="1840" y="1627" width="34" height="16" as="geometry"/></mxCell><mxCell id="c161" value="虚线小框 = 可选部件" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="1884" y="1625" width="250" height="20" as="geometry"/></mxCell><mxCell id="c162" value="事件通道颜色：红 = 跳转，橙 = cir_use，紫 = uop / BTB，蓝 = jump_target_rdy&lt;br&gt;画法参照 curryGPU subcore 目标流水线图（大流水线套小流水线）" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontColor=#777777;" vertex="1" parent="1"><mxGeometry x="1480" y="1679" width="640" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
