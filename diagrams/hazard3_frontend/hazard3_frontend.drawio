<mxfile host="app.diagrams.net"><diagram name="hazard3_frontend"><mxGraphModel dx="1800" dy="1000" grid="1" gridSize="10" page="1" pageWidth="2200" pageHeight="1130" math="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t1" value="Hazard3 取指前端 hazard3_frontend.v（F 级）内部结构" style="text;html=1;fontSize=18;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#000000;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1800" height="28" as="geometry"/></mxCell><mxCell id="t2" value="版本 Hazard3 v1.1.1（8af9929）   以 EXTENSION_C=1、2port 为例；BRANCH_PREDICTOR / PMP / DEBUG 可选（虚线）   对外接口：I 侧 AHB、X 级（cir / cir_use / jump）、寄存器堆读地址" style="text;html=1;fontSize=10;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="54" width="2200" height="18" as="geometry"/></mxCell><mxCell id="t3" value="官方流水线图里 F 只是一列，但它内部其实是一条小流水：地址相位 → 数据相位 → 预取 FIFO → 指令缓冲 → CIR。同一时刻可以有好几个字分别处在不同位置（见 ①）" style="text;html=1;fontSize=10;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="76" width="2200" height="18" as="geometry"/></mxCell><mxCell id="t4" value="L 数字 = hazard3_frontend.v 行号；core.v / decode.v 指 hazard3_core.v / hazard3_decode.v" style="text;html=1;fontSize=10;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="98" width="2200" height="18" as="geometry"/></mxCell><mxCell id="fe" value="" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fontSize=10;strokeColor=#000000;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="280" y="130" width="1600" height="640" as="geometry"/></mxCell><mxCell id="t5" value="hazard3_frontend   ×1" style="text;html=1;fontSize=12;align=right;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#000000;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1480" y="134" width="390" height="18" as="geometry"/></mxCell><mxCell id="v6" value="" style="endArrow=none;html=1;dashed=1;dashPattern=6 6;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="700" y="130" as="sourcePoint"/><mxPoint x="700" y="770" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v7" value="" style="endArrow=none;html=1;dashed=1;dashPattern=6 6;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1160" y="130" as="sourcePoint"/><mxPoint x="1160" y="770" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t8" value="拍 n · 地址相位&#xa;（组合逻辑，和 X 级同一拍）" style="text;html=1;fontSize=11;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#000000;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="290" y="150" width="400" height="34" as="geometry"/></mxCell><mxCell id="t9" value="拍 n+1 · 数据相位&#xa;（F 拍：总线数据回来）" style="text;html=1;fontSize=11;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#000000;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="710" y="150" width="440" height="34" as="geometry"/></mxCell><mxCell id="t10" value="拍 n+1 组合计算，末沿锁存 → 拍 n+2 交给 X&#xa;指令缓冲 + 解压 + CIR" style="text;html=1;fontSize=11;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#000000;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1170" y="150" width="700" height="34" as="geometry"/></mxCell><mxCell id="a_fa" value="fetch_addr / fetch_priv   寄存器   L304&#xa;取指地址，比 PC 超前，按整字 +4（L346）&#xa;跳转时：jump_target 对齐到字，&#xa;    若当拍地址已被接收再 +4（L327）&#xa;BTB 命中时：换成 btb_target（L343）" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fontSize=10;strokeColor=#000000;fillColor=#FFF2CC;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="295" y="200" width="390" height="110" as="geometry"/></mxCell><mxCell id="a_hold" value="mem_addr_hold   寄存器   L434&#xa;上一拍发出的地址没被接收（hready=0）&#xa;→ 本拍必须原样保持；jump_target_rdy = !hold（L401）" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fontSize=10;strokeColor=#000000;fillColor=#FFF2CC;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="295" y="325" width="390" height="75" as="geometry"/></mxCell><mxCell id="a_stall" value="fetch_stall   组合   L416&#xa;= fifo_full&#xa;|| fifo_almost_full &amp;&amp; pending_fetches ≠ 0&#xa;|| pending_fetches &gt; 1        （都用寄存器，见 ②）" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=10;strokeColor=#000000;fillColor=#FFFFFF;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="295" y="415" width="390" height="90" as="geometry"/></mxCell><mxCell id="a_mux" value="地址选择 mem_addr   组合   L385&#xa;优先级：hold &gt; jump &gt; debug 停取&#xa;        &gt; !fetch_stall 发 fetch_addr &gt; 不发&#xa;总是 32 bit、整字对齐（L381）" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=10;strokeColor=#000000;fillColor=#FFFFFF;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="295" y="520" width="390" height="105" as="geometry"/></mxCell><mxCell id="a_btb" value="BTB 1 项（可选 BRANCH_PREDICTOR）   L254&#xa;记住最近一次后向 taken 分支，命中则地址直接跳" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fontSize=10;strokeColor=#666666;fillColor=#FFFFFF;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;strokeWidth=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="295" y="640" width="390" height="60" as="geometry"/></mxCell><mxCell id="d_trk" value="总线在途跟踪   寄存器   L408、L452&#xa;pending_fetches 0..2：已发地址、还没回数据的个数&#xa;ctr_flush_pending：跳转那一拍仍在途的个数，&#xa;    这些数据回来后直接丢弃（L437）&#xa;mem_data_hwvld：本字哪一半有效&#xa;    （跳到奇数半字时，低半无效）" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fontSize=10;strokeColor=#000000;fillColor=#FFF2CC;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="715" y="200" width="430" height="120" as="geometry"/></mxCell><mxCell id="d_pmp" value="PMP X 检查 / 断点比较（可选）   L500&#xa;和数据相位并行；失败当作总线错误随数据走" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fontSize=10;strokeColor=#666666;fillColor=#FFFFFF;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;strokeWidth=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="715" y="335" width="430" height="55" as="geometry"/></mxCell><mxCell id="d_fifo" value="预取 FIFO   2 项 × 32 bit   寄存器   L149&#xa;每项附带：valid_hw[1:0]  err  break  predbranch&#xa;推入：数据回来，且没能直接进缓冲（L425）&#xa;弹出：缓冲有空位 cir_room_for_fetch（L635）&#xa;跳转 jump_now：全部清空（L212）" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fontSize=10;strokeColor=#000000;fillColor=#FFF2CC;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="715" y="405" width="430" height="130" as="geometry"/></mxCell><mxCell id="d_byp" value="旁路选择 fetch_data   组合   L592&#xa;FIFO 空 → 直接用总线数据（见 ③）&#xa;否则 → 用 FIFO 头" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=10;strokeColor=#000000;fillColor=#FFFFFF;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="715" y="550" width="430" height="75" as="geometry"/></mxCell><mxCell id="b_shift" value="移位 buf_shifted   组合   L625&#xa;按 cir_use（X 本拍用掉 0/1/2 个半字）&#xa;把还没用的半字往下移" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=10;strokeColor=#000000;fillColor=#FFFFFF;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1175" y="200" width="335" height="85" as="geometry"/></mxCell><mxCell id="b_ovl" value="叠加新字 buf_shifted_plus_fetch   L637&#xa;剩余 ≤1 个半字（新字只有半个有效时 ≤2）&#xa;    才收新字 → cir_room_for_fetch&#xa;跳转：清空；若 cir_flush_behind，&#xa;    保留当前指令（L648，见 ⑤）" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=10;strokeColor=#000000;fillColor=#FFFFFF;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1175" y="300" width="335" height="130" as="geometry"/></mxCell><mxCell id="b_next" value="next_instr = 下一拍的槽 0、1   L701&#xa;（还没锁存，组合给出）" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=10;strokeColor=#000000;fillColor=#FFFFFF;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1175" y="445" width="335" height="55" as="geometry"/></mxCell><mxCell id="b_pre" value="寄存器号预译码   组合   L734&#xa;predecode_rs1/rs2_coarse → 寄存器堆读地址&#xa;predecode_rs1/rs2_fine → core 的 bypass 选择&#xa;比 X 级正式译码早一拍" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=10;strokeColor=#000000;fillColor=#FFFFFF;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1175" y="515" width="335" height="110" as="geometry"/></mxCell><mxCell id="b_buf" value="指令缓冲 buf_contents   寄存器   L589&#xa;3 槽 × (16 bit 指令 + 4 bit 元数据)&#xa;buf_level 0..3：有效半字数&#xa;槽 0、1 = CIR 的原始内容（cir_raw）&#xa;槽 2：让 CIR 可以不按字对齐（C 扩展）" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fontSize=10;strokeColor=#000000;fillColor=#FFF2CC;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1530" y="200" width="340" height="150" as="geometry"/></mxCell><mxCell id="b_dec" value="解压 hazard3_instr_decompress   L844&#xa;16 bit → 32 bit；Zcmp push/pop 拆成 uop&#xa;（uop 计数器在解压模块里）" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=10;strokeColor=#000000;fillColor=#FFFFFF;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1530" y="445" width="340" height="80" as="geometry"/></mxCell><mxCell id="b_cir" value="CIR   寄存器   L874&#xa;cir（已解压的 32 bit）  cir_vld  cir_is_32bit&#xa;uop 标志：is_uop / nonfinal / atomic&#xa;和 buf_contents 同一个时钟沿更新&#xa;（CIR 不是另一份指令，是槽 0、1 的解压版）" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fontSize=10;strokeColor=#000000;fillColor=#FFF2CC;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1530" y="540" width="340" height="120" as="geometry"/></mxCell><mxCell id="i_jump" value="X 级：jal / 分支 taken&#xa;M 级：trap 进入&#xa;→ jump_target / jump_target_vld&#xa;   core.v:1376" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fontSize=10;strokeColor=#666666;fillColor=#FFFFFF;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;strokeWidth=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="20" y="200" width="240" height="110" as="geometry"/></mxCell><mxCell id="i_btb" value="X 级：btb_set / btb_clear&#xa;（只有开分支预测时）" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fontSize=10;strokeColor=#666666;fillColor=#FFFFFF;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;strokeWidth=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="20" y="330" width="240" height="70" as="geometry"/></mxCell><mxCell id="o_rf" value="寄存器堆读端口（core）&#xa;读地址 = predecode_rs*_coarse&#xa;拍 n+2 开始 X 拿到读值" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fontSize=10;strokeColor=#666666;fillColor=#FFFFFF;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;strokeWidth=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="1910" y="680" width="250" height="80" as="geometry"/></mxCell><mxCell id="o_dec" value="X 级 decode（decode.v）&#xa;读 cir / cir_vld&#xa;算出 cir_use（decode.v:142）&#xa;和跳转请求" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fontSize=10;strokeColor=#666666;fillColor=#FFFFFF;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;strokeWidth=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="1910" y="560" width="250" height="100" as="geometry"/></mxCell><mxCell id="ahb" value="I 侧 AHB 总线（2port 时独立；1port 时和 load/store 仲裁）&#xa;拍 n 地址相位：HADDR / HTRANS ← mem_addr、mem_addr_vld          拍 n+1 数据相位：HRDATA / HREADY → mem_data、mem_data_vld&#xa;hready 拉低会插等待：地址要保持（mem_addr_hold），数据晚到；pending_fetches 最多 2" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fontSize=10;strokeColor=#666666;fillColor=#FFFFFF;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;strokeWidth=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="295" y="800" width="850" height="75" as="geometry"/></mxCell><mxCell id="e1" value="" style="endArrow=block;endSize=5;html=1;strokeColor=#CC0000;fontSize=9;fontColor=#CC0000;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeWidth=2.5;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.4;entryDx=0;entryDy=0;" edge="1" parent="1" source="i_jump" target="a_mux"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="275" y="288"/><mxPoint x="275" y="562"/></Array></mxGeometry></mxCell><mxCell id="e2" value="" style="endArrow=block;endSize=5;html=1;strokeColor=#000000;fontSize=9;fontColor=#000000;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=0.9;exitY=1;exitDx=0;exitDy=0;entryX=0.9;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="a_fa" target="a_mux"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="646" y="512"/></Array></mxGeometry></mxCell><mxCell id="e3" value="" style="endArrow=block;endSize=5;html=1;strokeColor=#000000;fontSize=9;fontColor=#000000;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="a_hold" target="a_mux"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="" style="endArrow=block;endSize=5;html=1;strokeColor=#000000;fontSize=9;fontColor=#000000;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" parent="1" source="a_stall" target="a_mux"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="mem_addr" style="endArrow=block;endSize=5;html=1;strokeColor=#000000;fontSize=9;fontColor=#000000;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.15;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="a_mux" target="ahb"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="mem_data" style="endArrow=block;endSize=5;html=1;strokeColor=#000000;fontSize=9;fontColor=#000000;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=0.65;exitY=0;exitDx=0;exitDy=0;entryX=0.3;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="ahb" target="d_byp"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="" style="endArrow=block;endSize=5;html=1;strokeColor=#000000;fontSize=9;fontColor=#000000;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=0.9;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=0.88;entryDx=0;entryDy=0;" edge="1" parent="1" source="ahb" target="d_fifo"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1060" y="785"/><mxPoint x="1152" y="785"/><mxPoint x="1152" y="519"/></Array></mxGeometry></mxCell><mxCell id="e8" value="" style="endArrow=block;endSize=5;html=1;strokeColor=#000000;fontSize=9;fontColor=#000000;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=0.6;exitY=1;exitDx=0;exitDy=0;entryX=0.6;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="d_fifo" target="d_byp"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e9" value="" style="endArrow=block;endSize=5;html=1;strokeColor=#000000;fontSize=9;fontColor=#000000;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="d_byp" target="b_ovl"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1167" y="587"/><mxPoint x="1167" y="397"/></Array></mxGeometry></mxCell><mxCell id="e10" value="" style="endArrow=block;endSize=5;html=1;strokeColor=#CC0000;fontSize=9;fontColor=#CC0000;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeWidth=2.5;" edge="1" parent="1" source="b_shift" target="b_ovl"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e11" value="" style="endArrow=block;endSize=5;html=1;strokeColor=#CC0000;fontSize=9;fontColor=#CC0000;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeWidth=2.5;" edge="1" parent="1" source="b_ovl" target="b_next"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e12" value="" style="endArrow=block;endSize=5;html=1;strokeColor=#CC0000;fontSize=9;fontColor=#CC0000;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeWidth=2.5;" edge="1" parent="1" source="b_next" target="b_pre"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e13" value="" style="endArrow=block;endSize=5;html=1;strokeColor=#CC0000;fontSize=9;fontColor=#CC0000;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeWidth=2.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="b_next" target="b_dec"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e14" value="" style="endArrow=block;endSize=5;html=1;strokeColor=#CC0000;fontSize=9;fontColor=#CC0000;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeWidth=2.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="b_dec" target="b_cir"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e15" value="" style="endArrow=block;endSize=5;html=1;strokeColor=#000000;fontSize=9;fontColor=#000000;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="b_ovl" target="b_buf"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e16" value="" style="endArrow=block;endSize=5;html=1;strokeColor=#888888;fontSize=9;fontColor=#888888;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=0;dashed=1;dashPattern=6 4;exitX=0;exitY=0.25;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b_buf" target="b_shift"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1520" y="237"/><mxPoint x="1520" y="242"/></Array></mxGeometry></mxCell><mxCell id="e17" value="rs1 / rs2" style="endArrow=block;endSize=5;html=1;strokeColor=#CC0000;fontSize=9;fontColor=#CC0000;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeWidth=2.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b_pre" target="o_rf"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1342" y="720"/></Array></mxGeometry></mxCell><mxCell id="e18" value="cir" style="endArrow=block;endSize=5;html=1;strokeColor=#000000;fontSize=9;fontColor=#000000;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b_cir" target="o_dec"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e19" value="cir_use（同拍，可能依赖 hready）" style="endArrow=block;endSize=5;html=1;strokeColor=#CC0000;fontSize=9;fontColor=#CC0000;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeWidth=2.5;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.045;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="o_dec" target="b_shift"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2035" y="118"/><mxPoint x="1190" y="118"/></Array></mxGeometry></mxCell><mxCell id="e20" value="fifo_pop" style="endArrow=block;endSize=5;html=1;strokeColor=#CC0000;fontSize=9;fontColor=#CC0000;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeWidth=2.5;exitX=0;exitY=0.25;exitDx=0;exitDy=0;entryX=1;entryY=0.35;entryDx=0;entryDy=0;" edge="1" parent="1" source="b_ovl" target="d_fifo"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1150" y="332"/><mxPoint x="1150" y="450"/></Array></mxGeometry></mxCell><mxCell id="e21" value="" style="endArrow=block;endSize=5;html=1;strokeColor=#000000;fontSize=9;fontColor=#000000;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=1;exitY=0.2;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="i_jump" target="d_trk"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="268" y="222"/><mxPoint x="268" y="192"/><mxPoint x="705" y="192"/><mxPoint x="705" y="236"/></Array></mxGeometry></mxCell><mxCell id="t11" value="jump_target 同拍直接驱动地址&#xa;jump_now 同时通知在途跟踪" style="text;html=1;fontSize=9;align=right;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#CC0000;" vertex="1" parent="1"><mxGeometry x="20" y="420" width="245" height="34" as="geometry"/></mxCell><mxCell id="e22" value="" style="endArrow=block;endSize=5;html=1;strokeColor=#888888;fontSize=9;fontColor=#888888;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=0;dashed=1;dashPattern=6 4;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="a_fa" target="a_btb"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="287" y="255"/><mxPoint x="287" y="670"/></Array></mxGeometry></mxCell><mxCell id="e23" value="" style="endArrow=block;endSize=5;html=1;strokeColor=#000000;fontSize=9;fontColor=#000000;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="i_btb" target="a_btb"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="140" y="688"/></Array></mxGeometry></mxCell><mxCell id="lg" value="图例&#xa;&#xa;黄底方框      寄存器（状态）&#xa;白底圆角框    组合逻辑&#xa;虚线框        frontend 之外，或可选&#xa;&#xa;红粗箭头      同拍组合路径（见 ④）&#xa;黑细箭头      数据 / 控制&#xa;灰虚箭头      寄存器输出（上一拍的值）" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fontSize=10;strokeColor=#000000;fillColor=#FFFFFF;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="20" y="900" width="250" height="200" as="geometry"/></mxCell><mxCell id="tl" value="例：jal 之后的取指（无总线等待；文档 jal = 2 拍）&#xa;&#xa;拍  地址相位      数据相位          X 级&#xa;0   T（目标）     -                 jal，发跳转&#xa;1   T+4           T → 缓冲 + CIR    气泡（缓冲被清空）&#xa;2   T+8           T+4               执行 T&#xa;&#xa;jump_target 当拍就作为地址发出，&#xa;所以只损失 1 拍。" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fontSize=10;strokeColor=#000000;fillColor=#FFFFFF;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;strokeWidth=1;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="290" y="900" width="560" height="200" as="geometry"/></mxCell><mxCell id="co0" value="① 隐藏的小流水&#xa;同一时刻 F 里可以有：1 个地址相位 + 1 个数据相位（pending_fetches ≤ 2）、FIFO 里 2 个字、缓冲里最多 3 个半字。和 X 级「只有 0 或 1 条指令」不同，这里有好几个不同地址的字同时处在不同位置。" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fontSize=10;strokeColor=#000000;fillColor=#FFFFFF;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="870" y="900" width="425" height="98" as="geometry"/></mxCell><mxCell id="co1" value="② 不让 hready 组合地影响发地址&#xa;fetch_stall 用寄存器版的 pending_fetches（L413 注释）。代价：要按「最坏还有一个在途」预留空间，所以 FIFO 至少 2 项才能满速取指（L119）。" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fontSize=10;strokeColor=#000000;fillColor=#FFFFFF;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1305" y="900" width="425" height="98" as="geometry"/></mxCell><mxCell id="co2" value="③ FIFO 旁路&#xa;FIFO 空且缓冲有空位时，总线数据当拍直接进缓冲和 CIR，不进 FIFO（L425、L594）。无等待时：拍 n 发地址 → 拍 n+1 数据进 CIR → 拍 n+2 X 译码。" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fontSize=10;strokeColor=#000000;fillColor=#FFFFFF;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1740" y="900" width="425" height="98" as="geometry"/></mxCell><mxCell id="co3" value="④ 最长的同拍路径（红色）&#xa;hready → X 的 stall → cir_use → 移位 → 叠加 → next_instr → 预译码 → 寄存器堆读地址；以及 → 解压 → CIR、→ fifo_pop。接口注释明确允许 cir_use 依赖 hready（L54）。" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fontSize=10;strokeColor=#CC0000;fillColor=#FFFFFF;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="870" y="1006" width="425" height="98" as="geometry"/></mxCell><mxCell id="co4" value="⑤ 跳转与 CIR 保留&#xa;jump_target 当拍驱动地址（L391），jump_now 当拍清空 FIFO 和缓冲；已发出未回来的请求由 ctr_flush_pending 记数后丢弃。X 被 stall 却发了跳转时（stall 依赖 hready，挡不住），cir_flush_behind 保留当前指令，只冲刷后面的（L648，decode.v:146）。" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fontSize=10;strokeColor=#CC0000;fillColor=#FFFFFF;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1305" y="1006" width="425" height="98" as="geometry"/></mxCell><mxCell id="co5" value="⑥ 没有组合环&#xa;jump_target_rdy = !mem_addr_hold 来自寄存器（L401），X 的跳转不会反过来依赖本拍 hready。mem_addr_rdy、mem_data_vld 也不进入任何组合输出（L19 接口约定）。" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fontSize=10;strokeColor=#000000;fillColor=#FFFFFF;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1740" y="1006" width="425" height="98" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
