<mxfile host="app.diagrams.net"><diagram name="hazard3_x"><mxGraphModel dx="1800" dy="1000" grid="1" gridSize="10" page="1" pageWidth="2160" pageHeight="1987" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Hazard3 X 级：一拍里完成 译码 → 取操作数 → 执行 → 决策（hazard3_decode + hazard3_core）" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontColor=#1F2933;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="1800" height="30" as="geometry"/></mxCell><mxCell id="c2" value="Hazard3 v1.1.1（8af9929）· 以 RV32IMC、2port 为例 · 蓝 = 指令通路，橙 = 数据通路，红 = 两者的交叉点（C1–C6）· 下方卡片里灰色小字是源码位置" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="2100" height="20" as="geometry"/></mxCell><mxCell id="ahb" value="存储侧接口 · D 侧 AHB5 → 数据存储&lt;br&gt;&lt;font style=&#x27;font-size:9px;font-weight:normal&#x27;&gt;地址相位 HADDR / HWRITE / HSIZE ← X3（load / store 地址）      数据相位 HRDATA / HREADY / HRESP → M&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1509" y="72" width="621" height="50" as="geometry"/></mxCell><mxCell id="c3" value="F · 取指&lt;br&gt;&lt;font style=&#x27;font-size:9px;font-weight:normal&#x27;&gt;只画与 X 相关的部分&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEEEEE;strokeColor=#666666;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="140" width="200" height="40" as="geometry"/></mxCell><mxCell id="c4" value="X · 译码 + 执行   hazard3_decode + hazard3_core&lt;br&gt;&lt;font style=&#x27;font-size:9px;font-weight:normal&#x27;&gt;一个大流水级，只占一拍：X0 → X3 是同一拍里的四步组合逻辑；只有乘除法 / AMO 会让 X 原地停住多拍&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEEEEE;strokeColor=#666666;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="270" y="140" width="1620" height="40" as="geometry"/></mxCell><mxCell id="c5" value="M · 访存 + 写回&lt;br&gt;&lt;font style=&#x27;font-size:9px;font-weight:normal&#x27;&gt;只画与 X 相关的部分&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEEEEE;strokeColor=#666666;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1930" y="140" width="200" height="40" as="geometry"/></mxCell><mxCell id="c6" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F2933;strokeColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="246" y="140" width="8" height="616" as="geometry"/></mxCell><mxCell id="c7" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F2933;strokeColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="1906" y="140" width="8" height="616" as="geometry"/></mxCell><mxCell id="c8" value="同一拍：X0 → X3 组合完成，末沿锁存 xm_*；数据总线地址相位在这一拍发出" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;dashed=1;strokeWidth=1;verticalAlign=bottom;align=center;spacingBottom=-16;fontSize=10;fontColor=#777777;" vertex="1" parent="1"><mxGeometry x="258" y="188" width="1640" height="576" as="geometry"/></mxCell><mxCell id="c9" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#6C8EBF;strokeWidth=1.5;dashed=1;" vertex="1" parent="1"><mxGeometry x="270" y="196" width="380" height="560" as="geometry"/></mxCell><mxCell id="c10" value="X0 · 译码" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#6C8EBF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="270" y="202" width="380" height="18" as="geometry"/></mxCell><mxCell id="c11" value="指令通路 · decode.v" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="270" y="220" width="380" height="16" as="geometry"/></mxCell><mxCell id="x0_cir" value="读 CIR&lt;br&gt;&lt;font style=&#x27;font-size:9px;font-weight:normal&#x27;&gt;展开好的 32 bit 指令 + cir_vld&lt;br&gt;CIR 空或只有半条 → starved，本拍是气泡&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="284" y="246" width="352" height="56" as="geometry"/></mxCell><mxCell id="x0_dec" value="主译码 case(opcode)&lt;br&gt;&lt;font style=&#x27;font-size:9px;font-weight:normal&#x27;&gt;→ aluop · 操作数来源 alusrc_a / b · 立即数&lt;br&gt;→ memop · branchcond · rs1 / rs2 / rd · csr · 异常&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="284" y="324" width="352" height="56" as="geometry"/></mxCell><mxCell id="x0_gate" value="门控&lt;br&gt;&lt;font style=&#x27;font-size:9px;font-weight:normal&#x27;&gt;starved / 非法指令 / 取指错误 / CIR lock&lt;br&gt;→ 清掉 rd、memop、branchcond，或换成异常&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="284" y="402" width="352" height="56" as="geometry"/></mxCell><mxCell id="x0_pc" value="PC 与 cir_use&lt;br&gt;&lt;font style=&#x27;font-size:9px;font-weight:normal&#x27;&gt;不停时 PC +2 / +4（预测分支时换成 BTB 目标）&lt;br&gt;cir_use 同拍回送 F：用掉 0 / 1 / 2 个半字&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="284" y="480" width="352" height="56" as="geometry"/></mxCell><mxCell id="c12" value="owns&lt;br&gt;&lt;font style=&#x27;font-size:9px;font-weight:normal&#x27;&gt;pc（当前指令地址）· cir_lock_prev&lt;br&gt;lspair_phase（Zilsd，可选）&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="284" y="656" width="352" height="88" as="geometry"/></mxCell><mxCell id="c13" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#D79B00;strokeWidth=1.5;dashed=1;" vertex="1" parent="1"><mxGeometry x="683" y="196" width="380" height="560" as="geometry"/></mxCell><mxCell id="c14" value="X1 · 取操作数" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#D79B00;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="683" y="202" width="380" height="18" as="geometry"/></mxCell><mxCell id="c15" value="数据通路 · core.v:494-580" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="683" y="220" width="380" height="16" as="geometry"/></mxCell><mxCell id="x1_rf" value="RF 读数据 rdata1 / rdata2&lt;br&gt;&lt;font style=&#x27;font-size:9px;font-weight:normal&#x27;&gt;读地址在 F 那一拍由预译码给出，沿后读出&lt;br&gt;X 停住时改用 d_rs1 / d_rs2 重读&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="697" y="246" width="352" height="56" as="geometry"/></mxCell><mxCell id="x1_byp" value="bypass 三选一&lt;br&gt;&lt;font style=&#x27;font-size:9px;font-weight:normal&#x27;&gt;xm_result（M 级的结果）/ mw_result（上拍写回）/ rdata&lt;br&gt;选择信号上一拍就比好了，不在关键路径上&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="697" y="324" width="352" height="56" as="geometry"/></mxCell><mxCell id="x1_mux" value="操作数选择&lt;br&gt;&lt;font style=&#x27;font-size:9px;font-weight:normal&#x27;&gt;op_a = rs1 或 PC&lt;br&gt;op_b = rs2 或 立即数&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="697" y="402" width="352" height="56" as="geometry"/></mxCell><mxCell id="c16" value="owns&lt;br&gt;&lt;font style=&#x27;font-size:9px;font-weight:normal&#x27;&gt;x_rs1/rs2_select_regs_xm_mw（bypass 选择）&lt;br&gt;d_rs1/rs2_predecoded&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="697" y="656" width="352" height="88" as="geometry"/></mxCell><mxCell id="c17" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#D79B00;strokeWidth=1.5;dashed=1;" vertex="1" parent="1"><mxGeometry x="1096" y="196" width="380" height="560" as="geometry"/></mxCell><mxCell id="c18" value="X2 · 执行" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#D79B00;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1096" y="202" width="380" height="18" as="geometry"/></mxCell><mxCell id="c19" value="数据通路 · 几个单元同一拍并行" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="1096" y="220" width="380" height="16" as="geometry"/></mxCell><mxCell id="x2_alu" value="ALU&lt;br&gt;&lt;font style=&#x27;font-size:9px;font-weight:normal&#x27;&gt;加减 · 逻辑 · 移位 · 比较 · Zba / Zbb / Zbs&lt;br&gt;jal / jalr：算链接地址 PC+2/4；store：透传 rs2&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1110" y="246" width="352" height="56" as="geometry"/></mxCell><mxCell id="x2_addr" value="地址加法器 x_addr_sum&lt;br&gt;&lt;font style=&#x27;font-size:9px;font-weight:normal&#x27;&gt;(rs1 或 PC) + 偏移&lt;br&gt;→ load / store 地址，以及跳转 / 分支目标&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1110" y="316" width="352" height="56" as="geometry"/></mxCell><mxCell id="x2_cmp" value="分支比较&lt;br&gt;&lt;font style=&#x27;font-size:9px;font-weight:normal&#x27;&gt;FAST_BRANCHCMP=1：独立比较器&lt;br&gt;否则用 ALU 的比较结果&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1110" y="386" width="352" height="56" as="geometry"/></mxCell><mxCell id="x2_md" value="乘除法（多拍）&lt;br&gt;&lt;font style=&#x27;font-size:9px;font-weight:normal&#x27;&gt;顺序电路逐位迭代，div 约 18 拍&lt;br&gt;没算完 → X 停住；MUL_FAST 时 mul 1 拍&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1110" y="456" width="352" height="56" as="geometry"/></mxCell><mxCell id="x2_csr" value="CSR 读写&lt;br&gt;&lt;font style=&#x27;font-size:9px;font-weight:normal&#x27;&gt;在 X 里读写 CSR 文件&lt;br&gt;写 PMP / 触发器等 → 要求重新取指&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1110" y="526" width="352" height="56" as="geometry"/></mxCell><mxCell id="c20" value="owns&lt;br&gt;&lt;font style=&#x27;font-size:9px;font-weight:normal&#x27;&gt;CSR 文件（hazard3_csr）&lt;br&gt;乘除法内部状态 · x_muldiv_posted&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1110" y="656" width="352" height="88" as="geometry"/></mxCell><mxCell id="c21" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#B85450;strokeWidth=1.5;dashed=1;" vertex="1" parent="1"><mxGeometry x="1509" y="196" width="380" height="560" as="geometry"/></mxCell><mxCell id="c22" value="X3 · 决策与出口" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#B85450;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1509" y="202" width="380" height="18" as="geometry"/></mxCell><mxCell id="c23" value="指令 ↔ 数据交叉 · core.v:409-490, 905-950, 1113" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="1509" y="220" width="380" height="16" as="geometry"/></mxCell><mxCell id="x3_stall" value="停顿 x_stall&lt;br&gt;&lt;font style=&#x27;font-size:9px;font-weight:normal&#x27;&gt;M 停 · trap · load-use · 乘除法 · AMO · fence&lt;br&gt;· 数据地址未被接收 · 跳转未就绪 · 独占冲突&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1523" y="246" width="352" height="56" as="geometry"/></mxCell><mxCell id="x3_jump" value="跳转请求 → F&lt;br&gt;&lt;font style=&#x27;font-size:9px;font-weight:normal&#x27;&gt;jal / jalr / taken 分支（不依赖未回来的 load）&lt;br&gt;目标 = x_addr_sum，同拍送进 F0&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1523" y="316" width="352" height="56" as="geometry"/></mxCell><mxCell id="x3_bus" value="访存地址相位 → 数据总线&lt;br&gt;&lt;font style=&#x27;font-size:9px;font-weight:normal&#x27;&gt;load / store 地址 = x_addr_sum&lt;br&gt;不对齐 / PMP 失败 → 不发，改报异常&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1523" y="386" width="352" height="56" as="geometry"/></mxCell><mxCell id="x3_exc" value="异常 x_except&lt;br&gt;&lt;font style=&#x27;font-size:9px;font-weight:normal&#x27;&gt;断点 &amp;gt; 跳转不对齐 &amp;gt; CSR 非法 &amp;gt; 访存不对齐&lt;br&gt;&amp;gt; PMP &amp;gt; 重新取指 &amp;gt; 译码异常；在 M 才进 trap&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1523" y="456" width="352" height="56" as="geometry"/></mxCell><mxCell id="x3_res" value="结果选择 → xm_result&lt;br&gt;&lt;font style=&#x27;font-size:9px;font-weight:normal&#x27;&gt;CSR 读值 &amp;gt; AMO &amp;gt; 快速乘 &amp;gt; 乘除法 &amp;gt; ALU&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1523" y="526" width="352" height="43" as="geometry"/></mxCell><mxCell id="c24" value="owns&lt;br&gt;&lt;font style=&#x27;font-size:9px;font-weight:normal&#x27;&gt;x_amo_phase（AMO 状态机，可选）&lt;br&gt;prev_instr_was_32_bit&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1523" y="656" width="352" height="88" as="geometry"/></mxCell><mxCell id="c25" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;strokeWidth=1.5;dashed=1;" vertex="1" parent="1"><mxGeometry x="30" y="196" width="200" height="560" as="geometry"/></mxCell><mxCell id="c26" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;strokeWidth=1.5;dashed=1;" vertex="1" parent="1"><mxGeometry x="1930" y="196" width="200" height="560" as="geometry"/></mxCell><mxCell id="f_cir" value="IB / CIR&lt;br&gt;&lt;font style=&#x27;font-size:9px;font-weight:normal&#x27;&gt;展开好的指令&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="44" y="216" width="172" height="43" as="geometry"/></mxCell><mxCell id="f_pre" value="预译码 rs1 / rs2&lt;br&gt;&lt;font style=&#x27;font-size:9px;font-weight:normal&#x27;&gt;→ RF 读地址&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="44" y="289" width="172" height="43" as="geometry"/></mxCell><mxCell id="rf" value="寄存器堆 RF&lt;br&gt;&lt;font style=&#x27;font-size:9px;font-weight:normal&#x27;&gt;同步读：F 给地址，X 拿数据&lt;br&gt;M 写回&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="44" y="366" width="172" height="56" as="geometry"/></mxCell><mxCell id="f_f0" value="F0 地址选择&lt;br&gt;&lt;font style=&#x27;font-size:9px;font-weight:normal&#x27;&gt;接收 jump&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="44" y="496" width="172" height="43" as="geometry"/></mxCell><mxCell id="m_dph" value="数据相位&lt;br&gt;&lt;font style=&#x27;font-size:9px;font-weight:normal&#x27;&gt;load 数据回来&lt;br&gt;hready=0 → m_stall&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1944" y="216" width="172" height="56" as="geometry"/></mxCell><mxCell id="m_trap" value="trap 进入&lt;br&gt;&lt;font style=&#x27;font-size:9px;font-weight:normal&#x27;&gt;→ jump，优先于 X&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1944" y="302" width="172" height="43" as="geometry"/></mxCell><mxCell id="m_wb" value="写回&lt;br&gt;&lt;font style=&#x27;font-size:9px;font-weight:normal&#x27;&gt;mw_rd / mw_result&lt;br&gt;→ RF，也给 bypass&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1944" y="375" width="172" height="56" as="geometry"/></mxCell><mxCell id="e27" value="CIR" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;fontColor=#333333;strokeWidth=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="f_cir" target="x0_cir"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;fontColor=#333333;strokeWidth=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY