<mxfile host="app.diagrams.net"><diagram name="fml_ifetch_partition"><mxGraphModel dx="1800" dy="1000" grid="1" gridSize="10" page="1" pageWidth="2400" pageHeight="1300" math="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t1" value="curryGPU 取指子系统 ifetch_top   →   FML 模块与 task 切分（草案）" style="text;html=1;fontSize=17;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#000000;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="30" width="1600" height="26" as="geometry"/></mxCell><mxCell id="t2" value="参数（与 RTL 相同）   Subcores=4   WarpsPerSubcore=12   Instr=128b   Line=1024b=8 instr   L0I=64 行全相联 / subcore   L1I=4 way × 128 set   MissQ=48+16   IB=8/warp   Dispatch=2 instr/拍   FillBeat=256b × 4   时钟=SM 核心时钟（一个 fml::Clock）" style="text;html=1;fontSize=9;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="64" width="2300" height="16" as="geometry"/></mxCell><mxCell id="t3" value="FML 层次   Sm → Ifetch ×1 → { Frontend ×4（含 warp 状态、取指仲裁、L0I）,  Ib ×4,  L1i ×1（含 tag / data / miss queue / 预取窗口） };   上游 subcore_top ×4（S1.decode、S2.issue）、sm_top cta_dispatch；下游 lsu_top 指令 TLB、L2 访存出口" style="text;html=1;fontSize=9;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="84" width="2300" height="16" as="geometry"/></mxCell><mxCell id="t4" value="访问模式   &amp;T = 读写者写之前的值（读者排在写者之前）     &amp;&#x27;latest T = 读写者写完之后的值（读者排在写者之后）     每个位置只有一个版本（FML 决定 D2.12），两种读法都建立先后，只是方向相反     &amp;mut T = 写（每个状态只有一个写者）。下图的列 = 由访问模式推导出的一个时钟沿内的先后层次，不是手工指定的顺序" style="text;html=1;fontSize=9;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="104" width="2300" height="16" as="geometry"/></mxCell><mxCell id="t5" value="依据   ifetch_top.drawio（curryGPU docs/design/uarch）；fr_ready 组合式 ifetch_l1i.v:322；redirect 同拍参与 lookup_response_live ifetch_frontend.v:251；IB 同拍推送/弹出/旁路 ifetch_ib.v:45-50、flush ifetch_ib.v:182" style="text;html=1;fontSize=9;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="124" width="2300" height="16" as="geometry"/></mxCell><mxCell id="big" value="" style="rounded=0;whiteSpace=wrap;html=1;fontSize=9;strokeColor=#000000;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="245" y="150" width="1865" height="860" as="geometry"/></mxCell><mxCell id="t6" value="Ifetch      FML module   ×1 per SM" style="text;html=1;fontSize=11;align=right;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#000000;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1610" y="154" width="490" height="16" as="geometry"/></mxCell><mxCell id="v7" value="" style="endArrow=none;html=1;dashed=1;dashPattern=6 6;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="760" y="150" as="sourcePoint"/><mxPoint x="760" y="1010" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v8" value="" style="endArrow=none;html=1;dashed=1;dashPattern=6 6;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1460" y="150" as="sourcePoint"/><mxPoint x="1460" y="1010" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t9" value="层 0&#xa;先写同拍请求的 task" style="text;html=1;fontSize=10;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#000000;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="265" y="172" width="480" height="30" as="geometry"/></mxCell><mxCell id="t10" value="层 1&#xa;Frontend.cycle ×4（读层 0 的 &amp;&#x27;latest 结果）" style="text;html=1;fontSize=10;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#000000;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="775" y="172" width="670" height="30" as="geometry"/></mxCell><mxCell id="t11" value="层 2&#xa;寄存器更新 task（读层 1 的 &amp;&#x27;latest 请求）" style="text;html=1;fontSize=10;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#000000;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1475" y="172" width="620" height="30" as="geometry"/></mxCell><mxCell id="s2" value="subcore_top ×4   S2.issue&#xa;分支状态机 Redirect 拍&#xa;写 RedirectReq（&amp;mut）&#xa;sm_top 4→1 仲裁后每拍 1 个" style="rounded=0;whiteSpace=wrap;html=1;fontSize=9;strokeColor=#000000;fillColor=#FFFFFF;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;strokeWidth=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="20" y="215" width="205" height="92" as="geometry"/></mxCell><mxCell id="s1" value="subcore_top ×4   S1.decode&#xa;读 IbView.head_instr（&amp;，上一拍）&#xa;写 PopReq（&amp;mut）" style="rounded=0;whiteSpace=wrap;html=1;fontSize=9;strokeColor=#000000;fillColor=#FFFFFF;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;strokeWidth=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="20" y="330" width="205" height="80" as="geometry"/></mxCell><mxCell id="cta" value="sm_top   cta_dispatch&#xa;LaunchRetire&#xa;launch / retire / exit_mask" style="rounded=0;whiteSpace=wrap;html=1;fontSize=9;strokeColor=#CC0000;fillColor=#FFFFFF;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;strokeWidth=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="20" y="435" width="205" height="80" as="geometry"/></mxCell><mxCell id="t12" value="⑤ 时序待核" style="text;html=1;fontSize=9;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#CC0000;" vertex="1" parent="1"><mxGeometry x="20" y="520" width="205" height="16" as="geometry"/></mxCell><mxCell id="tlb" value="lsu_top   sm_tlb&#xa;指令 TLB（翻译请求 / 应答）&#xa;fml::Fifo 两端" style="rounded=0;whiteSpace=wrap;html=1;fontSize=9;strokeColor=#000000;fillColor=#FFFFFF;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;strokeWidth=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="2135" y="720" width="230" height="70" as="geometry"/></mxCell><mxCell id="l2" value="L2 / 访存出口&#xa;fml::Fifo&lt;Mf&gt;&#xa;缺失行请求与回填" style="rounded=0;whiteSpace=wrap;html=1;fontSize=9;strokeColor=#000000;fillColor=#FFFFFF;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;strokeWidth=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="2135" y="830" width="230" height="70" as="geometry"/></mxCell><mxCell id="l0note" value="本层还有两个 Ifetch 之外的 task（左侧虚线框）：&#xa;  • S2.issue：写 RedirectReq&#xa;  • S1.decode：读 IbView、写 PopReq&#xa;&#xa;它们和 L1i.serve 之间没有共享状态，&#xa;FML 可以把三者放进同一批并行执行。&#xa;&#xa;Ifetch 内部只有 L1i.serve 在这一层：&#xa;它要先算出本拍 4 个 subcore 里&#xa;谁的需求被服务（demand_here），&#xa;Frontend 才能决定 fr 是否被接收。  ①" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;strokeColor=#BBBBBB;fillColor=#FFFFFF;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="265" y="215" width="480" height="300" as="geometry"/></mxCell><mxCell id="fe" value="Frontend        FML module   ×4（每 subcore 一个实例，4 行同一张表）" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;strokeColor=#000000;fillColor=#FFFFFF;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;strokeWidth=1;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="775" y="215" width="670" height="360" as="geometry"/></mxCell><mxCell id="fe_st" value="状态（Frontend 独占）&#xa;warp[12]：fetch_pc 35b   epoch 2b   occupied   miss_pending   miss_wait   starve_count 7b&#xa;单槽：lookup（warp / pc / epoch）   miss_rsp（warp / pc / epoch）   freq_pace（每 4 拍 ≤1 次 fr）&#xa;l0i：tag[64] 32b   valid[64]   data[64] × 1024b = 8 KiB   rr_ptr   填充 stage 1024b + beat 2b" style="rounded=0;whiteSpace=wrap;html=1;fontSize=9;strokeColor=#000000;fillColor=#FFFFFF;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="787" y="243" width="646" height="92" as="geometry"/></mxCell><mxCell id="fe_t" value="#[fml::task(triggers = (clock,))]&#xa;fn cycle(ctx: &amp;mut fml::TaskCtx,&#xa;    st: &amp;mut FeState,  l0i: &amp;mut L0i,&#xa;    redirect:  &amp;&#x27;latest RedirectReq,     // ③ 同拍生效&#xa;    served:    &amp;&#x27;latest [bool; 4],       // ① L1i.serve 本拍结果&#xa;    lifecycle: &amp;LaunchRetire,            // ⑤ &amp; 还是 &amp;&#x27;latest 待核&#xa;    ib:   &amp;IbView,      // count / deadline，上一拍&#xa;    fill: &amp;FillBeat,    // ④ L1i 回送流寄存器&#xa;    push: &amp;mut PushReq, // ≤2 条 + flush&#xa;    fr:   &amp;mut FrReq,   // L0I 缺失 → L1I&#xa;) -&gt; Result&lt;(), fml::SimError&gt;&#xa;// 重定向/生命周期 → lookup 响应是否 live → 推送 IB&#xa;// → eligible 仲裁 12→1 → 发 L0I 查找 → 缺失时发 fr" style="rounded=0;whiteSpace=wrap;html=1;fontSize=9;strokeColor=#0066CC;fillColor=#EAF2FB;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;strokeWidth=2;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="787" y="345" width="646" height="218" as="geometry"/></mxCell><mxCell id="ib" value="Ib        FML module   ×4（每 subcore 一个实例）   ②" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;strokeColor=#0066CC;fillColor=#FFFFFF;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;strokeWidth=1;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1475" y="215" width="620" height="360" as="geometry"/></mxCell><mxCell id="ib_st" value="状态（只有 Ib.step 写）&#xa;mem[2 bank][48][128b] = 12 warp × 8 深   每 warp head / tail / count&#xa;head_instr[12] 队头旁路寄存器   deadline[12] 8b（送 Frontend 仲裁）" style="rounded=0;whiteSpace=wrap;html=1;fontSize=9;strokeColor=#000000;fillColor=#FFFFFF;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1487" y="243" width="596" height="76" as="geometry"/></mxCell><mxCell id="ib_t" value="#[fml::task(triggers = (clock,))]&#xa;fn step(ctx: &amp;mut fml::TaskCtx,&#xa;    ib:   &amp;mut IbState,&#xa;    push: &amp;&#x27;latest PushReq,   // Frontend 本拍写的&#xa;    pop:  &amp;&#x27;latest PopReq,    // S1.decode 本拍写的&#xa;) -&gt; Result&lt;(), fml::SimError&gt;&#xa;// = RTL 的 next-state：flush &gt; 推送/弹出/旁路" style="rounded=0;whiteSpace=wrap;html=1;fontSize=9;strokeColor=#0066CC;fillColor=#EAF2FB;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;strokeWidth=2;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="1487" y="330" width="596" height="130" as="geometry"/></mxCell><mxCell id="ib_view" value="IbView = { count[12], deadline[12], head_instr[12] }&#xa;别人只用 &amp; 读它（Ib.step 写之前的值）：&#xa;  • Frontend 用 count / deadline 算 has_room 和仲裁 key&#xa;  • S1.decode 读 head_instr 取指令&#xa;&amp; 让 Frontend、S1.decode 排在 Ib.step 之前，与 &amp;&#x27;latest 请求方向一致" style="rounded=0;whiteSpace=wrap;html=1;fontSize=9;strokeColor=#000000;fillColor=#FFFFFF;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1487" y="472" width="596" height="90" as="geometry"/></mxCell><mxCell id="l1i" value="L1i        FML module   ×1 per SM（4 subcore 共享）——一个模块、两个 task   ①" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;strokeColor=#CC0000;fillColor=#FFFFFF;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;strokeWidth=1;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="265" y="640" width="1830" height="355" as="geometry"/></mxCell><mxCell id="l1_serve" value="#[fml::task(triggers = (clock,))]&#xa;fn serve(ctx: &amp;mut fml::TaskCtx,&#xa;    regs:   &amp;L1iState,      // 上一拍&#xa;    served: &amp;mut [bool; 4], // demand_here&#xa;) -&gt; Result&lt;(), fml::SimError&gt;&#xa;// tag 口每拍 1 次：&#xa;// 交付 &gt; 需求 &gt; 推送 &gt; 窗口&#xa;// 需求在 subcore 间轮转" style="rounded=0;whiteSpace=wrap;html=1;fontSize=9;strokeColor=#0066CC;fillColor=#EAF2FB;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;strokeWidth=2;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="277" y="670" width="468" height="190" as="geometry"/></mxCell><mxCell id="l1_st" value="状态（只有 L1i.capture 写）&#xa;freq[4]：每 subcore 1 项需求寄存   fr_ready[k] = !freq_valid[k] || served[k]&#xa;tag：4 way × 128 set × 25b，valid[512]，rr_ptr[128]&#xa;data：512 行 × 1024b = 64 KiB（读写各 1 口 / 拍）&#xa;hit_pending[4] / hit_data[4]：命中行按 subcore 暂存&#xa;stream[4]：回送流，每拍 1 beat × 256b，4 拍一行  →  FillBeat&#xa;miss_queue：48 需求项（按 warp）+ 16 预取项&#xa;预取窗口[4]：L+1 … L+8；L0I 下一行推送" style="rounded=0;whiteSpace=wrap;html=1;fontSize=9;strokeColor=#000000;fillColor=#FFFFFF;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="787" y="670" width="646" height="190" as="geometry"/></mxCell><mxCell id="l1_cap" value="#[fml::task(triggers = (clock,))]&#xa;fn capture(ctx: &amp;mut fml::TaskCtx,&#xa;    regs:   &amp;mut L1iState,&#xa;    served: &amp;&#x27;latest [bool; 4],&#xa;    fr:     &amp;&#x27;latest [FrReq; 4], // 4 个 Frontend&#xa;    tlb:    &amp;mut TlbPort,&#xa;    l2:     &amp;mut fml::FifoTx&lt;Mf&gt;,&#xa;) -&gt; Result&lt;(), fml::SimError&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=9;strokeColor=#0066CC;fillColor=#EAF2FB;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;strokeWidth=2;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="1487" y="670" width="596" height="190" as="geometry"/></mxCell><mxCell id="l1_note" value="为什么拆成两个 task：RTL 里 fr_ready 是组合输出（ifetch_l1i.v:322），Frontend 的 fr_valid 又在同一拍被 L1I 锁存进 freq。&#xa;若 L1i 只有一个 task，它既要在 Frontend 之前（给出 served），又要在 Frontend 之后（读 fr）→ FML 加载时报环。&#xa;拆开后：serve（层 0，只读上一拍状态）→ Frontend（层 1）→ capture（层 2，单写者更新全部寄存器）。这正是 RTL 里&quot;组合输出&quot;和&quot;时钟沿更新&quot;两半的对应。&#xa;同理 Ib 两端（Frontend 推送 / flush、S1.decode 弹出）都只写请求，存储由 Ib.step 一个 task 更新 ②。" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;strokeColor=#BBBBBB;fillColor=#FFFFFF;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="277" y="872" width="1806" height="110" as="geometry"/></mxCell><mxCell id="e_s2" value="RedirectReq   &amp;&#x27;latest  ③" style="endArrow=block;endSize=5;html=1;strokeColor=#0066CC;fontSize=9;fontColor=#0066CC;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.2;entryDx=0;entryDy=0;" edge="1" parent="1" source="s2" target="fe_t"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="250" y="261"/><mxPoint x="250" y="395"/></Array></mxGeometry></mxCell><mxCell id="e_cta" value="LaunchRetire   &amp; / &amp;&#x27;latest ?  ⑤" style="endArrow=block;endSize=5;html=1;strokeColor=#888888;fontSize=9;fontColor=#888888;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=0;dashed=1;dashPattern=6 4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="cta" target="fe_t"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_srv" value="served[4]   &amp;&#x27;latest  ①" style="endArrow=block;endSize=5;html=1;strokeColor=#0066CC;fontSize=9;fontColor=#0066CC;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeWidth=2;exitX=1;exitY=0.35;exitDx=0;exitDy=0;entryX=0;entryY=0.45;entryDx=0;entryDy=0;" edge="1" parent="1" source="l1_serve" target="fe_t"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="760" y="740"/><mxPoint x="760" y="440"/></Array></mxGeometry></mxCell><mxCell id="e_push" value="PushReq   &amp;&#x27;latest" style="endArrow=block;endSize=5;html=1;strokeColor=#0066CC;fontSize=9;fontColor=#0066CC;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeWidth=2;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="fe_t" target="ib_t"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_fr" value="FrReq[4]   &amp;&#x27;latest  ①" style="endArrow=block;endSize=5;html=1;strokeColor=#0066CC;fontSize=9;fontColor=#0066CC;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeWidth=2;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.35;entryDx=0;entryDy=0;" edge="1" parent="1" source="fe_t" target="l1_cap"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1455" y="520"/><mxPoint x="1455" y="740"/></Array></mxGeometry></mxCell><mxCell id="e_srv2" value="served[4]   &amp;&#x27;latest（同模块）" style="endArrow=block;endSize=5;html=1;strokeColor=#0066CC;fontSize=9;fontColor=#0066CC;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeWidth=2;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="l1_serve" target="l1_cap"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="511" y="618"/><mxPoint x="1785" y="618"/></Array></mxGeometry></mxCell><mxCell id="e_pop" value="PopReq   &amp;&#x27;latest" style="endArrow=block;endSize=5;html=1;strokeColor=#0066CC;fontSize=9;fontColor=#0066CC;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.85;entryDx=0;entryDy=0;" edge="1" parent="1" source="s1" target="ib_t"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="235" y="370"/><mxPoint x="235" y="592"/><mxPoint x="1470" y="592"/><mxPoint x="1470" y="440"/></Array></mxGeometry></mxCell><mxCell id="e_view" value="IbView   &amp;" style="endArrow=block;endSize=5;html=1;strokeColor=#888888;fontSize=9;fontColor=#888888;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=0;dashed=1;dashPattern=6 4;exitX=0;exitY=0.25;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ib_view" target="fe_t"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_fill" value="FillBeat   &amp;  ④" style="endArrow=block;endSize=5;html=1;strokeColor=#888888;fontSize=9;fontColor=#888888;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=0;dashed=1;dashPattern=6 4;exitX=0.3;exitY=0;exitDx=0;exitDy=0;entryX=0.3;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="l1_st" target="fe_t"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_tlb" value="" style="endArrow=block;endSize=5;html=1;strokeColor=#000000;fontSize=9;fontColor=#000000;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=1;exitY=0.4;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="l1_cap" target="tlb"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_l2" value="" style="endArrow=block;endSize=5;html=1;strokeColor=#000000;fontSize=9;fontColor=#000000;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="l1_cap" target="l2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="lg" value="图例&#xa;&#xa;黑框   FML module（拥有状态）&#xa;蓝底粗框   FML task&#xa;虚线框   Ifetch 之外的 task&#xa;&#xa;蓝粗箭头   &amp;&#x27;latest（定先后）&#xa;灰虚箭头   &amp;（读者在写者之前）&#xa;黑细箭头   fml::Fifo 端口&#xa;&#xa;蓝/红框编号 → 下方说明" style="rounded=0;whiteSpace=wrap;html=1;fontSize=9;strokeColor=#000000;fillColor=#FFFFFF;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="20" y="640" width="205" height="170" as="geometry"/></mxCell><mxCell id="dag" value="一个时钟沿内由访问模式推导出的顺序&#xa;&#xa;  S2.issue ─┐&#xa;  L1i.serve ┴─► Frontend.cycle ×4 ─┬─► Ib.step ×4&#xa;  S1.decode ───────────────────────┘   L1i.capture&#xa;&#xa;同一层内的 task 互不冲突，可由多个 worker 并行；&#xa;没有任何手写的执行顺序。" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;strokeColor=#000000;fillColor=#FFFFFF;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="20" y="1035" width="520" height="120" as="geometry"/></mxCell><mxCell id="co0" value="① fr_ready 跨模块组合环 → L1i 拆成两个 task&#xa;&#xa;fr_ready_o[k] = !freq_valid_q[k] || demand_here（ifetch_l1i.v:322），而 fr_valid 又在同拍被锁存。单个 task 无法同时在 Frontend 前后运行，FML 加载时会报环。拆成 serve（只读上一拍）和 capture（单写者）后，顺序由 &amp;&#x27;latest 自动推出。" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;strokeColor=#CC0000;fillColor=#FFFFFF;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="560" y="1035" width="585" height="118" as="geometry"/></mxCell><mxCell id="co1" value="② IB 两端同拍改同一存储 → 请求 + Ib.step&#xa;&#xa;Frontend 推送 / flush，S1.decode 弹出，count==0 或同拍弹出时还有写旁路（ifetch_ib.v:45-50）。FML 每个状态只能有一个写者：两端只写 PushReq / PopReq，Ib.step 用 &amp;&#x27;latest 读二者，按 flush &gt; 推送 / 弹出 / 旁路更新。" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;strokeColor=#0066CC;fillColor=#FFFFFF;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1160" y="1035" width="585" height="118" as="geometry"/></mxCell><mxCell id="co2" value="③ redirect 必须同拍可见 → &amp;&#x27;latest&#xa;&#xa;lookup_response_live 直接用 redirect_valid_i 作废本拍的 L0I 响应（ifetch_frontend.v:251），epoch 同拍 +1。若写成 &amp;，Frontend 晚一拍看到重定向，被作废的响应会写进 IB，周期级不再与 RTL 一致。" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;strokeColor=#0066CC;fillColor=#FFFFFF;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1760" y="1035" width="585" height="118" as="geometry"/></mxCell><mxCell id="co3" value="④ L1I 回送流来自寄存器 → &amp; 即可（但 &amp; 也定先后）&#xa;&#xa;stream_*_q 是 L1I 的寄存器输出，Frontend 用 &amp; 读。FML 每个位置只有一个版本，&amp; 的含义是「读者排在写者之前」：它建立 Frontend → L1i.capture 的边，与 FrReq 的 &amp;&#x27;latest 方向一致，不成环。IbView 同理。并行来自 4 个 Frontend / 4 个 Ib 之间互不相交的状态，不来自 &amp;。" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;strokeColor=#000000;fillColor=#FFFFFF;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="560" y="1165" width="585" height="118" as="geometry"/></mxCell><mxCell id="co4" value="⑤ launch / retire / exit 的时序待核&#xa;&#xa;它们同样参与 lookup_response_live 和 IB flush。若 sm_top 给出的是寄存器输出，用 &amp;；若是同拍组合（cta_dispatch 当拍决定），要用 &amp;&#x27;latest，把 cta_dispatch 排在 Frontend 之前。需要对照 sm_top.v:1901 一带确认。" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;strokeColor=#CC0000;fillColor=#FFFFFF;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1160" y="1165" width="585" height="118" as="geometry"/></mxCell><mxCell id="co5" value="⑥ FML 目前没有、需要外挂的部分&#xa;&#xa;时序契约（taken 分支到目标发射 ≥10 拍、每 4 拍最多 1 次 fr、L0I 1 拍查找）、握手 / 阶段结构，以及与 RTL 信号名的对应表。FML 只检查同拍读写顺序；这些要像 S1 原型那样由 contract 层读 .fasm 另行检查。" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;strokeColor=#CC0000;fillColor=#FFFFFF;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1760" y="1165" width="585" height="118" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
